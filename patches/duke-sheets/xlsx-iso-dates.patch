+/// Convert the extended ISO date/time forms used by `t="d"` cells to the
+/// worksheet's serial date system. Spreadsheet times have no local timezone;
+/// accept the trailing `Z` emitted by some producers without a timezone shift.
+fn parse_iso_date(value: &str, date_1904: bool) -> Option<f64> {
+    let value = value.strip_suffix('Z').unwrap_or(value);
+    let (date, time) = if let Some((date, time)) = value.split_once('T') {
+        (
+            Some(NaiveDate::parse_from_str(date, "%Y-%m-%d").ok()?),
+            NaiveTime::parse_from_str(time, "%H:%M:%S%.f").ok()?,
+        )
+    } else if value.contains(':') {
+        (None, NaiveTime::parse_from_str(value, "%H:%M:%S%.f").ok()?)
+    } else {
+        (
+            Some(NaiveDate::parse_from_str(value, "%Y-%m-%d").ok()?),
+            NaiveTime::from_hms_opt(0, 0, 0)?,
+        )
+    };
+    // Chrono can represent leap seconds; SpreadsheetML cannot.
+    if time.nanosecond() >= 1_000_000_000 {
+        return None;
+    }
+    let mut serial = 0.0;
+    if let Some(date) = date {
+        if !(1..=9999).contains(&date.year()) {
+            return None;
+        }
+        let epoch = if date_1904 {
+            NaiveDate::from_ymd_opt(1904, 1, 1)?
+        } else {
+            NaiveDate::from_ymd_opt(1899, 12, 31)?
+        };
+        serial = (date - epoch).num_days() as f64;
+        // Excel reserves serial 60 for the nonexistent 1900-02-29.
+        if !date_1904 && date >= NaiveDate::from_ymd_opt(1900, 3, 1)? {
+            serial += 1.0;
+        }
+    }
+    Some(serial + (time.num_seconds_from_midnight() as f64 + time.nanosecond() as f64 / 1e9) / 86400.0)
+}
