+fn formatted_display_value(view: &CellView<'_>, raw: &CellValue) -> String {
+    // A spill target stores no value of its own: format the value resolved
+    // from its source formula with the target cell's number format.
+    if view.value().is_spill_target() {
+        return view.format_value(raw);
+    }
+    view.formatted()
+}
+
+fn numeric_display_value(raw: &CellValue) -> Option<f64> {
+    match raw.effective_value() {
+        CellValue::Number(value) => Some(*value),
+        _ => None,
+    }
+}
+
+fn general_alignment(raw: &CellValue) -> &'static str {
+    match raw.effective_value() {
+        CellValue::Number(_) => "right",
+        CellValue::Boolean(_) | CellValue::Error(_) => "center",
+        _ => "left",
+    }
+}
+
+fn collect_sizing_rows(
+    ws: &CoreWorksheet,
+    matches: impl Fn(u32, u16) -> bool,
+    wrapped_only: bool,
+    merges: Vec<&duke_sheets_core::CellRange>,
+) -> Vec<WasmRow> {
+    // Filter the unsorted cell map and let the set do the only sort.
+    let coords: BTreeSet<_> = ws
+        .cells_map_in_range(0, u32::MAX)
+        .map(|(&(row, col), _)| (row, col))
+        .chain(ws.formula_cells().map(|(row, col, _)| (row, col)))
+        .filter(|&(row, col)| matches(row, col))
+        .collect();
+    let mut rows = std::collections::BTreeMap::<u32, Vec<WasmRowCell>>::new();
+
+    for (row, col) in coords {
+        let view = ws.cell_view_at(row, col);
+        let raw = ws.get_value_at_ref(row, col);
+        let value = formatted_display_value(&view, raw);
+        let numeric_value = numeric_display_value(raw);
+        // Keep numeric operands available for conditional styles even when their
+        // number format hides the value. Empty text does not affect measurement.
+        if value.is_empty() && (wrapped_only || numeric_value.is_none()) {
+            continue;
+        }
+        if wrapped_only
+            && !value.contains(['\r', '\n'])
+            && !view.style().is_some_and(|style| style.alignment.wrap_text)
+        {
+            continue;
+        }
+
+        let address = duke_sheets_core::CellAddress::new(row, col);
+        let merge = merges.iter().find(|range| range.contains(&address));
+        if merge.is_some_and(|range| range.start != address) {
+            continue;
+        }
+        rows.entry(row).or_default().push(WasmRowCell {
+            col: u32::from(col),
+            value,
+            numeric_value,
+            general_alignment: (!wrapped_only).then(|| general_alignment(raw)),
+            rich_text: match raw.effective_value() {
+                CellValue::RichText(runs) if !wrapped_only => {
+                    Some(runs.iter().map(crate::types::WasmRichTextRun::from).collect())
+                }
+                _ => None,
+            },
+            style: view.style().map(WasmStyle::from),
+            merge_span: merge.map(|range| WasmMergeSpan {
+                row_span: range.end.row - row + 1,
+                col_span: u32::from(range.end.col - col) + 1,
+            }),
+            is_merged_secondary: None,
+            hyperlink: if wrapped_only { None } else { ws.hyperlink_at(row, col).map(WasmHyperlink::from) },
+            comment: None,
+            formula: if wrapped_only { None } else { ws.get_formula_at(row, col).map(str::to_string) },
+            image: None,
+        });
+    }
+
+    rows.into_iter().map(|(index, cells)| WasmRow { index, cells }).collect()
+}
