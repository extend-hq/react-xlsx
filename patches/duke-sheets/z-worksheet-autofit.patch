+    #[wasm_bindgen(skip_typescript, js_name = getAutofitCells)]
+    pub fn get_autofit_cells(&self, axis: &str, index: u32) -> Result<JsValue, JsError> {
+        let wb = self.workbook.borrow();
+        let ws = wb
+            .worksheet(self.sheet_index)
+            .ok_or_else(|| JsError::new("Worksheet no longer exists"))?;
+        let column = match axis {
+            "column" => true,
+            "row" => false,
+            _ => return Err(JsError::new("Invalid autofit axis")),
+        };
+        let on_axis = |row, col| if column { u32::from(col) == index } else { row == index };
+        let merges = ws.merged_regions().iter().filter(|range| {
+            if column {
+                (u32::from(range.start.col)..=u32::from(range.end.col)).contains(&index)
+            } else {
+                (range.start.row..=range.end.row).contains(&index)
+            }
+        }).collect::<Vec<_>>();
+        to_js_value(&collect_sizing_rows(ws, on_axis, false, merges))
+    }
+
+    #[wasm_bindgen(skip_typescript, js_name = getAutoHeightCells)]
+    pub fn get_auto_height_cells(&self, row_count: u32, col_count: u32) -> Result<JsValue, JsError> {
+        let wb = self.workbook.borrow();
+        let ws = wb
+            .worksheet(self.sheet_index)
+            .ok_or_else(|| JsError::new("Worksheet no longer exists"))?;
+        let fits_auto_height_range = |row, col| {
+            row < row_count
+                && u32::from(col) < col_count
+                && !ws.custom_row_heights().contains_key(&row)
+                && !ws.is_row_hidden(row)
+                && !ws.is_column_hidden(col)
+        };
+        let merges = ws.merged_regions().iter()
+            .filter(|range| range.start.row < row_count && u32::from(range.start.col) < col_count)
+            .collect::<Vec<_>>();
+        to_js_value(&collect_sizing_rows(ws, fits_auto_height_range, true, merges))
     }

