diff --git a/bindings/wasm/src/viewer.rs b/bindings/wasm/src/viewer.rs
new file mode 100644
index 0000000..f5f95ff
--- /dev/null
+++ b/bindings/wasm/src/viewer.rs
@@ -0,0 +1,241 @@
+use crate::{to_js_error, Workbook};
+use quick_xml::{events::Event, Reader};
+use serde::Serialize;
+use std::cell::RefCell;
+use std::io::{Cursor, Read};
+use std::rc::Rc;
+use wasm_bindgen::prelude::*;
+
+#[derive(Serialize)]
+#[serde(untagged)]
+enum XmlChild {
+    Element(XmlElement),
+    Text(String),
+}
+#[derive(Serialize)]
+struct XmlElement(String, Vec<(String, String)>, Vec<XmlChild>);
+
+#[wasm_bindgen(js_name = parseXmlTree)]
+pub fn parse_xml_tree(xml: &str) -> Result<String, JsError> {
+    let normalized;
+    let xml = if xml.contains('\r') {
+        normalized = xml.replace("\r\n", "\n").replace('\r', "\n");
+        normalized.as_str()
+    } else {
+        xml
+    };
+    let mut reader = Reader::from_str(xml);
+    reader.config_mut().trim_text(false);
+    let mut stack = vec![XmlElement(String::new(), Vec::new(), Vec::new())];
+    loop {
+        match reader.read_event().map_err(to_js_error)? {
+            event @ (Event::Start(_) | Event::Empty(_)) => {
+                let empty = matches!(event, Event::Empty(_));
+                let e = match event {
+                    Event::Start(e) | Event::Empty(e) => e,
+                    _ => unreachable!(),
+                };
+                let name = reader
+                    .decoder()
+                    .decode(e.name().as_ref())
+                    .map_err(to_js_error)?
+                    .into_owned();
+                let attrs = e
+                    .attributes()
+                    .map(|a| {
+                        let a = a.map_err(to_js_error)?;
+                        Ok((
+                            reader
+                                .decoder()
+                                .decode(a.key.as_ref())
+                                .map_err(to_js_error)?
+                                .into_owned(),
+                            quick_xml::escape::unescape(
+                                &reader
+                                    .decoder()
+                                    .decode(a.value.as_ref())
+                                    .map_err(to_js_error)?
+                                    .replace(['\t', '\n'], " "),
+                            )
+                            .map_err(to_js_error)?
+                            .into_owned(),
+                        ))
+                    })
+                    .collect::<Result<Vec<_>, JsError>>()?;
+                let node = XmlElement(name, attrs, Vec::new());
+                if empty {
+                    stack.last_mut().unwrap().2.push(XmlChild::Element(node));
+                } else {
+                    if stack.len() >= 512 {
+                        return Err(JsError::new("XML nesting limit exceeded"));
+                    }
+                    stack.push(node);
+                }
+            }
+            Event::End(_) => {
+                if stack.len() <= 1 {
+                    return Err(JsError::new("Unexpected XML closing element"));
+                }
+                let node = stack.pop().unwrap();
+                stack.last_mut().unwrap().2.push(XmlChild::Element(node));
+            }
+            Event::Text(e) => {
+                let text = e.unescape().map_err(to_js_error)?.into_owned();
+                if stack.len() > 1 {
+                    stack.last_mut().unwrap().2.push(XmlChild::Text(text));
+                } else if !text.trim().is_empty() {
+                    return Err(JsError::new("Text outside XML root"));
+                }
+            }
+            Event::CData(e) => stack.last_mut().unwrap().2.push(XmlChild::Text(
+                reader
+                    .decoder()
+                    .decode(e.as_ref())
+                    .map_err(to_js_error)?
+                    .into_owned(),
+            )),
+            Event::DocType(_) => return Err(JsError::new("XML document types are not supported")),
+            Event::Eof => break,
+            _ => {}
+        }
+    }
+    if stack.len() != 1 {
+        return Err(JsError::new("Unclosed XML element"));
+    }
+    let root = stack.pop().unwrap();
+    if root.2.len() != 1 {
+        return Err(JsError::new("XML must contain one root element"));
+    }
+    serde_json::to_string(&root).map_err(to_js_error)
+}
+
+#[wasm_bindgen(js_name = decodeArchive)]
+pub fn decode_archive(data: &[u8]) -> Result<JsValue, JsError> {
+    let mut zip = zip::ZipArchive::new(Cursor::new(data)).map_err(to_js_error)?;
+    let object = js_sys::Object::new();
+    for i in 0..zip.len() {
+        let mut file = zip.by_index(i).map_err(to_js_error)?;
+        if file.is_dir() {
+            continue;
+        }
+        let name = file.name().replace('\\', "/");
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes).map_err(to_js_error)?;
+        js_sys::Reflect::set(
+            &object,
+            &JsValue::from_str(name.trim_start_matches('/')),
+            &js_sys::Uint8Array::from(bytes.as_slice()),
+        )
+        .map_err(|_| JsError::new("Unable to expose archive entry"))?;
+    }
+    Ok(object.into())
+}
+
+#[wasm_bindgen]
+impl Workbook {
+    #[wasm_bindgen(js_name = fromBytesForViewer)]
+    pub fn from_bytes_for_viewer(data: &[u8]) -> Result<Workbook, JsError> {
+        use duke_sheets::WorkbookExt;
+        let (workbook, archive) = duke_sheets_xlsx::viewer::capture_archive(|| {
+            duke_sheets_core::Workbook::from_bytes(data)
+        });
+        Ok(Workbook {
+            inner: Rc::new(RefCell::new(workbook.map_err(to_js_error)?)),
+            viewer_archive: archive,
+        })
+    }
+    #[wasm_bindgen(js_name = takeViewerArchive)]
+    pub fn take_viewer_archive(&mut self) -> Result<JsValue, JsError> {
+        let object = js_sys::Object::new();
+        for (name, bytes) in self.viewer_archive.take().unwrap_or_default() {
+            js_sys::Reflect::set(
+                &object,
+                &JsValue::from_str(&name),
+                &js_sys::Uint8Array::from(bytes.as_ref()),
+            )
+            .map_err(|_| JsError::new("Unable to expose archive entry"))?;
+        }
+        Ok(object.into())
+    }
+}
+
+#[wasm_bindgen(js_name = inspectArchive)]
+pub fn inspect_archive(data: &[u8]) -> Result<JsValue, JsError> {
+    #[derive(Serialize, Default)]
+    #[serde(rename_all = "camelCase")]
+    struct Sizes {
+        largest_worksheet_xml_bytes: u64,
+        total_worksheet_xml_bytes: u64,
+        shared_strings_bytes: u64,
+        too_large: bool,
+    }
+    let mut sizes = Sizes::default();
+    if !data.starts_with(b"PK") {
+        return crate::to_js_value(&sizes);
+    }
+    let mut zip = zip::ZipArchive::new(Cursor::new(data)).map_err(to_js_error)?;
+    for i in 0..zip.len() {
+        let file = zip.by_index(i).map_err(to_js_error)?;
+        let name = file.name().replace('\\', "/").to_ascii_lowercase();
+        if name.starts_with("xl/worksheets/") && name.ends_with(".xml") {
+            sizes.largest_worksheet_xml_bytes = sizes.largest_worksheet_xml_bytes.max(file.size());
+            sizes.total_worksheet_xml_bytes += file.size();
+        } else if name == "xl/sharedstrings.xml" {
+            sizes.shared_strings_bytes = file.size();
+        }
+    }
+    sizes.too_large = sizes.largest_worksheet_xml_bytes > 200 * 1024 * 1024
+        || sizes.shared_strings_bytes > 50 * 1024 * 1024
+        || sizes.total_worksheet_xml_bytes + sizes.shared_strings_bytes > 256 * 1024 * 1024;
+    crate::to_js_value(&sizes)
+}
+
+#[wasm_bindgen]
+impl Workbook {
+    #[wasm_bindgen(js_name = fontFamilies)]
+    pub fn font_families(&self) -> Vec<String> {
+        let mut names =
+            std::collections::BTreeSet::from(["Calibri".to_string(), "Arial".to_string()]);
+        let Some(archive) = &self.viewer_archive else {
+            return names.into_iter().collect();
+        };
+        for (path, bytes) in archive {
+            if !(path == "xl/styles.xml"
+                || path == "xl/sharedStrings.xml"
+                || path.starts_with("xl/theme/")
+                || path.starts_with("xl/charts/")
+                || path.starts_with("xl/drawings/"))
+                || !path.ends_with(".xml")
+            {
+                continue;
+            }
+            let mut reader = Reader::from_reader(bytes.as_ref());
+            let mut buffer = Vec::new();
+            loop {
+                match reader.read_event_into(&mut buffer) {
+                    Ok(Event::Start(e) | Event::Empty(e))
+                        if matches!(
+                            e.local_name().as_ref(),
+                            b"name" | b"rFont" | b"latin" | b"ea" | b"cs"
+                        ) =>
+                    {
+                        for attr in e.attributes().flatten() {
+                            if matches!(attr.key.as_ref(), b"val" | b"typeface") {
+                                if let Ok(value) = attr.decode_and_unescape_value(reader.decoder())
+                                {
+                                    if !value.is_empty() && !value.starts_with('+') {
+                                        names.insert(value.into_owned());
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    Ok(Event::Eof) | Err(_) => break,
+                    _ => {}
+                }
+                buffer.clear();
+            }
+        }
+        names.into_iter().collect()
+    }
+}
