new file mode 100644
index 0000000..b5d2fd0
--- /dev/null
+++ b/crates/duke-sheets-xlsx/src/viewer.rs
@@ -0,0 +1,35 @@
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::sync::Arc;
+
+pub type ViewerArchive = HashMap<String, Arc<[u8]>>;
+thread_local! {
+    static CAPTURE: RefCell<Option<ViewerArchive>> = const { RefCell::new(None) };
+}
+
+pub fn capture_archive<T>(read: impl FnOnce() -> T) -> (T, Option<ViewerArchive>) {
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            CAPTURE.with(|c| *c.borrow_mut() = None);
+        }
+    }
+    CAPTURE.with(|c| *c.borrow_mut() = Some(HashMap::new()));
+    let _reset = Reset;
+    let result = read();
+    let archive = CAPTURE.with(|c| c.borrow_mut().take());
+    (result, archive)
+}
+
+pub(crate) fn is_capturing() -> bool {
+    CAPTURE.with(|c| c.borrow().is_some())
+}
+pub(crate) fn record(name: &str, bytes: Arc<[u8]>) {
+    CAPTURE.with(|c| {
+        if let Some(parts) = &mut *c.borrow_mut() {
+            parts
+                .entry(name.replace('\\', "/").trim_start_matches('/').to_string())
+                .or_insert(bytes);
+        }
+    });
+}
