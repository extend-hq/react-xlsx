+pub fn resolve_pivot_source(
+    workbook: &Workbook,
+    source: &PivotSource,
+) -> Result<(usize, CellRange)> {
+    if let Some(name) = source.table.as_ref().filter(|s| !s.is_empty()) {
+        for (index, sheet) in workbook.worksheets().enumerate() {
+            if let Some(table) = sheet.tables().iter().find(|t| {
+                t.name.eq_ignore_ascii_case(name) || t.display_name.eq_ignore_ascii_case(name)
+            }) {
+                if table.header_row_count != 1 {
+                    return Err(fail("Pivot source tables require a header row"));
+                }
+                let mut range = table.reference;
+                range.end.row = range.end.row.saturating_sub(table.totals_row_count);
+                return Ok((index, range));
+            }
+        }
+        return resolve_named_source(workbook, name, source.sheet.as_str(), 0);
+    }
+    Ok((
+        sheet_index(workbook, &source.sheet)?,
+        match CellRange::parse(&source.range) {
+            Ok(range) => range,
+            Err(_) => return resolve_named_source(workbook, &source.range, &source.sheet, 0),
+        },
+    ))
+}
