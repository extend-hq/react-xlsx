+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+struct Node {
+    name: String,
+    attrs: BTreeMap<String, String>,
+    children: Vec<Node>,
+    text: String,
+}
+
+impl Node {
+    fn new(name: &str) -> Self {
+        Self {
+            name: name.into(),
+            ..Self::default()
+        }
+    }
+    fn local(&self) -> &str {
+        self.name.rsplit(':').next().unwrap_or(&self.name)
+    }
+    fn attr(&self, key: &str) -> &str {
+        self.attrs.get(key).map(String::as_str).unwrap_or("")
+    }
+    fn num(&self, key: &str) -> usize {
+        self.attr(key).parse().unwrap_or(0)
+    }
+    fn bool(&self, key: &str, default: bool) -> bool {
+        match self.attr(key) {
+            "0" | "false" => false,
+            "1" | "true" => true,
+            _ => default,
+        }
+    }
+    fn child(&self, name: &str) -> Option<&Node> {
+        self.children.iter().find(|c| c.local() == name)
+    }
+    fn all<'a>(&'a self, name: &'a str) -> impl Iterator<Item = &'a Node> + 'a {
+        self.children.iter().filter(move |c| c.local() == name)
+    }
+    fn set(mut self, key: &str, value: impl ToString) -> Self {
+        self.attrs.insert(key.into(), value.to_string());
+        self
+    }
+    fn push(&mut self, node: Node) {
+        self.children.push(node);
+    }
+    fn remove(&mut self, local: &str) {
+        self.children.retain(|c| c.local() != local);
+    }
+    fn replace(&mut self, node: Node) {
+        self.remove(node.local());
+        self.push(node);
+    }
+    fn bytes(&self) -> XlsxResult<Vec<u8>> {
+        fn emit(node: &Node, writer: &mut Writer<Vec<u8>>) -> XlsxResult<()> {
+            let mut tag = BytesStart::new(&node.name);
+            for (key, value) in &node.attrs {
+                tag.push_attribute((key.as_str(), value.as_str()));
+            }
+            if node.children.is_empty() && node.text.is_empty() {
+                writer.write_event(Event::Empty(tag))?;
+            } else {
+                writer.write_event(Event::Start(tag))?;
+                if !node.text.is_empty() {
+                    writer.write_event(Event::Text(BytesText::new(&node.text)))?;
+                }
+                for child in &node.children {
+                    emit(child, writer)?;
+                }
+                writer.write_event(Event::End(BytesEnd::new(&node.name)))?;
+            }
+            Ok(())
+        }
+        let mut writer =
+            Writer::new(b"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>".to_vec());
+        emit(self, &mut writer)?;
+        Ok(writer.into_inner())
+    }
+}
+
+fn parse(bytes: &[u8]) -> XlsxResult<Node> {
+    let mut reader = Reader::from_reader(bytes);
+    let mut stack: Vec<Node> = Vec::new();
+    let mut root = None;
+    loop {
+        let event = reader.read_event()?;
+        let empty = matches!(event, Event::Empty(_));
+        match event {
+            Event::Start(e) | Event::Empty(e) => {
+                let mut node = Node::new(&String::from_utf8_lossy(e.name().as_ref()));
+                for attr in e.attributes().flatten() {
+                    node.attrs.insert(
+                        String::from_utf8_lossy(attr.key.as_ref()).into_owned(),
+                        attr.unescape_value()?.into_owned(),
+                    );
+                }
+                if empty {
+                    if let Some(parent) = stack.last_mut() {
+                        parent.push(node);
+                    } else {
+                        root = Some(node);
+                    }
+                } else {
+                    if stack.len() >= 128 {
+                        return Err(XlsxError::InvalidFormat(
+                            "Pivot XML nesting limit exceeded".into(),
+                        ));
+                    }
+                    stack.push(node);
+                }
+            }
+            Event::End(_) => {
+                let node = stack
+                    .pop()
+                    .ok_or_else(|| XlsxError::InvalidFormat("Unbalanced pivot XML".into()))?;
+                if let Some(parent) = stack.last_mut() {
+                    parent.push(node);
+                } else {
+                    root = Some(node);
+                }
+            }
+            Event::Text(e) => {
+                if let Some(node) = stack.last_mut() {
+                    node.text.push_str(&e.unescape()?);
+                }
+            }
+            Event::CData(e) => {
+                if let Some(node) = stack.last_mut() {
+                    node.text.push_str(&String::from_utf8_lossy(&e));
+                }
+            }
+            Event::DocType(_) => {
+                return Err(XlsxError::InvalidFormat(
+                    "DTD is not allowed in pivot XML".into(),
+                ))
+            }
+            Event::Eof => break,
+            _ => {}
+        }
+    }
+    if !stack.is_empty() {
+        return Err(XlsxError::InvalidFormat("Incomplete pivot XML".into()));
+    }
+    root.ok_or_else(|| XlsxError::InvalidFormat("Empty pivot XML".into()))
+}
