diff --git a/bindings/wasm/src/pivot_charts.rs b/bindings/wasm/src/pivot_charts.rs
new file mode 100644
index 0000000..784df8c
--- /dev/null
+++ b/bindings/wasm/src/pivot_charts.rs
@@ -0,0 +1,72 @@
+use crate::{to_js_value, Workbook};
+use duke_sheets_core::pivot_chart::{create_pivot_chart, PivotChartOptions};
+use wasm_bindgen::prelude::*;
+
+#[wasm_bindgen]
+impl Workbook {
+    #[wasm_bindgen(js_name = modifiedPivotCharts)]
+    pub fn modified_pivot_charts(&self) -> Result<JsValue, JsError> {
+        let workbook = self.inner.borrow();
+        let mut modified = Vec::new();
+        for sheet in workbook.worksheets() {
+            for chart in sheet.charts().filter(|chart| chart.payload.pivot_modified) {
+                if let Some(name) = &chart.meta.name {
+                    modified.push(serde_json::json!({ "sheet": sheet.name(), "name": name, "sourceName": chart.payload.pivot_source.as_ref().map(|source| &source.name), "formatId": chart.payload.pivot_source.as_ref().map(|source| source.format_id) }));
+                }
+            }
+        }
+        for sheet in workbook
+            .chartsheets()
+            .iter()
+            .filter(|sheet| sheet.chart.pivot_modified)
+        {
+            modified.push(serde_json::json!({ "sheet": sheet.name, "name": "", "sourceName": sheet.chart.pivot_source.as_ref().map(|source| &source.name), "formatId": sheet.chart.pivot_source.as_ref().map(|source| source.format_id) }));
+        }
+        to_js_value(&modified)
+    }
+
+    #[wasm_bindgen(js_name = createPivotChart)]
+    pub fn create_pivot_chart(&self, id: &str, options: JsValue) -> Result<JsValue, JsError> {
+        let options: PivotChartOptions = serde_wasm_bindgen::from_value(options)
+            .map_err(|error| JsError::new(&error.to_string()))?;
+        let binding = create_pivot_chart(&mut self.inner.borrow_mut(), id, options)
+            .map_err(|error| JsError::new(&error.to_string()))?;
+        to_js_value(&binding)
+    }
+}
+
+#[derive(serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct PivotChartPatch {
+    title: Option<String>,
+    chart_type: Option<String>,
+    anchor: Option<crate::drawings::WasmDrawingAnchor>,
+}
+
+#[wasm_bindgen]
+impl Workbook {
+    #[wasm_bindgen(js_name = updatePivotChart)]
+    pub fn update_pivot_chart(
+        &self,
+        sheet: &str,
+        name: &str,
+        patch: JsValue,
+    ) -> Result<(), JsError> {
+        let patch: PivotChartPatch = serde_wasm_bindgen::from_value(patch)
+            .map_err(|error| JsError::new(&error.to_string()))?;
+        let anchor = patch
+            .anchor
+            .map(TryInto::try_into)
+            .transpose()
+            .map_err(|error: String| JsError::new(&error))?;
+        duke_sheets_core::pivot_chart::update_pivot_chart(
+            &mut self.inner.borrow_mut(),
+            sheet,
+            name,
+            patch.title,
+            patch.chart_type,
+            anchor,
+        )
+        .map_err(|error| JsError::new(&error.to_string()))
+    }
+}
diff --git a/bindings/wasm/src/pivots.rs b/bindings/wasm/src/pivots.rs
new file mode 100644
index 0000000..2500984
--- /dev/null
+++ b/bindings/wasm/src/pivots.rs
@@ -0,0 +1,123 @@
+use crate::{to_js_value, Workbook};
+use duke_sheets_core::pivot::{self, PivotSource, PivotTable, PivotValue};
+use wasm_bindgen::prelude::*;
+
+fn metadata(pivot: &PivotTable) -> serde_json::Value {
+    serde_json::json!({
+        "id":pivot.id,"name":pivot.name,"source":pivot.source,"target":pivot.target,
+        "rows":pivot.rows,"columns":pivot.columns,"filters":pivot.filters,"reportFilters":pivot.report_filters,
+        "values":pivot.values,"layout":pivot.layout,"repeatLabels":pivot.repeat_labels,"valuesOnRows":pivot.values_on_rows,"preserveFormatting":pivot.preserve_formatting,
+        "rowGrandTotals":pivot.row_grand_totals,"columnGrandTotals":pivot.column_grand_totals,
+        "subtotalsPosition":pivot.subtotals_position,"styleName":pivot.style_name,"fields":pivot.fields,
+        "outputRange":pivot.output_range,"unsupportedFeatures":pivot.unsupported_features,
+        "refreshOnLoad":pivot.refresh_on_load,"calculatedItems":pivot.calculated_items,"charts":pivot.charts,"headers":pivot.headers,"toggles":toggles(pivot)
+    })
+}
+fn toggles(pivot: &PivotTable) -> Vec<serde_json::Value> {
+    let mut result = Vec::new();
+    let mut seen = std::collections::BTreeSet::new();
+    for cell in &pivot.output {
+        if cell.measure.is_some() || cell.kind == "valueLabel" {
+            continue;
+        }
+        if !cell.row_keys.is_empty()
+            && (cell.row_keys.len() < pivot.rows.len()
+                || (pivot.values_on_rows && cell.row_keys.len() == pivot.rows.len()))
+            && seen.insert((true, cell.row_keys.clone()))
+        {
+            let depth = cell.row_keys.len() - 1;
+            let field = &pivot.rows[depth];
+            let key = &cell.row_keys[depth];
+            result.push(serde_json::json!({"row":cell.row,"col":cell.col,"axis":"rows","depth":depth,"field":field.field,"key":key,"collapsed":field.collapsed.contains(key),"caption":PivotValue::from_key(key).caption()}));
+        }
+        if cell.kind == "header" && !cell.column_keys.is_empty() {
+            if let Ok(origin) = duke_sheets_core::CellAddress::parse(&pivot.target.cell) {
+                let offset = if pivot.report_filters.is_empty() {
+                    0
+                } else {
+                    pivot.report_filters.len() + 1
+                };
+                if let Some(depth) = cell
+                    .row
+                    .checked_sub(origin.row + offset as u32)
+                    .map(|v| v as usize)
+                {
+                    if depth + 1 < pivot.columns.len() && depth < cell.column_keys.len() {
+                        let prefix = cell.column_keys[..=depth].to_vec();
+                        if seen.insert((false, prefix)) {
+                            let field = &pivot.columns[depth];
+                            let key = &cell.column_keys[depth];
+                            result.push(serde_json::json!({"row":cell.row,"col":cell.col,"axis":"columns","depth":depth,"field":field.field,"key":key,"collapsed":field.collapsed.contains(key),"caption":PivotValue::from_key(key).caption()}));
+                        }
+                    }
+                }
+            }
+        }
+    }
+    result
+}
+fn scalar(value: &PivotValue) -> serde_json::Value {
+    match value {
+        PivotValue::Blank => serde_json::Value::Null,
+        PivotValue::Number(number) => serde_json::json!(number),
+        PivotValue::Boolean(value) => serde_json::json!(value),
+        PivotValue::Text(value) | PivotValue::Error(value) => serde_json::json!(value),
+    }
+}
+#[wasm_bindgen]
+impl Workbook {
+    #[wasm_bindgen(getter, js_name = pivotTables)]
+    pub fn pivot_tables(&self) -> Result<JsValue, JsError> {
+        to_js_value(
+            &self
+                .inner
+                .borrow()
+                .pivot_tables()
+                .iter()
+                .map(metadata)
+                .collect::<Vec<_>>(),
+        )
+    }
+    #[wasm_bindgen(js_name = getPivotSourceFields)]
+    pub fn get_pivot_source_fields(&self, source: JsValue) -> Result<JsValue, JsError> {
+        let source: PivotSource =
+            serde_wasm_bindgen::from_value(source).map_err(|e| JsError::new(&e.to_string()))?;
+        let (fields, _) = pivot::read_pivot_source(&self.inner.borrow(), &source)
+            .map_err(|e| JsError::new(&e.to_string()))?;
+        to_js_value(&fields)
+    }
+    #[wasm_bindgen(js_name = upsertPivotTable)]
+    pub fn upsert_pivot_table(&self, input: JsValue) -> Result<JsValue, JsError> {
+        let mut pivot: PivotTable =
+            serde_wasm_bindgen::from_value(input).map_err(|e| JsError::new(&e.to_string()))?;
+        pivot.cache.clear();
+        pivot.output.clear();
+        pivot.headers.clear();
+        pivot.preserved_parts.clear();
+        pivot.dirty = false;
+        pivot.output_range = None;
+        let result = pivot::upsert_pivot_table(&mut self.inner.borrow_mut(), pivot)
+            .map_err(|e| JsError::new(&e.to_string()))?;
+        to_js_value(&metadata(&result))
+    }
+    #[wasm_bindgen(js_name = refreshPivotTable)]
+    pub fn refresh_pivot_table(&self, id: &str) -> Result<JsValue, JsError> {
+        let result = pivot::refresh_pivot_table(&mut self.inner.borrow_mut(), id)
+            .map_err(|e| JsError::new(&e.to_string()))?;
+        to_js_value(&metadata(&result))
+    }
+    #[wasm_bindgen(js_name = removePivotTable)]
+    pub fn remove_pivot_table(&self, id: &str) -> Result<bool, JsError> {
+        pivot::remove_pivot_table(&mut self.inner.borrow_mut(), id)
+            .map(|_| true)
+            .map_err(|e| JsError::new(&e.to_string()))
+    }
+    #[wasm_bindgen(js_name = pivotDrillDown)]
+    pub fn pivot_drill_down(&self, id: &str, row: u32, col: u16) -> Result<JsValue, JsError> {
+        let result = pivot::pivot_drill_down(&self.inner.borrow(), id, row, col)
+            .map_err(|e| JsError::new(&e.to_string()))?;
+        to_js_value(
+            &serde_json::json!({ "fields": result.fields, "rows": result.rows.iter().map(|row|row.iter().map(scalar).collect::<Vec<_>>()).collect::<Vec<_>>() }),
+        )
+    }
+}
