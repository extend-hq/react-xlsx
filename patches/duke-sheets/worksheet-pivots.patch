+fn pivot_controls_extension(root: &Node) -> Option<Node> {
+    fn contains_control(node: &Node) -> bool {
+        let name = node.local().to_ascii_lowercase();
+        name.contains("slicer")
+            || name.contains("timeline")
+            || node.children.iter().any(contains_control)
+    }
+    let mut ext = root.child("extLst")?.clone();
+    ext.children.retain(contains_control);
+    if ext.children.is_empty() {
+        return None;
+    }
+    for (key, value) in &root.attrs {
+        if key.starts_with("xmlns:") {
+            ext.attrs.insert(key.clone(), value.clone());
+        }
+    }
+    Some(ext)
+}
