+pub fn rebuild_pivot_output(pivot: &mut PivotTable, date1904: bool) -> Result<()> {
+    if pivot.cache.is_empty() && pivot.output.is_empty() {
+        return Err(fail("Pivot cache records are unavailable; refresh from the source before calculating pivot data"));
+    }
+    normalize(pivot)?;
+    render(pivot, date1904)
+}
+
+fn populate_axis_items(pivot: &mut PivotTable, date1904: bool) {
+    for axis in pivot.rows.iter_mut().chain(&mut pivot.columns) {
+        let mut seen = BTreeSet::new();
+        let mut items = Vec::new();
+        for record in &pivot.cache {
+            let value = grouped(
+                &canonical_member(&pivot.member_aliases, axis.field, &record[axis.field]),
+                axis,
+                date1904,
+            );
+            if seen.insert(value.key()) {
+                items.push(PivotMember {
+                    key: value.key(),
+                    caption: value.caption(),
+                });
+            }
+        }
+        axis.items = items;
+    }
+}
+fn expand_empty_combinations(
+    pivot: &PivotTable,
+    keys: &mut Vec<Vec<String>>,
+    axis: &[PivotAxisField],
+    date1904: bool,
+) -> Result<()> {
+    if !axis.iter().any(|field| field.show_items_with_no_data) {
+        return Ok(());
+    }
+    let mut combinations = vec![Vec::<String>::new()];
+    for (index, field) in axis.iter().enumerate() {
+        let mut members = Vec::new();
+        if field.show_items_with_no_data {
+            let active_filter = pivot
+                .filters
+                .iter()
+                .any(|filter| filter.field == field.field && filter.kind != "members");
+            let mut allowed = BTreeSet::new();
+            if active_filter {
+                for record in filtered_records(pivot, date1904)? {
+                    allowed.insert(
+                        grouped(
+                            &canonical_member(
+                                &pivot.member_aliases,
+                                field.field,
+                                &record[field.field],
+                            ),
+                            field,
+                            date1904,
+                        )
+                        .key(),
+                    );
+                }
+            }
+            for record in &pivot.cache {
+                let value = grouped(
+                    &canonical_member(&pivot.member_aliases, field.field, &record[field.field]),
+                    field,
+                    date1904,
+                )
+                .key();
+                if !members.contains(&value)
+                    && (!active_filter || allowed.contains(&value))
+                    && pivot
+                        .filters
+                        .iter()
+                        .filter(|filter| filter.field == field.field && filter.kind == "members")
+                        .all(|filter| filter.values.contains(&value))
+                {
+                    members.push(value);
+                }
+            }
+        } else {
+            for key in keys.iter() {
+                if !members.contains(&key[index]) {
+                    members.push(key[index].clone());
+                }
+            }
+        }
+        if combinations.len().saturating_mul(members.len()) > MAX_GROUPS {
+            return Err(fail(
+                "Showing empty pivot items would produce too many groups",
+            ));
+        }
+        combinations = combinations
+            .into_iter()
+            .flat_map(|prefix| {
+                members.iter().map(move |member| {
+                    let mut next = prefix.clone();
+                    next.push(member.clone());
+                    next
+                })
+            })
+            .collect();
+    }
+    *keys = combinations;
+    Ok(())
+}
+
+fn pivot_cell_style(name: &str, kind: &str, row: u32) -> Style {
+    let mut style = Style::default();
+    if name.is_empty() || name == "None" {
+        style.font.bold = matches!(kind, "header" | "subtotal" | "grand");
+        return style;
+    }
+    let palettes = [
+        (68u8, 114u8, 196u8),
+        (112, 173, 71),
+        (237, 125, 49),
+        (165, 165, 165),
+        (255, 192, 0),
+        (91, 155, 213),
+    ];
+    let number = name
+        .trim_start_matches(|c: char| !c.is_ascii_digit())
+        .parse::<usize>()
+        .unwrap_or(16);
+    let (r, g, b) = palettes[number.saturating_sub(1) % palettes.len()];
+    let tint = |amount: u16| {
+        Color::rgb(
+            (u16::from(r) + (255 - u16::from(r)) * amount / 100) as u8,
+            (u16::from(g) + (255 - u16::from(g)) * amount / 100) as u8,
+            (u16::from(b) + (255 - u16::from(b)) * amount / 100) as u8,
+        )
+    };
+    let header = kind == "header";
+    let total = kind == "subtotal" || kind == "grand";
+    style.font.bold = header || total;
+    if name.contains("Dark") {
+        if header || total {
+            style.fill = crate::FillStyle::Solid {
+                color: Color::rgb(r, g, b),
+            };
+            style.font.color = Color::rgb(255, 255, 255);
+        } else {
+            style.fill = crate::FillStyle::Solid {
+                color: tint(if row % 2 == 0 { 82 } else { 92 }),
+            };
+        }
+    } else if name.contains("Medium") {
+        if header {
+            style.fill = crate::FillStyle::Solid {
+                color: Color::rgb(r, g, b),
+            };
+            style.font.color = Color::rgb(255, 255, 255);
+        } else if total || row % 2 == 0 {
+            style.fill = crate::FillStyle::Solid {
+                color: tint(if total { 76 } else { 92 }),
+            };
+        }
+    } else if header || total {
+        style.fill = crate::FillStyle::Solid {
+            color: tint(if header { 78 } else { 90 }),
+        };
+    }
+    style
+}
+
+fn resolve_named_source(
+    workbook: &Workbook,
+    name: &str,
+    scope: &str,
+    depth: usize,
+) -> Result<(usize, CellRange)> {
+    if depth > 16 {
+        return Err(fail("Pivot named source contains a circular reference"));
+    }
+    let current = sheet_index(workbook, scope).unwrap_or(0);
+    let defined = workbook.get_named_range(name, current).ok_or_else(|| {
+        fail(format!(
+            "Pivot source table or defined name not found: {name}"
+        ))
+    })?;
+    let expression = defined.expression();
+    if let Some((sheet, reference)) = expression.rsplit_once('!') {
+        let sheet = sheet
+            .strip_prefix('\'')
+            .and_then(|s| s.strip_suffix('\''))
+            .map(|s| s.replace("''", "'"))
+            .unwrap_or_else(|| sheet.into());
+        return Ok((sheet_index(workbook, &sheet)?, CellRange::parse(reference)?));
+    }
+    if let Ok(range) = CellRange::parse(expression) {
+        return Ok((current, range));
+    }
+    resolve_named_source(workbook, expression, scope, depth + 1)
+}
+
+fn canonical_member(
+    aliases: &[BTreeMap<String, String>],
+    field: usize,
+    value: &PivotValue,
+) -> PivotValue {
+    if let PivotValue::Text(text) = value {
+        aliases
+            .get(field)
+            .and_then(|aliases| aliases.get(&text.to_lowercase()))
+            .map(|caption| PivotValue::Text(caption.clone()))
+            .unwrap_or_else(|| value.clone())
+    } else {
+        value.clone()
+    }
+}
+
+fn compare_group_keys(field: &PivotAxisField, a: &str, b: &str) -> std::cmp::Ordering {
+    let Some(group) = &field.grouping else {
+        return compare_keys(a, b);
+    };
+    let left = PivotValue::from_key(a).caption();
+    let right = PivotValue::from_key(b).caption();
+    let order = |caption: &str| -> Option<f64> {
+        if caption.starts_with('<') {
+            return Some(f64::NEG_INFINITY);
+        }
+        if caption.starts_with('>') {
+            return Some(f64::INFINITY);
+        }
+        match group.kind.as_str() {
+            "number" => {
+                let offset = usize::from(caption.starts_with('-'));
+                caption[offset..]
+                    .find('-')
+                    .and_then(|index| caption[..offset + index].parse().ok())
+            }
+            "date" if group.unit == "months" => [
+                "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
+            ]
+            .iter()
+            .position(|month| *month == caption)
+            .map(|index| index as f64),
+            _ => None,
+        }
+    };
+    match (order(&left), order(&right)) {
+        (Some(left), Some(right)) => left.total_cmp(&right),
+        _ => compare_keys(a, b),
+    }
+}
+
+fn calculated_paths(
+    pivot: &PivotTable,
+    groups: &Aggregates,
+    axis: &[PivotAxisField],
+    keys: &[String],
+    other: &[String],
+    is_row: bool,
+    measure: usize,
+    position: usize,
+) -> BTreeSet<Vec<String>> {
+    let mut paths = BTreeSet::new();
+    for (candidate_rows, candidate_cols, candidate_measure) in groups.keys() {
+        if *candidate_measure != measure {
+            continue;
+        }
+        let (candidate, opposite) = if is_row {
+            (candidate_rows, candidate_cols)
+        } else {
+            (candidate_cols, candidate_rows)
+        };
+        if candidate.len() == position + 1 && candidate.starts_with(keys) && opposite == other {
+            paths.insert(candidate.clone());
+        }
+    }
+    let parents: BTreeSet<_> = paths.iter().map(|path| path[..position].to_vec()).collect();
+    for parent in parents {
+        for item in pivot
+            .calculated_items
+            .iter()
+            .filter(|item| item.field == axis[position].field)
+        {
+            let mut path = parent.clone();
+            path.push(PivotValue::Text(item.name.clone()).key());
+            paths.insert(path);
+        }
+    }
+    paths
+}
+fn calculated_member_allowed(
+    pivot: &PivotTable,
+    groups: &Aggregates,
+    axis: &[PivotAxisField],
+    path: &[String],
+    is_row: bool,
+    depth: usize,
+) -> bool {
+    if depth > 32 {
+        return false;
+    }
+    let Some(position) = path.len().checked_sub(1) else {
+        return true;
+    };
+    let field = axis[position].field;
+    let key = &path[position];
+    let member = PivotValue::from_key(key);
+    let measure_value = |measure: usize, keys: &[String]| {
+        if is_row {
+            raw_value_depth(pivot, groups, keys, &[], measure, None, depth + 1, false)
+        } else {
+            raw_value_depth(pivot, groups, &[], keys, measure, None, depth + 1, false)
+        }
+    };
+    pivot
+        .filters
+        .iter()
+        .filter(|filter| filter.field == field)
+        .all(|filter| match filter.kind.as_str() {
+            "members" => filter.values.iter().any(|candidate| {
+                candidate == key
+                    || PivotValue::from_key(candidate)
+                        .caption()
+                        .eq_ignore_ascii_case(&member.caption())
+            }),
+            "label" => filter_match(
+                &filter.operator,
+                &member.caption(),
+                &filter.value,
+                &filter.value2,
+                false,
+            ),
+            "value" => filter_match(
+                &filter.operator,
+                &measure_value(filter.measure, path).caption(),
+                &filter.value,
+                &filter.value2,
+                true,
+            ),
+            "top10" => {
+                let candidates = calculated_paths(
+                    pivot,
+                    groups,
+                    axis,
+                    &path[..position],
+                    &[],
+                    is_row,
+                    filter.measure,
+                    position,
+                );
+                let mut ranked: Vec<_> = candidates
+                    .into_iter()
+                    .filter_map(|candidate| {
+                        numeric(&measure_value(filter.measure, &candidate))
+                            .map(|value| (candidate, value))
+                    })
+                    .collect();
+                ranked.sort_by(|a, b| {
+                    if filter.top {
+                        b.1.total_cmp(&a.1)
+                    } else {
+                        a.1.total_cmp(&b.1)
+                    }
+                });
+                let count = if filter.percent {
+                    (ranked.len() as f64 * filter.count.min(100.0) / 100.0).ceil() as usize
+                } else {
+                    filter.count as usize
+                };
+                let cutoff = ranked.get(count.saturating_sub(1)).map(|(_, value)| *value);
+                ranked
+                    .iter()
+                    .enumerate()
+                    .any(|(index, (candidate, value))| {
+                        candidate == path && (index < count || Some(*value) == cutoff)
+                    })
+            }
+            _ => true,
+        })
+}
+
+fn subtotal_caption(function: Option<&str>) -> &'static str {
+    match function {
+        Some("sum") => "Sum",
+        Some("count") => "Count",
+        Some("countNums") => "Count Numbers",
+        Some("average") => "Average",
+        Some("min") => "Min",
+        Some("max") => "Max",
+        Some("product") => "Product",
+        Some("var") => "Var",
+        Some("varp") => "VarP",
+        Some("stdDev") => "StdDev",
+        Some("stdDevp") => "StdDevP",
+        _ => "Total",
+    }
+}
