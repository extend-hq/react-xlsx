+fn series_for_pivot(pivot: &PivotTable, measure: Option<usize>) -> Vec<DataSeries> {
+    let cells: Vec<_> = pivot
+        .output
+        .iter()
+        .filter(|cell| {
+            cell.measure.is_some()
+                && cell.subtotal_function.is_none()
+                && (pivot.rows.is_empty() || !cell.row_keys.is_empty())
+                && (pivot.columns.is_empty() || !cell.column_keys.is_empty())
+                && measure.is_none_or(|value| cell.measure == Some(value))
+        })
+        .collect();
+    let row_keys: BTreeSet<_> = cells.iter().map(|cell| cell.row_keys.clone()).collect();
+    let col_keys: BTreeSet<_> = cells.iter().map(|cell| cell.column_keys.clone()).collect();
+    let leaf_rows: BTreeSet<_> = row_keys
+        .iter()
+        .filter(|keys| {
+            !row_keys
+                .iter()
+                .any(|other| other.len() > keys.len() && other.starts_with(keys))
+        })
+        .cloned()
+        .collect();
+    let leaf_cols: BTreeSet<_> = col_keys
+        .iter()
+        .filter(|keys| {
+            !col_keys
+                .iter()
+                .any(|other| other.len() > keys.len() && other.starts_with(keys))
+        })
+        .cloned()
+        .collect();
+    let mut rows = Vec::new();
+    let mut row_seen = BTreeSet::new();
+    let mut columns = Vec::new();
+    let mut col_seen = BTreeSet::new();
+    let mut values = BTreeMap::new();
+    for cell in cells {
+        if !leaf_rows.contains(&cell.row_keys) || !leaf_cols.contains(&cell.column_keys) {
+            continue;
+        }
+        let measure = cell.measure.unwrap();
+        if row_seen.insert(cell.row_keys.clone()) {
+            rows.push(cell.row_keys.clone());
+        }
+        if col_seen.insert((cell.column_keys.clone(), measure)) {
+            columns.push((cell.column_keys.clone(), measure));
+        }
+        let number = match cell.value {
+            PivotValue::Number(value) if value.is_finite() => value,
+            _ => 0.0,
+        };
+        values.insert(
+            (cell.row_keys.clone(), cell.column_keys.clone(), measure),
+            number,
+        );
+    }
+    let labels: Vec<_> = rows
+        .iter()
+        .map(|keys| {
+            if keys.is_empty() {
+                "Total".into()
+            } else {
+                keys.iter()
+                    .map(|key| PivotValue::from_key(key).caption())
+                    .collect::<Vec<_>>()
+                    .join(" / ")
+            }
+        })
+        .collect();
+    columns
+        .into_iter()
+        .map(|(keys, measure)| {
+            let name = keys
+                .iter()
+                .map(|key| PivotValue::from_key(key).caption())
+                .chain(std::iter::once(pivot.values[measure].name.clone()))
+                .collect::<Vec<_>>()
+                .join(" / ");
+            let data = rows
+                .iter()
+                .map(|row| {
+                    *values
+                        .get(&(row.clone(), keys.clone(), measure))
+                        .unwrap_or(&0.0)
+                })
+                .collect();
+            DataSeries::new(DataReference::Numbers(data))
+                .with_name(name)
+                .with_categories(DataReference::Strings(labels.clone()))
+        })
+        .collect()
+}
+
+fn update_chart(chart: &mut Chart, pivot: &PivotTable, binding: Option<&PivotChartBinding>) {
+    chart.pivot_modified = true;
+    if pivot.output.is_empty() {
+        rebind_chart(chart, pivot, binding);
+        return;
+    }
+    let mut series = series_for_pivot(pivot, binding.and_then(|value| value.measure));
+    if matches!(
+        chart.chart_type,
+        ChartType::Pie | ChartType::Doughnut | ChartType::PieExploded
+    ) {
+        series.truncate(1);
+    }
+    for (index, next) in series.iter_mut().enumerate() {
+        if let Some(previous) = chart.series.get(index) {
+            next.shape_properties = previous.shape_properties.clone();
+            next.data_labels = previous.data_labels.clone();
+            next.marker = previous.marker.clone();
+        }
+    }
+    chart.series = series;
+    chart.type_groups.clear();
+    chart.axes.clear();
+    rebind_chart(chart, pivot, binding);
+}
+
+fn rebind_chart(chart: &mut Chart, pivot: &PivotTable, binding: Option<&PivotChartBinding>) {
+    if let Some(binding) = binding {
+        let source = PivotSource {
+            name: format!(
+                "[{}]{}!{}",
+                binding.workbook_name, pivot.target.sheet, pivot.name
+            ),
+            format_id: binding.format_id,
+        };
+        if chart.pivot_source.as_ref() != Some(&source) {
+            chart.pivot_source = Some(source);
+            chart.pivot_modified = true;
+        }
+    }
+}
+
+fn visit_charts(
+    kind: &mut DrawingKind,
+    name: Option<&str>,
+    action: &mut impl FnMut(Option<&str>, &mut Chart),
+) {
+    match kind {
+        DrawingKind::Chart(chart) => action(name, chart),
+        DrawingKind::Group(group) => {
+            for child in &mut group.children {
+                visit_charts(&mut child.kind, child.meta.name.as_deref(), action);
+            }
+        }
+        _ => {}
+    }
+}
+
+pub fn create_pivot_chart(
+    workbook: &mut Workbook,
+    id: &str,
+    options: PivotChartOptions,
+) -> Result<PivotChartBinding> {
+    let pivot_index = workbook
+        .pivot_tables()
+        .iter()
+        .position(|pivot| pivot.id == id)
+        .ok_or_else(|| Error::other("Pivot table not found"))?;
+    let pivot = workbook.pivot_tables()[pivot_index].clone();
+    if !pivot.unsupported_features.is_empty() {
+        return Err(Error::other(
+            "Cannot create a PivotChart for an unsupported pivot table",
+        ));
+    }
+    if pivot.output.is_empty() {
+        return Err(Error::other(
+            "Refresh the pivot table before creating a PivotChart",
+        ));
+    }
+    if pivot.values.is_empty() {
+        return Err(Error::other(
+            "A PivotChart requires at least one value field",
+        ));
+    }
+    if options
+        .measure
+        .is_some_and(|index| index >= pivot.values.len())
+    {
+        return Err(Error::other("PivotChart value field is out of range"));
+    }
+    if options.workbook_name.is_empty() || options.workbook_name.contains(['[', ']']) {
+        return Err(Error::other(
+            "PivotChart requires the exported workbook filename",
+        ));
+    }
+    let sheet_name = if options.sheet.is_empty() {
+        &pivot.target.sheet
+    } else {
+        &options.sheet
+    };
+    let sheet_index = workbook
+        .worksheets()
+        .position(|sheet| sheet.name().eq_ignore_ascii_case(sheet_name))
+        .ok_or_else(|| Error::SheetNotFound(sheet_name.clone()))?;
+    let sheet = workbook.worksheet(sheet_index).unwrap();
+    if sheet
+        .protection()
+        .is_some_and(|protection| protection.protected)
+    {
+        return Err(Error::other(
+            "Cannot add a PivotChart to a protected worksheet",
+        ));
+    }
+    let cell = if options.cell.is_empty() {
+        CellAddress::new(1, 8)
+    } else {
+        CellAddress::parse(&options.cell)?
+    };
+    let width = options.width.unwrap_or(560.0);
+    let height = options.height.unwrap_or(340.0);
+    if !width.is_finite()
+        || !height.is_finite()
+        || !(80.0..=10000.0).contains(&width)
+        || !(80.0..=10000.0).contains(&height)
+    {
+        return Err(Error::other(
+            "PivotChart dimensions must be between 80 and 10000 pixels",
+        ));
+    }
+    let mut number = 1;
+    let drawing_name = loop {
+        let candidate = format!("PivotChart {number}");
+        if !sheet
+            .drawings()
+            .iter()
+            .any(|drawing| drawing.meta.name.as_deref() == Some(&candidate))
+        {
+            break candidate;
+        }
+        number += 1;
+    };
+    let chart_type = chart_type(&options.chart_type)?;
+    let binding = PivotChartBinding {
+        sheet: sheet.name().into(),
+        drawing_name: drawing_name.clone(),
+        chart_type: format!("{chart_type:?}"),
+        title: if options.title.is_empty() {
+            pivot.name.clone()
+        } else {
+            options.title
+        },
+        workbook_name: options.workbook_name,
+        format_id: 0,
+        measure: options.measure,
+    };
+    let mut chart = Chart::new(chart_type.clone());
+    chart.title = Some(binding.title.clone());
+    chart.legend = Some(Legend::new(LegendPosition::Bottom));
+    chart.display_blanks_as = Some(DisplayBlanksAs::Zero);
+    if !matches!(chart_type, ChartType::Pie | ChartType::Doughnut) {
+        let horizontal = matches!(
+            chart_type,
+            ChartType::BarClustered | ChartType::BarStacked | ChartType::BarPercentStacked
+        );
+        chart.category_axis = Some(Axis {
+            position: Some(if horizontal {
+                AxisPosition::Left
+            } else {
+                AxisPosition::Bottom
+            }),
+            ..Axis::default()
+        });
+        chart.value_axis = Some(Axis {
+            axis_type: AxisType::Value,
+            position: Some(if horizontal {
+                AxisPosition::Bottom
+            } else {
+                AxisPosition::Left
+            }),
+            major_gridlines: true,
+            ..Axis::default()
+        });
+    }
+    update_chart(&mut chart, &pivot, Some(&binding));
+    workbook
+        .worksheet_mut(sheet_index)
+        .unwrap()
+        .add_drawing(DrawingObject {
+            meta: DrawingMeta {
+                name: Some(drawing_name),
+                ..DrawingMeta::default()
+            },
+            anchor: DrawingAnchor::OneCell {
+                from: CellMarker {
+                    row: cell.row,
+                    col: cell.col,
+                    ..CellMarker::default()
+                },
+                width_emu: (width * 9525.0).round() as i64,
+                height_emu: (height * 9525.0).round() as i64,
+            },
+            kind: DrawingKind::Chart(Box::new(chart)),
+        })?;
+    workbook.pivot_tables_mut()[pivot_index]
+        .charts
+        .push(binding.clone());
+    workbook.pivot_tables_mut()[pivot_index].dirty = true;
+    Ok(binding)
+}
+
+pub fn sync_pivot_charts(workbook: &mut Workbook, pivot: &PivotTable) {
+    for sheet in workbook.worksheets_mut() {
+        let sheet_name = sheet.name().to_string();
+        for drawing in sheet.drawings_mut() {
+            let DrawingKind::Chart(chart) = &mut drawing.kind else {
+                continue;
+            };
+            let binding = pivot.charts.iter().find(|binding| {
+                binding.sheet.eq_ignore_ascii_case(&sheet_name)
+                    && drawing.meta.name.as_deref() == Some(&binding.drawing_name)
+            });
+            if binding.is_some()
+                || chart
+                    .pivot_source
+                    .as_ref()
+                    .is_some_and(|source| source_matches(source, pivot))
+            {
+                update_chart(chart, pivot, binding);
+            }
+        }
+    }
+    for sheet in workbook.chartsheets_mut() {
+        let binding = pivot.charts.iter().find(|binding| {
+            binding.sheet.eq_ignore_ascii_case(&sheet.name) && binding.drawing_name.is_empty()
+        });
+        if binding.is_some()
+            || sheet
+                .chart
+                .pivot_source
+                .as_ref()
+                .is_some_and(|source| source_matches(source, pivot))
+        {
+            update_chart(&mut sheet.chart, pivot, binding);
+        }
+    }
+}
+
+pub fn rebind_pivot_charts(workbook: &mut Workbook, pivot: &PivotTable) {
+    for sheet in workbook.worksheets_mut() {
+        let sheet_name = sheet.name().to_string();
+        for drawing in sheet.drawings_mut() {
+            visit_charts(
+                &mut drawing.kind,
+                drawing.meta.name.as_deref(),
+                &mut |name, chart| {
+                    let binding = pivot.charts.iter().find(|binding| {
+                        binding.sheet.eq_ignore_ascii_case(&sheet_name)
+                            && name == Some(&binding.drawing_name)
+                    });
+                    rebind_chart(chart, pivot, binding);
+                },
+            );
+        }
+    }
+    for sheet in workbook.chartsheets_mut() {
+        let binding = pivot.charts.iter().find(|binding| {
+            binding.sheet.eq_ignore_ascii_case(&sheet.name) && binding.drawing_name.is_empty()
+        });
+        rebind_chart(&mut sheet.chart, pivot, binding);
+    }
+}
+
+pub fn detach_pivot_charts(workbook: &mut Workbook, pivot: &PivotTable) {
+    for sheet in workbook.worksheets_mut() {
+        for drawing in sheet.drawings_mut() {
+            visit_charts(
+                &mut drawing.kind,
+                drawing.meta.name.as_deref(),
+                &mut |_, chart| {
+                    if chart
+                        .pivot_source
+                        .as_ref()
+                        .is_some_and(|source| source_matches(source, pivot))
+                    {
+                        chart.pivot_source = None;
+                        chart.pivot_modified = true;
+                    }
+                },
+            );
+        }
+    }
+    for sheet in workbook.chartsheets_mut() {
+        if sheet
+            .chart
+            .pivot_source
+            .as_ref()
+            .is_some_and(|source| source_matches(source, pivot))
+        {
+            sheet.chart.pivot_source = None;
+            sheet.chart.pivot_modified = true;
+        }
+    }
+}
+
+pub fn discover_pivot_chart_bindings(workbook: &mut Workbook) {
+    let mut bindings: Vec<_> = workbook
+        .pivot_tables()
+        .iter()
+        .enumerate()
+        .flat_map(|(index, pivot)| {
+            workbook.worksheets().flat_map(move |sheet| {
+                sheet.charts().filter_map(move |drawing| {
+                    let chart = drawing.payload;
+                    let source = chart.pivot_source.as_ref()?;
+                    if !source_matches(source, pivot) {
+                        return None;
+                    }
+                    let drawing_name = drawing.meta.name.clone()?;
+                    let name = source.name.trim_matches('\'');
+                    let workbook_name = name
+                        .strip_prefix('[')
+                        .and_then(|name| name.split_once(']'))
+                        .map(|(name, _)| name)
+                        .unwrap_or("")
+                        .to_string();
+                    Some((
+                        index,
+                        chart_type(&format!("{:?}", chart.chart_type)).is_err()
+                            || chart.type_groups.len() > 1
+                            || drawing.path.len() > 1,
+                        PivotChartBinding {
+                            sheet: sheet.name().into(),
+                            drawing_name,
+                            chart_type: format!("{:?}", chart.chart_type),
+                            title: chart.title.clone().unwrap_or_default(),
+                            workbook_name,
+                            format_id: source.format_id,
+                            measure: None,
+                        },
+                    ))
+                })
+            })
+        })
+        .collect();
+    for (index, pivot) in workbook.pivot_tables().iter().enumerate() {
+        for sheet in workbook.chartsheets() {
+            let chart = &sheet.chart;
+            let Some(source) = chart
+                .pivot_source
+                .as_ref()
+                .filter(|source| source_matches(source, pivot))
+            else {
+                continue;
+            };
+            let name = source.name.trim_matches('\'');
+            let workbook_name = name
+                .strip_prefix('[')
+                .and_then(|name| name.split_once(']'))
+                .map(|(name, _)| name)
+                .unwrap_or("")
+                .to_string();
+            bindings.push((
+                index,
+                chart_type(&format!("{:?}", chart.chart_type)).is_err()
+                    || chart.type_groups.len() > 1,
+                PivotChartBinding {
+                    sheet: sheet.name.clone(),
+                    drawing_name: String::new(),
+                    chart_type: format!("{:?}", chart.chart_type),
+                    title: chart.title.clone().unwrap_or_default(),
+                    workbook_name,
+                    format_id: source.format_id,
+                    measure: None,
+                },
+            ));
+        }
+    }
+    for (index, unsupported, binding) in bindings {
+        let pivot = &mut workbook.pivot_tables_mut()[index];
+        if unsupported
+            && !pivot
+                .unsupported_features
+                .iter()
+                .any(|feature| feature == "Unsupported PivotChart type")
+        {
+            pivot
+                .unsupported_features
+                .push("Unsupported PivotChart type".into());
+        }
+        if !pivot
+            .charts
+            .iter()
+            .any(|item| item.sheet == binding.sheet && item.drawing_name == binding.drawing_name)
+        {
+            pivot.charts.push(binding);
+        }
+    }
+}
+
+pub fn update_pivot_chart(
+    workbook: &mut Workbook,
+    sheet_name: &str,
+    drawing_name: &str,
+    title: Option<String>,
+    kind: Option<String>,
+    anchor: Option<DrawingAnchor>,
+) -> Result<()> {
+    let sheet_index = workbook
+        .worksheets()
+        .position(|sheet| sheet.name().eq_ignore_ascii_case(sheet_name))
+        .ok_or_else(|| Error::SheetNotFound(sheet_name.into()))?;
+    let sheet = workbook.worksheet(sheet_index).unwrap();
+    if sheet
+        .protection()
+        .is_some_and(|protection| protection.protected)
+    {
+        return Err(Error::other(
+            "Cannot edit a PivotChart on a protected worksheet",
+        ));
+    }
+    let drawing_index = sheet
+        .drawings()
+        .iter()
+        .position(|drawing| drawing.meta.name.as_deref() == Some(drawing_name))
+        .ok_or_else(|| Error::other("PivotChart drawing not found"))?;
+    let DrawingKind::Chart(chart) = &sheet.drawings()[drawing_index].kind else {
+        return Err(Error::other("Drawing is not a chart"));
+    };
+    let source = chart
+        .pivot_source
+        .as_ref()
+        .ok_or_else(|| Error::other("Chart is not bound to a pivot table"))?;
+    let pivot_index = workbook
+        .pivot_tables()
+        .iter()
+        .position(|pivot| source_matches(source, pivot))
+        .ok_or_else(|| Error::other("PivotChart source not found"))?;
+    if !workbook.pivot_tables()[pivot_index]
+        .unsupported_features
+        .is_empty()
+    {
+        return Err(Error::other(
+            "Cannot edit a PivotChart with unsupported source features",
+        ));
+    }
+    let next_type = kind.as_deref().map(chart_type).transpose()?;
+    if let Some(anchor) = &anchor {
+        crate::drawing::validate_anchor(anchor)?;
+    }
+    let drawing = &mut workbook.worksheet_mut(sheet_index).unwrap().drawings_mut()[drawing_index];
+    if let Some(anchor) = anchor {
+        drawing.anchor = anchor;
+    }
+    let DrawingKind::Chart(chart) = &mut drawing.kind else {
+        unreachable!();
+    };
+    if let Some(title) = &title {
+        chart.title = Some(title.clone());
+    }
+    if let Some(kind) = next_type {
+        let horizontal = matches!(
+            kind,
+            ChartType::BarClustered | ChartType::BarStacked | ChartType::BarPercentStacked
+        );
+        if matches!(kind, ChartType::Pie | ChartType::Doughnut) {
+            chart.category_axis = None;
+            chart.value_axis = None;
+        } else {
+            chart
+                .category_axis
+                .get_or_insert_with(Axis::default)
+                .position = Some(if horizontal {
+                AxisPosition::Left
+            } else {
+                AxisPosition::Bottom
+            });
+            let axis = chart.value_axis.get_or_insert_with(Axis::default);
+            axis.axis_type = AxisType::Value;
+            axis.position = Some(if horizontal {
+                AxisPosition::Bottom
+            } else {
+                AxisPosition::Left
+            });
+        }
+        chart.chart_type = kind;
+    }
+    let pivot = &mut workbook.pivot_tables_mut()[pivot_index];
+    if let Some(binding) = pivot.charts.iter_mut().find(|binding| {
+        binding.sheet.eq_ignore_ascii_case(sheet_name) && binding.drawing_name == drawing_name
+    }) {
+        if let Some(title) = title {
+            binding.title = title;
+        }
+        if let Some(kind) = kind {
+            binding.chart_type = kind;
+        }
+    }
+    let pivot = pivot.clone();
+    let binding = pivot.charts.iter().find(|binding| {
+        binding.sheet.eq_ignore_ascii_case(sheet_name) && binding.drawing_name == drawing_name
+    });
+    let drawing = &mut workbook.worksheet_mut(sheet_index).unwrap().drawings_mut()[drawing_index];
+    if let DrawingKind::Chart(chart) = &mut drawing.kind {
+        update_chart(chart, &pivot, binding);
+    }
+    Ok(())
+}
