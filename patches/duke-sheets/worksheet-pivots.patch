+fn hydrate_headers(
+    pivot: &mut PivotTable,
+    def: &Node,
+    location: &Node,
+    range: CellRange,
+    workbook: &Workbook,
+) {
+    let Some(sheet) = workbook.worksheet_by_name(&pivot.target.sheet) else {
+        return;
+    };
+    let mut headers = Vec::new();
+    let mut add = |row: u32, col: u32, axis: &str, fields: Vec<PivotHeaderField>| {
+        if fields.is_empty()
+            || row >= duke_sheets_core::MAX_ROWS
+            || col >= u32::from(duke_sheets_core::MAX_COLS)
+        {
+            return;
+        }
+        let value = PivotValue::from_cell(&sheet.get_value_at(row, col as u16));
+        let caption = if value == PivotValue::Blank {
+            fields[0].name.clone()
+        } else {
+            value.caption()
+        };
+        headers.push(PivotHeader {
+            row,
+            col: col as u16,
+            axis: axis.into(),
+            caption,
+            fields,
+        });
+    };
+    if def.bool("showHeaders", true) {
+        let row = range.start.row + location.num("firstDataRow").saturating_sub(1) as u32;
+        if pivot.layout == "compact" {
+            add(
+                row,
+                u32::from(range.start.col),
+                "rows",
+                pivot
+                    .rows
+                    .iter()
+                    .enumerate()
+                    .map(|(depth, axis)| pivot_axis_header_field(pivot, axis, depth))
+                    .collect(),
+            );
+        } else {
+            let positions: Vec<_> = def
+                .child("rowFields")
+                .into_iter()
+                .flat_map(|n| n.all("field"))
+                .enumerate()
+                .filter_map(|(position, field)| {
+                    field.attr("x").parse::<usize>().ok().map(|_| position)
+                })
+                .collect();
+            for (depth, axis) in pivot.rows.iter().enumerate() {
+                let position = positions.get(depth).copied().unwrap_or(depth);
+                if position < location.num("firstDataCol") {
+                    add(
+                        row,
+                        u32::from(range.start.col) + position as u32,
+                        "rows",
+                        vec![pivot_axis_header_field(pivot, axis, depth)],
+                    );
+                }
+            }
+        }
+        if !pivot.columns.is_empty() {
+            add(
+                range.start.row + location.num("firstHeaderRow").saturating_sub(1) as u32,
+                u32::from(range.start.col) + location.num("firstDataCol") as u32,
+                "columns",
+                pivot
+                    .columns
+                    .iter()
+                    .enumerate()
+                    .map(|(depth, axis)| pivot_axis_header_field(pivot, axis, depth))
+                    .collect(),
+            );
+        }
+    }
+    let count = pivot.report_filters.len();
+    if count > 0 {
+        let over_then_down = def.bool("pageOverThenDown", false);
+        let saved_wrap = location.num(if over_then_down {
+            "colPageCount"
+        } else {
+            "rowPageCount"
+        });
+        let wrap = if saved_wrap > 0 {
+            saved_wrap
+        } else if def.num("pageWrap") > 0 {
+            def.num("pageWrap")
+        } else {
+            count
+        }
+        .max(1);
+        let rows = location.num("rowPageCount").max(if over_then_down {
+            count.div_ceil(wrap)
+        } else {
+            count.min(wrap)
+        });
+        let start_row = range.start.row.saturating_sub(rows as u32 + 1);
+        for (depth, field) in pivot.report_filters.iter().copied().enumerate() {
+            let (row, col) = if over_then_down {
+                (depth / wrap, depth % wrap)
+            } else {
+                (depth % wrap, depth / wrap)
+            };
+            if let Some(source) = pivot.fields.get(field) {
+                add(
+                    start_row + row as u32,
+                    u32::from(range.start.col) + col as u32 * 3 + 1,
+                    "reportFilters",
+                    vec![PivotHeaderField {
+                        field,
+                        depth,
+                        name: source.name.clone(),
+                        grouping_unit: None,
+                    }],
+                );
+            }
+        }
+    }
+    pivot.headers = headers;
+}
+
+fn hydrate_output(
+    pivot: &mut PivotTable,
+    def: &Node,
+    shared: &[Vec<PivotValue>],
+    workbook: &Workbook,
+) {
+    let Some(location) = def.child("location") else {
+        return;
+    };
+    let Ok(range) = CellRange::parse(location.attr("ref")) else {
+        return;
+    };
+    let Some(sheet) = workbook.worksheet_by_name(&pivot.target.sheet) else {
+        return;
+    };
+    hydrate_headers(pivot, def, location, range, workbook);
+    let pivot_fields: Vec<_> = def
+        .child("pivotFields")
+        .into_iter()
+        .flat_map(|n| n.all("pivotField"))
+        .collect();
+    let decode_axis = |row: bool| -> Vec<(Vec<String>, Option<usize>, bool)> {
+        let fields: Vec<i64> = def
+            .child(if row { "rowFields" } else { "colFields" })
+            .into_iter()
+            .flat_map(|n| n.all("field"))
+            .map(|n| n.attr("x").parse().unwrap_or(-2))
+            .collect();
+        let mut previous: Vec<usize> = Vec::new();
+        let mut result = Vec::new();
+        for item in def
+            .child(if row { "rowItems" } else { "colItems" })
+            .into_iter()
+            .flat_map(|n| n.all("i"))
+        {
+            let mut indices: Vec<_> = previous.iter().take(item.num("r")).copied().collect();
+            indices.extend(item.all("x").map(|n| n.num("v")));
+            previous = indices.clone();
+            let group_label = item.attr("t").is_empty()
+                && fields
+                    .iter()
+                    .position(|f| *f == -2)
+                    .is_some_and(|position| indices.len() <= position);
+            let mut keys = Vec::new();
+            let mut measure = if fields.contains(&-2) {
+                Some(item.num("i"))
+            } else {
+                None
+            };
+            if item.attr("t") != "grand" {
+                for (field, index) in fields.iter().zip(indices) {
+                    if *field < 0 {
+                        measure = Some(index);
+                        continue;
+                    }
+                    let f = *field as usize;
+                    let member = pivot_fields
+                        .get(f)
+                        .and_then(|p| p.child("items"))
+                        .and_then(|p| p.children.get(index));
+                    if let Some(member) = member {
+                        if member.attr("t").is_empty() || member.attr("t") == "data" {
+                            if let Some(value) = shared.get(f).and_then(|s| s.get(member.num("x")))
+                            {
+                                keys.push(value.key());
+                            }
+                        }
+                    }
+                }
+            }
+            result.push((keys, measure, group_label));
+        }
+        if result.is_empty() {
+            result.push((vec![], None, false));
+        }
+        result
+    };
+    let rows = decode_axis(true);
+    let cols = decode_axis(false);
+    for (r, (row_keys, row_measure, row_label)) in rows.iter().enumerate() {
+        if *row_label {
+            continue;
+        }
+        for (c, (column_keys, col_measure, column_label)) in cols.iter().enumerate() {
+            if *column_label {
+                continue;
+            }
+            let row = range.start.row + location.num("firstDataRow") as u32 + r as u32;
+            let col = u32::from(range.start.col) + location.num("firstDataCol") as u32 + c as u32;
+            if row > range.end.row || col > u32::from(range.end.col) {
+                continue;
+            }
+            let measure = col_measure.or(*row_measure).unwrap_or(0);
+            if measure >= pivot.values.len() {
+                continue;
+            }
+            let kind = if (!pivot.rows.is_empty() && row_keys.is_empty())
+                || (!pivot.columns.is_empty() && column_keys.is_empty())
+            {
+                "grand"
+            } else if row_keys.len() < pivot.rows.len() || column_keys.len() < pivot.columns.len() {
+                "subtotal"
+            } else {
+                "value"
+            };
+            pivot.output.push(PivotOutputCell {
+                row,
+                col: col as u16,
+                value: PivotValue::from_cell(&sheet.get_value_at(row, col as u16)),
+                row_keys: row_keys.clone(),
+                column_keys: column_keys.clone(),
+                measure: Some(measure),
+                kind: kind.into(),
+                ..PivotOutputCell::default()
+            });
+        }
+    }
+    if !pivot.report_filters.is_empty() {
+        let row = range
+            .start
+            .row
+            .saturating_sub(pivot.report_filters.len() as u32 + 1);
+        pivot.target.cell = CellAddress::new(row, range.start.col).to_a1_string();
+        pivot.output_range =
+            Some(CellRange::new(CellAddress::new(row, range.start.col), range.end).to_a1_string());
+    }
+}
