+pub fn read_pivot_source(
+    workbook: &Workbook,
+    source: &PivotSource,
+) -> Result<(Vec<PivotSourceField>, Vec<Vec<PivotValue>>)> {
+    let (sheet_index, range) = resolve_pivot_source(workbook, source)?;
+    let width = (range.end.col - range.start.col + 1) as usize;
+    if u64::from(range.end.row - range.start.row + 1) * width as u64 > MAX_SOURCE_CELLS {
+        return Err(fail("Pivot source exceeds the supported cell limit"));
+    }
+    let sheet = workbook.worksheet(sheet_index).unwrap();
+    let mut names = BTreeSet::new();
+    let mut fields = Vec::with_capacity(width);
+    for (index, col) in (range.start.col..=range.end.col).enumerate() {
+        let name = sheet
+            .get_calculated_value_at(range.start.row, col)
+            .unwrap_or(&CellValue::Empty)
+            .to_string();
+        if name.trim().is_empty() {
+            return Err(fail("Every pivot source column needs a nonempty header"));
+        }
+        if !names.insert(name.to_lowercase()) {
+            return Err(fail("Pivot source column headers must be unique"));
+        }
+        fields.push(PivotSourceField {
+            index,
+            name,
+            data_type: "empty".into(),
+            items: vec![],
+        });
+    }
+    let mut records = Vec::new();
+    let mut items = vec![Vec::<PivotMember>::new(); width];
+    let mut seen_items = vec![BTreeSet::<String>::new(); width];
+    for row in range.start.row + 1..=range.end.row {
+        let record: Vec<_> = (range.start.col..=range.end.col)
+            .map(|col| {
+                PivotValue::from_cell(
+                    sheet
+                        .get_calculated_value_at(row, col)
+                        .unwrap_or(&CellValue::Empty),
+                )
+            })
+            .collect();
+        for (index, value) in record.iter().enumerate() {
+            if seen_items[index].insert(match value {
+                PivotValue::Text(text) => format!("s:{}", text.to_lowercase()),
+                _ => value.key(),
+            }) {
+                items[index].push(PivotMember {
+                    key: value.key(),
+                    caption: value.caption(),
+                });
+            }
+            let kind = match value {
+                PivotValue::Number(_)
+                    if sheet
+                        .cell_style_at(row, range.start.col + index as u16)
+                        .is_some_and(|style| style.number_format.is_date_format()) =>
+                {
+                    "date"
+                }
+                PivotValue::Number(_) => "number",
+                PivotValue::Text(_) => "text",
+                PivotValue::Boolean(_) => "boolean",
+                PivotValue::Error(_) => "error",
+                PivotValue::Blank => continue,
+            };
+            if fields[index].data_type == "empty" {
+                fields[index].data_type = kind.into();
+            } else if fields[index].data_type != kind {
+                fields[index].data_type = "mixed".into();
+            }
+        }
+        records.push(record);
+    }
+    for (field, items) in fields.iter_mut().zip(items) {
+        field.items = items;
+    }
+    Ok((fields, records))
+}
