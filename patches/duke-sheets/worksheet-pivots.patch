diff --git a/crates/duke-sheets-core/src/pivot.rs b/crates/duke-sheets-core/src/pivot.rs
new file mode 100644
index 0000000..99eb50d
--- /dev/null
+++ b/crates/duke-sheets-core/src/pivot.rs
@@ -0,0 +1,3354 @@
+use crate::{CellAddress, CellError, CellRange, CellValue, Color, Error, Result, Style, Workbook};
+use chrono::{Datelike, Duration, NaiveDate, Timelike};
+use std::collections::{BTreeMap, BTreeSet};
+
+const MAX_SOURCE_CELLS: u64 = 5_000_000;
+const MAX_OUTPUT_CELLS: usize = 1_000_000;
+const MAX_GROUPS: usize = 100_000;
+
+#[derive(Debug, Clone, PartialEq, Default)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize, serde::Deserialize))]
+pub enum PivotValue {
+    #[default]
+    Blank,
+    Number(f64),
+    Text(String),
+    Boolean(bool),
+    Error(String),
+}
+impl PivotValue {
+    pub fn key(&self) -> String {
+        match self {
+            Self::Blank => "z:".into(),
+            Self::Number(n) => format!("n:{}", if *n == 0.0 { 0.0 } else { *n }),
+            Self::Text(s) => format!("s:{s}"),
+            Self::Boolean(v) => format!("b:{}", u8::from(*v)),
+            Self::Error(s) => format!("e:{s}"),
+        }
+    }
+    pub fn caption(&self) -> String {
+        match self {
+            Self::Blank => "(blank)".into(),
+            Self::Number(n) => n.to_string(),
+            Self::Text(s) => s.clone(),
+            Self::Boolean(v) => if *v { "TRUE" } else { "FALSE" }.into(),
+            Self::Error(s) => s.clone(),
+        }
+    }
+    pub fn from_cell(value: &CellValue) -> Self {
+        match value {
+            CellValue::Empty => Self::Blank,
+            CellValue::Number(n) => Self::Number(*n),
+            CellValue::Boolean(v) => Self::Boolean(*v),
+            CellValue::Error(e) => Self::Error(e.to_string()),
+            _ => Self::Text(value.to_string()),
+        }
+    }
+    pub fn to_cell(&self) -> CellValue {
+        match self {
+            Self::Blank => CellValue::Empty,
+            Self::Number(n) if n.is_finite() => CellValue::Number(*n),
+            Self::Number(_) => CellValue::Error(CellError::Num),
+            Self::Text(s) => CellValue::string(s),
+            Self::Boolean(v) => CellValue::Boolean(*v),
+            Self::Error(s) => CellValue::Error(CellError::parse(s).unwrap_or(CellError::Value)),
+        }
+    }
+    pub fn from_key(key: &str) -> Self {
+        let (kind, value) = key.split_once(':').unwrap_or(("s", key));
+        match kind {
+            "z" => Self::Blank,
+            "n" => value.parse().map(Self::Number).unwrap_or(Self::Blank),
+            "b" => Self::Boolean(value == "1"),
+            "e" => Self::Error(value.into()),
+            _ => Self::Text(value.into()),
+        }
+    }
+}
