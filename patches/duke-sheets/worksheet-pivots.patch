+pub fn infer_pivot_output(pivot: &PivotTable, date1904: bool) -> Result<Vec<PivotOutputCell>> {
+    if pivot.cache.is_empty() && pivot.output.is_empty() {
+        return Err(fail("Pivot cache records are unavailable; refresh from the source before calculating pivot data"));
+    }
+    let mut copy = pivot.clone();
+    normalize(&mut copy)?;
+    render(&mut copy, date1904)?;
+    Ok(copy.output)
+}
