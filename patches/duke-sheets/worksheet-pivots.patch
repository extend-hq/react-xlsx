+pub(crate) fn read_pivots<R: Read + Seek>(
+    package: &mut OpcPackage<R>,
+    workbook_path: &PartName,
+    workbook: &mut Workbook,
+) -> XlsxResult<()> {
+    let rels = package.relationships(&RelationshipSource::Part(workbook_path.clone()), false)?;
+    if !rels
+        .iter()
+        .any(|rel| rel.rel_type.ends_with("/pivotCacheDefinition"))
+    {
+        return Ok(());
+    }
+    let workbook_xml = parse(&read_part(package, workbook_path.zip_name())?)?;
+    let cache_links: BTreeMap<String, String> = workbook_xml
+        .child("pivotCaches")
+        .into_iter()
+        .flat_map(|n| n.all("pivotCache"))
+        .filter_map(|node| {
+            rels.iter()
+                .find(|r| r.id == node.attr("r:id"))
+                .and_then(|r| r.internal_path())
+                .map(|p| (node.attr("cacheId").into(), p.into()))
+        })
+        .collect();
+    if cache_links.is_empty() {
+        return Ok(());
+    }
+    let mut state = PivotRoundtrip::default();
+    let mut formats = BTreeMap::new();
+    for rel in rels.iter().filter(|r| r.rel_type.ends_with("/styles")) {
+        if let Some(path) = rel.internal_path() {
+            if let Ok(styles) = read_part(package, path).and_then(|b| parse(&b)) {
+                for fmt in styles
+                    .child("numFmts")
+                    .into_iter()
+                    .flat_map(|n| n.all("numFmt"))
+                {
+                    formats.insert(fmt.num("numFmtId"), fmt.attr("formatCode").into());
+                }
+            }
+        }
+    }
+    let sheet_entries: Vec<_> = workbook_xml
+        .child("sheets")
+        .into_iter()
+        .flat_map(|n| n.all("sheet"))
+        .cloned()
+        .collect();
+    for sheet in sheet_entries {
+        let Some(sheet_path) = rels
+            .iter()
+            .find(|r| r.id == sheet.attr("r:id"))
+            .and_then(|r| r.internal_path())
+        else {
+            continue;
+        };
+        if workbook.worksheet_by_name(sheet.attr("name")).is_none() {
+            continue;
+        }
+        let sheet_rels = package.relationships(
+            &RelationshipSource::Part(PartName::from_zip_name(sheet_path)?),
+            false,
+        )?;
+        let slicers: Vec<_> = sheet_rels
+            .iter()
+            .filter(|r| r.rel_type.ends_with("/slicer") || r.rel_type.ends_with("/timeline"))
+            .collect();
+        if !slicers.is_empty() {
+            let xml = parse(&read_part(package, sheet_path)?)?;
+            if let Some(ext) = pivot_controls_extension(&xml) {
+                state.sheet_extras.insert(sheet.attr("name").into(), ext);
+            }
+            for rel in slicers {
+                if let Some(path) = rel.internal_path() {
+                    capture_tree(package, path, &mut state.parts)?;
+                }
+                state
+                    .sheet_relationships
+                    .entry(sheet.attr("name").into())
+                    .or_default()
+                    .push(
+                        Node::new("Relationship")
+                            .set("Id", &rel.id)
+                            .set("Type", &rel.rel_type)
+                            .set(
+                                "Target",
+                                rel.internal_path()
+                                    .map(|p| format!("/{p}"))
+                                    .unwrap_or_else(|| rel.raw_target.clone()),
+                            ),
+                    );
+            }
+        }
+        for rel in sheet_rels
+            .iter()
+            .filter(|r| r.rel_type.ends_with("/pivotTable"))
+        {
+            let Some(path) = rel.internal_path() else {
+                continue;
+            };
+            let definition = parse(&read_part(package, path)?)?;
+            let Some(cache_path) = cache_links.get(definition.attr("cacheId")) else {
+                continue;
+            };
+            let cache = parse(&read_part(package, cache_path)?)?;
+            capture_tree(package, path, &mut state.parts)?;
+            capture_tree(package, cache_path, &mut state.parts)?;
+            let pivot = import_pivot(
+                package,
+                workbook,
+                &definition,
+                &cache,
+                cache_path,
+                path,
+                sheet.attr("name"),
+                &formats,
+            )?;
+            state.pivots.push(PreservedPivot {
+                id: pivot.id.clone(),
+                sheet: sheet.attr("name").into(),
+                path: path.into(),
+                cache_path: cache_path.clone(),
+                cache_id: definition.attr("cacheId").into(),
+                original: pivot_signature(serde_json::to_value(&pivot).map_err(json_error)?)
+                    .to_string(),
+            });
+            workbook.pivot_tables_mut().push(pivot);
+        }
+    }
+    if !state.pivots.is_empty() {
+        for rel in rels.iter().filter(|r| {
+            r.rel_type.ends_with("/connections")
+                || r.rel_type.ends_with("/model")
+                || r.rel_type.ends_with("/slicerCache")
+                || r.rel_type.ends_with("/timelineCache")
+        }) {
+            if let Some(path) = rel.internal_path() {
+                capture_tree(package, path, &mut state.parts)?;
+            }
+            state.workbook_relationships.push(
+                Node::new("Relationship")
+                    .set("Id", &rel.id)
+                    .set("Type", &rel.rel_type)
+                    .set(
+                        "Target",
+                        rel.internal_path()
+                            .map(|p| format!("/{p}"))
+                            .unwrap_or_else(|| rel.raw_target.clone()),
+                    ),
+            );
+        }
+        if !state.sheet_relationships.is_empty()
+            || state.workbook_relationships.iter().any(|r| {
+                r.attr("Type").ends_with("/slicerCache")
+                    || r.attr("Type").ends_with("/timelineCache")
+            })
+        {
+            if let Some(ext) = pivot_controls_extension(&workbook_xml) {
+                state.workbook_extras.push(ext);
+            }
+            for pivot in workbook.pivot_tables_mut() {
+                if !pivot
+                    .unsupported_features
+                    .iter()
+                    .any(|s| s == "external-or-linked-pivot-data")
+                {
+                    pivot
+                        .unsupported_features
+                        .push("external-or-linked-pivot-data".into());
+                }
+            }
+        }
+        for path in state.parts.keys() {
+            if let Some(content_type) = package.content_type_for_path(path) {
+                state
+                    .content_types
+                    .insert(path.clone(), content_type.into());
+            }
+        }
+        duke_sheets_core::pivot_chart::discover_pivot_chart_bindings(workbook);
+        register_roundtrip(workbook, state);
+    }
+    Ok(())
+}
+
+fn json_error(error: serde_json::Error) -> XlsxError {
+    XlsxError::InvalidFormat(format!("Invalid pivot metadata: {error}"))
+}
+
+fn import_pivot<R: Read + Seek>(
+    package: &mut OpcPackage<R>,
+    workbook: &Workbook,
+    def: &Node,
+    cache: &Node,
+    cache_path: &str,
+    path: &str,
+    sheet: &str,
+    formats: &BTreeMap<usize, String>,
+) -> XlsxResult<PivotTable> {
+    let mut unsupported = Vec::new();
+    let source_node = cache.child("cacheSource");
+    if source_node.map(|n| n.attr("type")) != Some("worksheet") {
+        unsupported.push("external-data-source");
+    }
+    let worksheet = source_node.and_then(|s| s.child("worksheetSource"));
+    let mut source_sheet = worksheet.map(|n| n.attr("sheet")).unwrap_or("").to_string();
+    let mut source_range = worksheet.map(|n| n.attr("ref")).unwrap_or("").to_string();
+    let table_name = worksheet.map(|n| n.attr("name")).filter(|s| !s.is_empty());
+    if let Some(name) = table_name {
+        for ws in workbook.worksheets() {
+            if let Some(table) = ws.tables().iter().find(|t| {
+                t.name.eq_ignore_ascii_case(name) || t.display_name.eq_ignore_ascii_case(name)
+            }) {
+                source_sheet = ws.name().into();
+                source_range = table.reference.to_a1_string();
+                break;
+            }
+        }
+        if source_range.is_empty() {
+            let source = duke_sheets_core::pivot::PivotSource {
+                sheet: source_sheet.clone(),
+                range: source_range.clone(),
+                table: Some(name.into()),
+            };
+            if let Ok((index, range)) =
+                duke_sheets_core::pivot::resolve_pivot_source(workbook, &source)
+            {
+                source_sheet = workbook.worksheet(index).unwrap().name().into();
+                source_range = range.to_a1_string();
+            } else {
+                unsupported.push("unresolved-named-source");
+            }
+        }
+    }
+    if worksheet.is_some_and(|n| !n.attr("r:id").is_empty()) {
+        unsupported.push("external-workbook-source");
+    }
+    let cache_fields: Vec<_> = cache
+        .child("cacheFields")
+        .map(|n| {
+            n.children
+                .iter()
+                .filter(|c| c.local() == "cacheField")
+                .collect()
+        })
+        .unwrap_or_default();
+    let record_shared: Vec<Vec<PivotValue>> = cache_fields
+        .iter()
+        .map(|f| {
+            f.child("sharedItems")
+                .map(|n| {
+                    n.children
+                        .iter()
+                        .map(|v| cache_value(v, &[], workbook.settings().date_1904))
+                        .collect()
+                })
+                .unwrap_or_default()
+        })
+        .collect();
+    let shared: Vec<Vec<PivotValue>> = cache_fields
+        .iter()
+        .map(|f| {
+            f.child("fieldGroup")
+                .and_then(|g| g.child("groupItems"))
+                .or_else(|| f.child("sharedItems"))
+                .map(|n| {
+                    n.children
+                        .iter()
+                        .map(|v| cache_value(v, &[], workbook.settings().date_1904))
+                        .collect()
+                })
+                .unwrap_or_default()
+        })
+        .collect();
+    let mut fields = Vec::new();
+    for (index, field) in cache_fields.iter().enumerate() {
+        let data_type = if field
+            .child("sharedItems")
+            .is_some_and(|n| n.bool("containsDate", false))
+        {
+            "date"
+        } else if record_shared[index]
+            .iter()
+            .any(|v| matches!(v, PivotValue::Text(_)))
+        {
+            "text"
+        } else {
+            "number"
+        };
+        fields.push(json!({"index":index,"name":field.attr("name"),"dataType":data_type,"items":shared[index].iter().map(|v|json!({"key":v.key(),"caption":v.caption()})).collect::<Vec<_>>()}));
+    }
+    let cache_rels = package.relationships(
+        &RelationshipSource::Part(PartName::from_zip_name(cache_path)?),
+        false,
+    )?;
+    let mut records: Vec<Vec<PivotValue>> = Vec::new();
+    if let Some(records_path) = cache_rels
+        .iter()
+        .find(|r| r.rel_type.ends_with("/pivotCacheRecords"))
+        .and_then(|r| r.internal_path())
+    {
+        let records_xml = parse(&read_part(package, records_path)?)?;
+        for record in records_xml.all("r") {
+            records.push(
+                record
+                    .children
+                    .iter()
+                    .enumerate()
+                    .map(|(i, n)| {
+                        cache_value(
+                            n,
+                            record_shared.get(i).map(Vec::as_slice).unwrap_or(&[]),
+                            workbook.settings().date_1904,
+                        )
+                    })
+                    .collect(),
+            );
+        }
+    }
+    for (index, field) in fields.iter_mut().enumerate() {
+        let mut keys = HashSet::new();
+        let mut members = Vec::new();
+        for value in record_shared[index]
+            .iter()
+            .chain(records.iter().filter_map(|r| r.get(index)))
+        {
+            if keys.insert(value.key()) {
+                members.push(json!({"key":value.key(),"caption":value.caption()}));
+            }
+        }
+        field["items"] = json!(members);
+    }
+    let pivot_fields: Vec<_> = def
+        .child("pivotFields")
+        .map(|n| {
+            n.children
+                .iter()
+                .filter(|c| c.local() == "pivotField")
+                .collect()
+        })
+        .unwrap_or_default();
+    let axis = |name: &str| -> Vec<Value> {
+        def.child(name).into_iter().flat_map(|n|n.all("field")).filter_map(|f| {
+            let index = f.attr("x").parse::<usize>().ok()?;
+            let pf = pivot_fields.get(index).copied();
+            let collapsed: Vec<_> = pf.and_then(|p|p.child("items")).into_iter().flat_map(|n|n.all("item")).filter(|i|!i.bool("sd",true)).filter_map(|i|shared.get(index)?.get(i.num("x")).map(PivotValue::key)).collect();
+            Some(json!({"field":index,"sort":pf.map(|p|p.attr("sortType")).filter(|s|!s.is_empty()).unwrap_or("manual"),"subtotals":pf.map(|p|p.bool("defaultSubtotal",true)).unwrap_or(true),"collapsed":collapsed}))
+        }).collect()
+    };
+    let mut rows = axis("rowFields");
+    let mut columns = axis("colFields");
+    let mut filters = Vec::new();
+    for (index, pf) in pivot_fields.iter().enumerate() {
+        if let Some(items) = pf.child("items") {
+            if items.all("item").any(|i| i.bool("h", false)) {
+                let values: Vec<_> = items
+                    .all("item")
+                    .filter(|i| {
+                        !i.bool("h", false) && (i.attr("t").is_empty() || i.attr("t") == "data")
+                    })
+                    .filter_map(|i| shared.get(index)?.get(i.num("x")).map(PivotValue::key))
+                    .collect();
+                filters.push(json!({"field":index,"kind":"members","values":values}));
+            }
+        }
+    }
+    let report_filters: Vec<_> = def
+        .child("pageFields")
+        .into_iter()
+        .flat_map(|n| n.all("pageField"))
+        .map(|f| f.num("fld"))
+        .collect();
+    for page in def
+        .child("pageFields")
+        .into_iter()
+        .flat_map(|n| n.all("pageField"))
+    {
+        if let Ok(item) = page.attr("item").parse::<usize>() {
+            let field = page.num("fld");
+            let member = pivot_fields
+                .get(field)
+                .and_then(|p| p.child("items"))
+                .and_then(|n| n.children.get(item))
+                .and_then(|i| shared.get(field)?.get(i.num("x")));
+            if let Some(member) = member {
+                filters.retain(|f| f["field"] != json!(field));
+                filters.push(json!({"field":field,"kind":"members","values":[member.key()]}));
+            }
+        }
+    }
+    let mut values = Vec::new();
+    for data in def
+        .child("dataFields")
+        .into_iter()
+        .flat_map(|n| n.all("dataField"))
+    {
+        let field = data.num("fld");
+        let base_field = data.attr("baseField").parse::<usize>().ok();
+        let base_item = data.attr("baseItem").parse::<usize>().ok().and_then(|i| {
+            if i == 1048828 {
+                Some("previous".into())
+            } else if i == 1048829 {
+                Some("next".into())
+            } else {
+                shared.get(base_field?)?.get(i).map(PivotValue::key)
+            }
+        });
+        let formula = cache_fields
+            .get(field)
+            .map(|c| c.attr("formula"))
+            .filter(|s| !s.is_empty());
+        values.push(json!({"field":field,"name":data.attr("name"),"aggregation":if data.attr("subtotal").is_empty(){"sum"}else{data.attr("subtotal")},"showAs":import_show_as(data),"baseField":base_field,"baseItem":base_item,"numberFormat":numeric_format(formats,data.num("numFmtId")),"formula":formula,"sourceName":cache_fields.get(field).map(|c|c.attr("name"))}));
+    }
+    let location = def.child("location").map(|n| n.attr("ref")).unwrap_or("A1");
+    let layout = if def.bool("compact", true) {
+        "compact"
+    } else if def.bool("outline", false) {
+        "outline"
+    } else {
+        "tabular"
+    };
+    let subtotals_position = if pivot_fields.iter().any(|p| !p.bool("subtotalTop", true)) {
+        "bottom"
+    } else {
+        "top"
+    };
+    let mut calculated_items = Vec::new();
+    for item in cache
+        .child("calculatedItems")
+        .into_iter()
+        .flat_map(|n| n.all("calculatedItem"))
+    {
+        let references: Vec<_> = item
+            .child("pivotArea")
+            .and_then(|n| n.child("references"))
+            .into_iter()
+            .flat_map(|n| n.all("reference"))
+            .collect();
+        let field = item
+            .attr("field")
+            .parse::<usize>()
+            .ok()
+            .or_else(|| references.first().map(|r| r.num("field")))
+            .unwrap_or(0);
+        let target = references
+            .iter()
+            .find(|r| r.num("field") == field)
+            .and_then(|r| r.child("x"))
+            .and_then(|x| shared.get(field)?.get(x.num("v")));
+        if references.len() == 1 {
+            if let Some(target) = target {
+                calculated_items.push(
+                    json!({"field":field,"name":target.caption(),"formula":item.attr("formula")}),
+                );
+                continue;
+            }
+        }
+        unsupported.push("scoped-calculated-item");
+    }
+    let source_indices: Vec<_> = cache_fields
+        .iter()
+        .enumerate()
+        .filter(|(_, f)| f.bool("databaseField", true))
+        .map(|(i, _)| i)
+        .collect();
+    let source_map: HashMap<usize, usize> = source_indices
+        .iter()
+        .enumerate()
+        .map(|(next, old)| (*old, next))
+        .collect();
+
+    for axis in rows.iter_mut().chain(columns.iter_mut()) {
+        let index = axis["field"].as_u64().unwrap_or(0) as usize;
+        let field = cache_fields.get(index).copied();
+        let group = field
+            .and_then(|f| f.child("fieldGroup"))
+            .filter(|g| g.child("rangePr").is_some() || g.child("discretePr").is_some());
+        let base = group.map(|g| g.num("base")).unwrap_or(index);
+        if let Some(mapped) = source_map.get(&base) {
+            axis["field"] = json!(mapped);
+        } else {
+            unsupported.push("unresolved-group-source");
+        }
+
+        if group.is_some() {
+            axis["name"] = json!(field.map(|f| f.attr("name")));
+        }
+        if let Some(group) = group {
+            if let Some(range) = group.child("rangePr") {
+                let kind = if range.attr("groupBy") == "range" {
+                    "number"
+                } else {
+                    "date"
+                };
+                let start = if kind == "number" {
+                    range.attr("startNum").parse::<f64>().ok()
+                } else {
+                    date_serial(range.attr("startDate"), workbook.settings().date_1904)
+                };
+                let end = if kind == "number" {
+                    range.attr("endNum").parse::<f64>().ok()
+                } else {
+                    date_serial(range.attr("endDate"), workbook.settings().date_1904)
+                };
+                axis["grouping"] = json!({"kind":kind,"unit":range.attr("groupBy"),"interval":range.attr("groupInterval").parse::<f64>().unwrap_or(1.0),"start":if range.bool("autoStart",true){None}else{start},"end":if range.bool("autoEnd",true){None}else{end}});
+            } else if let Some(discrete) = group.child("discretePr") {
+                let mut groups: BTreeMap<String, Vec<String>> = BTreeMap::new();
+                for (i, item) in discrete.all("x").enumerate() {
+                    if let (Some(source), Some(target)) = (
+                        shared.get(base).and_then(|s| s.get(i)),
+                        shared.get(index).and_then(|s| s.get(item.num("v"))),
+                    ) {
+                        groups
+                            .entry(target.caption())
+                            .or_default()
+                            .push(source.key());
+                    }
+                }
+                axis["grouping"] = json!({"kind":"manual","groups":groups.into_iter().map(|(name,members)|json!({"name":name,"members":members})).collect::<Vec<_>>()});
+            } else {
+                unsupported.push("unsupported-field-group");
+            }
+        }
+        let pf = pivot_fields.get(index).copied();
+        if let Some(pf) = pf {
+            axis["subtotalFunctions"] = json!(SUBTOTALS
+                .iter()
+                .filter(|(_, attr)| pf.bool(attr, false))
+                .map(|(name, _)| *name)
+                .collect::<Vec<_>>());
+            axis["showItemsWithNoData"] = json!(pf.bool("showAll", true));
+            if let Some(scope) = pf
+                .child("autoSortScope")
+                .and_then(|n| n.child("pivotArea"))
+                .and_then(|n| n.child("references"))
+            {
+                if let Some(measure) = scope
+                    .all("reference")
+                    .find(|n| n.attr("field") == "4294967294" || n.attr("field") == "-2")
+                    .and_then(|n| n.child("x"))
+                {
+                    axis["sortMeasure"] = json!(measure.num("v"));
+                    axis["sort"] = json!(if pf.attr("sortType") == "descending" {
+                        "valueDescending"
+                    } else {
+                        "valueAscending"
+                    });
+                }
+            }
+        }
+    }
+    import_filters(def, &mut filters, &mut unsupported);
+    for filter in &mut filters {
+        if let Some(index) = filter["field"].as_u64() {
+            let old = index as usize;
+            let group = cache_fields
+                .get(old)
+                .and_then(|f| f.child("fieldGroup"))
+                .filter(|g| g.child("rangePr").is_some() || g.child("discretePr").is_some());
+            let base = group.map(|g| g.num("base")).unwrap_or(old);
+            if let Some(mapped) = source_map.get(&base) {
+                filter["field"] = json!(mapped);
+            }
+            filter["groupingUnit"] = json!(group.map(|g| g
+                .child("rangePr")
+                .map(|r| if r.attr("groupBy") == "range" {
+                    "number"
+                } else {
+                    r.attr("groupBy")
+                })
+                .unwrap_or("manual")));
+        }
+    }
+    for value in &mut values {
+        let old = value["field"].as_u64().unwrap_or(0) as usize;
+        value["field"] = json!(source_map.get(&old).copied().unwrap_or(0));
+        if let Some(base) = value["baseField"].as_u64() {
+            let old = base as usize;
+            let group = cache_fields
+                .get(old)
+                .and_then(|f| f.child("fieldGroup"))
+                .filter(|g| g.child("rangePr").is_some() || g.child("discretePr").is_some());
+            let base = group.map(|g| g.num("base")).unwrap_or(old);
+            value["baseField"] = json!(source_map.get(&base));
+            value["baseGroupingUnit"] = json!(group.map(|g| g
+                .child("rangePr")
+                .map(|r| if r.attr("groupBy") == "range" {
+                    "number"
+                } else {
+                    r.attr("groupBy")
+                })
+                .unwrap_or("manual")));
+        }
+    }
+    for item in &mut calculated_items {
+        if let Some(index) = item["field"].as_u64() {
+            item["field"] = json!(source_map.get(&(index as usize)).copied().unwrap_or(0));
+        }
+    }
+    let report_filters: Vec<_> = report_filters
+        .into_iter()
+        .filter_map(|i| source_map.get(&i).copied())
+        .collect();
+    let fields: Vec<_> = source_indices
+        .iter()
+        .enumerate()
+        .map(|(index, old)| {
+            let mut field = fields[*old].clone();
+            field["index"] = json!(index);
+            field
+        })
+        .collect();
+    let records: Vec<Vec<PivotValue>> = records
+        .into_iter()
+        .map(|row| {
+            source_indices
+                .iter()
+                .map(|i| row.get(*i).cloned().unwrap_or_default())
+                .collect()
+        })
+        .collect();
+
+    if def.child("pivotHierarchies").is_some() {
+        unsupported.push("pivot-hierarchies");
+    }
+    let mut pivot: PivotTable = serde_json::from_value(json!({
+        "id":format!("import:{path}"),"name":def.attr("name"),"source":{"sheet":source_sheet,"range":source_range,"table":table_name},
+        "target":{"sheet":sheet,"cell":location.split(':').next().unwrap_or("A1")},"rows":rows,"columns":columns,
+        "filters":filters,"reportFilters":report_filters,"values":values,"layout":layout,"valuesOnRows":def.bool("dataOnRows",false),"repeatLabels":pivot_fields.iter().any(|p|p.child("extLst").into_iter().flat_map(|n|n.all("ext")).flat_map(|n|n.children.iter()).any(|n|n.local()=="pivotField"&&n.bool("fillDownLabels",false))),
+        "rowGrandTotals":def.bool("rowGrandTotals",true),"columnGrandTotals":def.bool("colGrandTotals",true),"subtotalsPosition":subtotals_position,
+        "preserveFormatting":def.bool("preserveFormatting",true),"styleName":def.child("pivotTableStyleInfo").map(|n|n.attr("name")).unwrap_or("PivotStyleLight16"),"fields":fields,"outputRange":location,
+        "unsupportedFeatures":unsupported,"refreshOnLoad":cache.bool("refreshOnLoad",false),"dirty":false,"cache":records,"calculatedItems":calculated_items
+    })).map_err(json_error)?;
+    hydrate_output(&mut pivot, def, &shared, workbook);
+    Ok(pivot)
+}
+
+fn import_filters(def: &Node, filters: &mut Vec<Value>, unsupported: &mut Vec<&'static str>) {
+    for filter in def
+        .child("filters")
+        .into_iter()
+        .flat_map(|n| n.all("filter"))
+    {
+        let field = filter.num("fld");
+        let kind = filter.attr("type");
+        let column = filter
+            .child("autoFilter")
+            .and_then(|n| n.child("filterColumn"));
+        if let Some(top) = column.and_then(|n| n.child("top10")) {
+            filters.push(json!({"field":field,"kind":"top10","measure":filter.num("iMeasureFld"),"top":top.bool("top",true),"count":top.attr("val").parse::<f64>().unwrap_or(10.0),"percent":top.bool("percent",false)}));
+        } else if kind.starts_with("caption") || kind.starts_with("value") {
+            let operator = match kind
+                .trim_start_matches("caption")
+                .trim_start_matches("value")
+            {
+                "Equal" => "equal",
+                "NotEqual" => "notEqual",
+                "BeginsWith" => "beginsWith",
+                "NotBeginsWith" => "notBeginsWith",
+                "EndsWith" => "endsWith",
+                "NotEndsWith" => "notEndsWith",
+                "Contains" => "contains",
+                "NotContains" | "DoesNotContain" => "notContains",
+                "GreaterThan" => "greaterThan",
+                "GreaterThanOrEqual" => "greaterThanOrEqual",
+                "LessThan" => "lessThan",
+                "LessThanOrEqual" => "lessThanOrEqual",
+                "Between" => "between",
+                "NotBetween" => "notBetween",
+                _ => {
+                    unsupported.push("pivot-filter-operator");
+                    continue;
+                }
+            };
+            let customs: Vec<_> = column
+                .and_then(|n| n.child("customFilters"))
+                .into_iter()
+                .flat_map(|n| n.all("customFilter"))
+                .collect();
+            filters.push(json!({"field":field,"kind":if kind.starts_with("caption"){"label"}else{"value"},"operator":operator,"value":if kind.starts_with("caption"){filter.attr("stringValue1")}else{customs.first().map(|n|n.attr("val")).unwrap_or("")},"value2":if kind.starts_with("caption"){filter.attr("stringValue2")}else{customs.get(1).map(|n|n.attr("val")).unwrap_or("")},"measure":filter.num("iMeasureFld")}));
+        } else {
+            unsupported.push("pivot-filter-type");
+        }
+    }
+}
+
+fn relationship_root() -> Node {
+    Node::new("Relationships").set("xmlns", PKG_REL)
+}
+fn relationships_path(path: &str) -> String {
+    let (parent, name) = path.rsplit_once('/').unwrap_or(("", path));
+    if parent.is_empty() {
+        format!("_rels/{name}.rels")
+    } else {
+        format!("{parent}/_rels/{name}.rels")
+    }
+}
+fn add_relationship(
+    archive: &mut BTreeMap<String, Vec<u8>>,
+    owner: &str,
+    id_prefix: &str,
+    kind: &str,
+    target: &str,
+) -> XlsxResult<String> {
+    let path = relationships_path(owner);
+    let mut root = archive
+        .get(&path)
+        .map(|bytes| parse(bytes))
+        .transpose()?
+        .unwrap_or_else(relationship_root);
+    let ids: HashSet<_> = root
+        .all("Relationship")
+        .map(|n| n.attr("Id").to_owned())
+        .collect();
+    let mut count = 1;
+    while ids.contains(&format!("{id_prefix}{count}")) {
+        count += 1;
+    }
+    let id = format!("{id_prefix}{count}");
+    root.push(
+        Node::new("Relationship")
+            .set("Id", &id)
+            .set("Type", format!("{REL}/{kind}"))
+            .set("Target", target),
+    );
+    archive.insert(path, root.bytes()?);
+    Ok(id)
+}
+fn add_content_type(types: &mut Node, path: &str, content_type: &str) {
+    let part_name = format!("/{}", path.trim_start_matches('/'));
+    types
+        .children
+        .retain(|n| n.local() != "Override" || n.attr("PartName") != part_name);
+    types.push(
+        Node::new("Override")
+            .set("PartName", part_name)
+            .set("ContentType", content_type),
+    );
+}
+fn put_part(
+    archive: &mut BTreeMap<String, Vec<u8>>,
+    types: &mut Node,
+    path: &str,
+    node: &Node,
+    kind: &str,
+) -> XlsxResult<()> {
+    archive.insert(path.into(), node.bytes()?);
+    add_content_type(types, path, &format!("{CT_PREFIX}{kind}+xml"));
+    Ok(())
+}
+fn value_node(value: &PivotValue) -> Node {
+    match value {
+        PivotValue::Blank => Node::new("m"),
+        PivotValue::Number(v) => Node::new("n").set("v", v),
+        PivotValue::Text(v) => Node::new("s").set("v", v),
+        PivotValue::Boolean(v) => Node::new("b").set("v", u8::from(*v)),
+        PivotValue::Error(v) => Node::new("e").set("v", v),
+    }
+}
+fn attr_bool(node: Node, key: &str, value: bool) -> Node {
+    node.set(key, u8::from(value))
+}
+fn pivot_signature(mut value: Value) -> Value {
+    if let Some(o) = value.as_object_mut() {
+        for key in ["dirty", "output", "headers", "preservedParts", "charts"] {
+            o.remove(key);
+        }
+    }
+    value
+}
+fn stable_ids(
+    pivot: &PivotTable,
+    preserved: Option<&PreservedPivot>,
+    reserved: &mut HashSet<String>,
+    next: &mut usize,
+) -> (String, String, String) {
+    if let Some(preserved) = preserved {
+        if reserved.insert(preserved.cache_id.clone()) {
+            return (
+                preserved.path.clone(),
+                preserved.cache_path.clone(),
+                preserved.cache_id.clone(),
+            );
+        }
+    }
+    while reserved.contains(&next.to_string()) {
+        *next += 1;
+    }
+    let id = next.to_string();
+    reserved.insert(id.clone());
+    *next += 1;
+    let suffix = next.to_string();
+    let _ = pivot;
+    (
+        format!("xl/pivotTables/pivotTableRx{suffix}.xml"),
+        format!("xl/pivotCache/pivotCacheDefinitionRx{suffix}.xml"),
+        id,
+    )
+}
+
+pub(crate) fn write_pivots(workbook: &Workbook, bytes: Vec<u8>) -> XlsxResult<Vec<u8>> {
+    let mut zip = zip::ZipArchive::new(Cursor::new(bytes))?;
+    let mut archive = BTreeMap::new();
+    for i in 0..zip.len() {
+        let mut entry = zip.by_index(i)?;
+        if entry.is_dir() {
+            continue;
+        }
+        let name = entry.name().to_owned();
+        let mut data = Vec::new();
+        entry.read_to_end(&mut data)?;
+        archive.insert(name, data);
+    }
+    let state = roundtrip_for(workbook).unwrap_or_default();
+    if let Some(reason) = &state.unreadable {
+        return Err(XlsxError::InvalidFormat(format!(
+            "Cannot safely export unreadable pivot metadata: {reason}"
+        )));
+    }
+    let mut types = archive
+        .get("[Content_Types].xml")
+        .map(|b| parse(b))
+        .transpose()?
+        .unwrap_or_else(|| Node::new("Types").set("xmlns", TYPES));
+    let mut wb = parse(
+        archive
+            .get("xl/workbook.xml")
+            .ok_or_else(|| XlsxError::MissingPart("xl/workbook.xml".into()))?,
+    )?;
+    let mut caches = Node::new("pivotCaches");
+    let mut reserved: HashSet<String> = state.pivots.iter().map(|p| p.cache_id.clone()).collect();
+    let mut next = 1usize;
+    let mut attached_caches = HashSet::new();
+
+    let mut preserved_workbook_dependencies = false;
+    for pivot in workbook.pivot_tables() {
+        let Some(sheet_index) = workbook
+            .worksheets()
+            .position(|s| s.name().eq_ignore_ascii_case(&pivot.target.sheet))
+        else {
+            return Err(XlsxError::InvalidFormat(
+                "Pivot destination worksheet is missing".into(),
+            ));
+        };
+        let old = state.pivots.iter().find(|p| p.id == pivot.id);
+        let unchanged = old.is_some_and(|p| {
+            !pivot.dirty
+                && p.original
+                    == pivot_signature(serde_json::to_value(pivot).unwrap_or(Value::Null))
+                        .to_string()
+        });
+        if !pivot.unsupported_features.is_empty() && old.is_none() {
+            return Err(XlsxError::InvalidFormat(
+                "Cannot export an unsupported pivot without its original package parts".into(),
+            ));
+        }
+        let reuse = unchanged || !pivot.unsupported_features.is_empty();
+        let (path, cache_path, cache_id) = if reuse {
+            let p = old.unwrap();
+            (p.path.clone(), p.cache_path.clone(), p.cache_id.clone())
+        } else {
+            stable_ids(pivot, None, &mut reserved, &mut next)
+        };
+        if reuse {
+            let preserved = old.unwrap();
+            for (part, data) in &state.parts {
+                if !archive.contains_key(part) {
+                    archive.insert(part.clone(), data.clone());
+                }
+                if let Some(content_type) = state.content_types.get(part) {
+                    add_content_type(&mut types, part, content_type);
+                }
+            }
+            let mut def = parse(
+                state
+                    .parts
+                    .get(&preserved.path)
+                    .ok_or_else(|| XlsxError::MissingPart(preserved.path.clone()))?,
+            )?;
+            def.attrs.insert("cacheId".into(), cache_id.clone());
+            archive.insert(path.clone(), def.bytes()?);
+            if !state.workbook_relationships.is_empty() {
+                preserved_workbook_dependencies = true;
+            }
+        } else {
+            write_generated_pivot(
+                workbook,
+                pivot,
+                &path,
+                &cache_path,
+                &cache_id,
+                &mut archive,
+                &mut types,
+            )?;
+        }
+        if attached_caches.insert(cache_id.clone()) {
+            let cache_rid = add_relationship(
+                &mut archive,
+                "xl/workbook.xml",
+                "rIdPivotCache",
+                "pivotCacheDefinition",
+                &format!("/{cache_path}"),
+            )?;
+            caches.push(
+                Node::new("pivotCache")
+                    .set("cacheId", &cache_id)
+                    .set("r:id", cache_rid),
+            );
+        }
+        let sheet_path = format!("xl/worksheets/sheet{}.xml", sheet_index + 1);
+        add_relationship(
+            &mut archive,
+            &sheet_path,
+            "rIdPivot",
+            "pivotTable",
+            &format!("/{path}"),
+        )?;
+        add_content_type(&mut types, &path, &format!("{CT_PREFIX}pivotTable+xml"));
+        add_content_type(
+            &mut types,
+            &cache_path,
+            &format!("{CT_PREFIX}pivotCacheDefinition+xml"),
+        );
+    }
+    wb.remove("pivotCaches");
+    let before = wb
+        .children
+        .iter()
+        .position(|n| {
+            [
+                "smartTagPr",
+                "smartTagTypes",
+                "webPublishing",
+                "fileRecoveryPr",
+                "webPublishObjects",
+                "extLst",
+            ]
+            .contains(&n.local())
+        })
+        .unwrap_or(wb.children.len());
+    wb.children.insert(before, caches);
+    if preserved_workbook_dependencies {
+        let path = relationships_path("xl/workbook.xml");
+        let mut rels = parse(archive.get(&path).unwrap())?;
+        let mut mappings = HashMap::new();
+        for (index, original) in state.workbook_relationships.iter().enumerate() {
+            let mut next = original.clone();
+            let mut id = format!("rIdPivotDependency{}", index + 1);
+            while rels.all("Relationship").any(|r| r.attr("Id") == id) {
+                id.push('_');
+            }
+            mappings.insert(original.attr("Id").to_owned(), id.clone());
+            next.attrs.insert("Id".into(), id);
+            rels.push(next);
+        }
+        archive.insert(path, rels.bytes()?);
+        for node in &state.workbook_extras {
+            let mut node = node.clone();
+            remap_relationship_ids(&mut node, &mappings);
+            wb.replace(node);
+        }
+    }
+    for (sheet_name, originals) in &state.sheet_relationships {
+        let Some(index) = workbook.worksheets().position(|s| s.name() == sheet_name) else {
+            continue;
+        };
+        let owner = format!("xl/worksheets/sheet{}.xml", index + 1);
+        let path = relationships_path(&owner);
+        let mut rels = archive
+            .get(&path)
+            .map(|b| parse(b))
+            .transpose()?
+            .unwrap_or_else(relationship_root);
+        let mut mappings = HashMap::new();
+        for (index, original) in originals.iter().enumerate() {
+            let mut next = original.clone();
+            let mut id = format!("rIdPivotControl{}", index + 1);
+            while rels.all("Relationship").any(|r| r.attr("Id") == id) {
+                id.push('_');
+            }
+            mappings.insert(original.attr("Id").into(), id.clone());
+            next.attrs.insert("Id".into(), id);
+            rels.push(next);
+        }
+        archive.insert(path, rels.bytes()?);
+        if let Some(ext) = state.sheet_extras.get(sheet_name) {
+            let mut sheet = parse(archive.get(&owner).unwrap())?;
+            let mut ext = ext.clone();
+            remap_relationship_ids(&mut ext, &mappings);
+            for (name, value) in &ext.attrs {
+                if name.starts_with("xmlns:") {
+                    sheet.attrs.insert(name.clone(), value.clone());
+                }
+            }
+            sheet.replace(ext);
+            archive.insert(owner, sheet.bytes()?);
+        }
+    }
+    archive.insert("xl/workbook.xml".into(), wb.bytes()?);
+    archive.insert("[Content_Types].xml".into(), types.bytes()?);
+    let mut output = zip::ZipWriter::new(Cursor::new(Vec::new()));
+    for (path, data) in archive {
+        output.start_file(
+            path,
+            zip::write::SimpleFileOptions::default()
+                .compression_method(zip::CompressionMethod::Deflated),
+        )?;
+        output.write_all(&data)?;
+    }
+    Ok(output.finish()?.into_inner())
+}
+
+struct CachePlan {
+    fields: Vec<Node>,
+    shared: Vec<Vec<PivotValue>>,
+    record_shared: Vec<Vec<PivotValue>>,
+    axes: HashMap<(usize, String), usize>,
+    measures: Vec<usize>,
+}
+fn axis_unit(axis: &PivotAxisField) -> String {
+    axis.grouping
+        .as_ref()
+        .map(|g| {
+            if g.kind == "date" {
+                g.unit.clone()
+            } else {
+                g.kind.clone()
+            }
+        })
+        .unwrap_or_default()
+}
+impl CachePlan {
+    fn axis_index(&self, axis: &PivotAxisField) -> usize {
+        self.axes
+            .get(&(axis.field, axis_unit(axis)))
+            .copied()
+            .unwrap_or(axis.field)
+    }
+    fn field_index(&self, field: usize, unit: Option<&str>) -> usize {
+        unit.and_then(|u| self.axes.get(&(field, u.into())))
+            .copied()
+            .unwrap_or_else(|| {
+                self.axes
+                    .iter()
+                    .filter(|((f, _), _)| *f == field)
+                    .map(|(_, i)| *i)
+                    .min()
+                    .unwrap_or(field)
+            })
+    }
+}
+fn build_cache(pivot: &PivotTable, date1904: bool) -> CachePlan {
+    let mut shared: Vec<Vec<PivotValue>> = pivot
+        .fields
+        .iter()
+        .map(|f| {
+            f.items
+                .iter()
+                .map(|m| PivotValue::from_key(&m.key))
+                .collect()
+        })
+        .collect();
+    for item in &pivot.calculated_items {
+        if let Some(items) = shared.get_mut(item.field) {
+            let value = PivotValue::Text(item.name.clone());
+            if !items.iter().any(|v| v.key() == value.key()) {
+                items.push(value);
+            }
+        }
+    }
+    for record in &pivot.cache {
+        for (i, value) in record.iter().enumerate() {
+            if let Some(items) = shared.get_mut(i) {
+                if !items.iter().any(|v| v.key() == value.key()) {
+                    items.push(value.clone());
+                }
+            }
+        }
+    }
+    let mut fields = Vec::new();
+    for (i, field) in pivot.fields.iter().enumerate() {
+        let items = &shared[i];
+        let mut shared_items = Node::new("sharedItems").set("count", items.len());
+        for (key, value) in [
+            (
+                "containsBlank",
+                items.iter().any(|v| matches!(v, PivotValue::Blank)),
+            ),
+            (
+                "containsString",
+                items.iter().any(|v| {
+                    matches!(
+                        v,
+                        PivotValue::Text(_) | PivotValue::Boolean(_) | PivotValue::Error(_)
+                    )
+                }),
+            ),
+            (
+                "containsNumber",
+                items.iter().any(|v| matches!(v, PivotValue::Number(_))),
+            ),
+            (
+                "containsInteger",
+                items
+                    .iter()
+                    .all(|v| !matches!(v,PivotValue::Number(n) if n.fract()!=0.0)),
+            ),
+        ] {
+            shared_items = attr_bool(shared_items, key, value);
+        }
+        if !items.iter().any(|v| matches!(v, PivotValue::Number(_))) {
+            shared_items.attrs.remove("containsInteger");
+        }
+        shared_items = attr_bool(
+            shared_items,
+            "containsSemiMixedTypes",
+            items.iter().any(|v| {
+                matches!(
+                    v,
+                    PivotValue::Text(_)
+                        | PivotValue::Blank
+                        | PivotValue::Boolean(_)
+                        | PivotValue::Error(_)
+                )
+            }),
+        );
+        shared_items = attr_bool(
+            shared_items,
+            "containsMixedTypes",
+            items.iter().any(|v| {
+                matches!(
+                    v,
+                    PivotValue::Text(_) | PivotValue::Boolean(_) | PivotValue::Error(_)
+                )
+            }) && items.iter().any(|v| matches!(v, PivotValue::Number(_))),
+        );
+        for item in items {
+            let mut node = value_node(item);
+            if pivot
+                .calculated_items
+                .iter()
+                .any(|c| c.field == i && c.name == item.caption())
+            {
+                node = node.set("f", 1);
+            }
+            shared_items.push(node);
+        }
+        let mut f = Node::new("cacheField")
+            .set("name", &field.name)
+            .set("numFmtId", 0);
+        f.push(shared_items);
+        fields.push(f);
+    }
+    let record_shared = shared.clone();
+    let mut axes = HashMap::new();
+    let grouped_axes: Vec<_> = pivot.rows.iter().chain(&pivot.columns).collect();
+    for axis in &grouped_axes {
+        axes.insert((axis.field, axis_unit(axis)), axis.field);
+        let Some(group) = &axis.grouping else {
+            continue;
+        };
+        let raw = &record_shared[axis.field];
+        let numbers: Vec<_> = raw
+            .iter()
+            .filter_map(|v| {
+                if let PivotValue::Number(n) = v {
+                    Some(*n)
+                } else {
+                    None
+                }
+            })
+            .collect();
+        let start = group
+            .start
+            .unwrap_or_else(|| numbers.iter().copied().reduce(f64::min).unwrap_or(0.0));
+        let end = group
+            .end
+            .unwrap_or_else(|| {
+                numbers
+                    .iter()
+                    .copied()
+                    .reduce(f64::max)
+                    .unwrap_or(start + 1.0)
+            })
+            .max(start + f64::EPSILON);
+        let mut items: Vec<PivotValue> = axis
+            .items
+            .iter()
+            .map(|m| PivotValue::from_key(&m.key))
+            .collect();
+        let level = pivot
+            .rows
+            .iter()
+            .position(|a| a.field == axis.field && axis_unit(a) == axis_unit(axis))
+            .map(|i| (true, i))
+            .or_else(|| {
+                pivot
+                    .columns
+                    .iter()
+                    .position(|a| a.field == axis.field && axis_unit(a) == axis_unit(axis))
+                    .map(|i| (false, i))
+            });
+        if let Some((row, index)) = level {
+            for cell in &pivot.output {
+                if let Some(key) = if row {
+                    cell.row_keys.get(index)
+                } else {
+                    cell.column_keys.get(index)
+                } {
+                    let value = PivotValue::from_key(key);
+                    if !items.iter().any(|v| v.key() == *key) {
+                        items.push(value);
+                    }
+                }
+            }
+        }
+        let mut field_group = Node::new("fieldGroup").set("base", axis.field);
+        if group.kind == "manual" {
+            let mut discrete = Node::new("discretePr").set("count", raw.len());
+            for value in raw {
+                let grouped = group
+                    .groups
+                    .iter()
+                    .find(|g| g.members.contains(&value.key()))
+                    .map(|g| PivotValue::Text(g.name.clone()))
+                    .unwrap_or_else(|| value.clone());
+                let idx = items
+                    .iter()
+                    .position(|v| v.key() == grouped.key())
+                    .unwrap_or_else(|| {
+                        items.push(grouped);
+                        items.len() - 1
+                    });
+                discrete.push(Node::new("x").set("v", idx));
+            }
+            field_group.push(discrete);
+        } else {
+            let mut range = Node::new("rangePr")
+                .set(
+                    "groupBy",
+                    if group.kind == "number" {
+                        "range"
+                    } else {
+                        group.unit.as_str()
+                    },
+                )
+                .set("groupInterval", group.interval.max(1.0));
+            range = attr_bool(
+                attr_bool(range, "autoStart", group.start.is_none()),
+                "autoEnd",
+                group.end.is_none(),
+            );
+            if group.kind == "number" {
+                range = range.set("startNum", start).set("endNum", end);
+            } else {
+                range = range
+                    .set("startDate", serial_date(start, date1904))
+                    .set("endDate", serial_date(end.max(start + 1.0), date1904));
+            }
+            items = range_group_items(axis, start, end, date1904, &items);
+            field_group.push(range);
+        }
+        let mut group_items = Node::new("groupItems").set("count", items.len());
+        for item in &items {
+            group_items.push(value_node(item));
+        }
+        field_group.push(group_items);
+        let use_base = group.kind == "number"
+            || (group.kind == "date"
+                && grouped_axes
+                    .iter()
+                    .filter(|a| a.field == axis.field)
+                    .filter_map(|a| a.grouping.as_ref())
+                    .filter(|g| g.kind == "date")
+                    .all(|g| date_unit_rank(&g.unit) >= date_unit_rank(&group.unit)));
+        if use_base {
+            if let Some(source) = fields.get_mut(axis.field) {
+                source.push(field_group);
+                if group.kind == "date" {
+                    if let Some(shared_items) = source
+                        .children
+                        .iter_mut()
+                        .find(|n| n.local() == "sharedItems")
+                    {
+                        shared_items.attrs.remove("containsInteger");
+                        shared_items
+                            .attrs
+                            .insert("containsNumber".into(), "0".into());
+                        shared_items.attrs.insert("containsDate".into(), "1".into());
+                        shared_items
+                            .attrs
+                            .insert("containsNonDate".into(), "0".into());
+                        shared_items
+                            .attrs
+                            .insert("containsString".into(), "0".into());
+                        shared_items
+                            .attrs
+                            .insert("containsSemiMixedTypes".into(), "0".into());
+                        shared_items
+                            .attrs
+                            .insert("containsMixedTypes".into(), "0".into());
+                        shared_items.children = raw
+                            .iter()
+                            .map(|v| {
+                                if let PivotValue::Number(n) = v {
+                                    Node::new("d").set("v", serial_date(*n, date1904))
+                                } else {
+                                    value_node(v)
+                                }
+                            })
+                            .collect();
+                    }
+                }
+            }
+            shared[axis.field] = items;
+            axes.insert((axis.field, axis_unit(axis)), axis.field);
+        } else {
+            let index = fields.len();
+            let mut field = Node::new("cacheField")
+                .set(
+                    "name",
+                    axis.name.clone().unwrap_or_else(|| {
+                        format!("{} ({})", pivot.fields[axis.field].name, axis_unit(axis))
+                    }),
+                )
+                .set("databaseField", 0);
+            field.push(
+                Node::new("sharedItems")
+                    .set("count", 0)
+                    .set("containsString", 0)
+                    .set("containsMixedTypes", 0)
+                    .set("containsBlank", 0),
+            );
+            field.push(field_group);
+            fields.push(field);
+            shared.push(items);
+            axes.insert((axis.field, axis_unit(axis)), index);
+        }
+    }
+    for axis in &grouped_axes {
+        if let Some(group) = &axis.grouping {
+            let own = axes
+                .get(&(axis.field, axis_unit(axis)))
+                .copied()
+                .unwrap_or(axis.field);
+            let parent = if group.kind == "manual" {
+                Some((axis.field, own))
+            } else if group.kind == "date" {
+                grouped_axes
+                    .iter()
+                    .filter(|a| a.field == axis.field)
+                    .filter_map(|a| {
+                        a.grouping
+                            .as_ref()
+                            .filter(|g| {
+                                g.kind == "date"
+                                    && date_unit_rank(&g.unit) > date_unit_rank(&group.unit)
+                            })
+                            .map(|g| (date_unit_rank(&g.unit), a))
+                    })
+                    .min_by_key(|(rank, _)| *rank)
+                    .and_then(|(_, a)| axes.get(&(a.field, axis_unit(a))).copied())
+                    .map(|parent| (own, parent))
+            } else {
+                None
+            };
+            if let Some((child, parent)) = parent {
+                if let Some(field) = fields.get_mut(child) {
+                    if let Some(group) = field
+                        .children
+                        .iter_mut()
+                        .find(|n| n.local() == "fieldGroup")
+                    {
+                        group.attrs.insert("par".into(), parent.to_string());
+                    } else {
+                        field.push(Node::new("fieldGroup").set("par", parent));
+                    }
+                }
+            }
+        }
+    }
+    let mut measures = Vec::new();
+    let mut calculated_fields = HashMap::new();
+    for value in &pivot.values {
+        if let Some(formula) = value.formula.as_deref().filter(|s| !s.is_empty()) {
+            let name = value.source_name.as_deref().unwrap_or(&value.name);
+            let key = (name.to_owned(), formula.to_owned());
+            if let Some(index) = calculated_fields.get(&key) {
+                measures.push(*index);
+            } else {
+                let index = fields.len();
+                fields.push(
+                    Node::new("cacheField")
+                        .set("name", name)
+                        .set("databaseField", 0)
+                        .set("formula", formula.trim_start_matches('=')),
+                );
+                shared.push(vec![]);
+                measures.push(index);
+                calculated_fields.insert(key, index);
+            }
+        } else {
+            measures.push(value.field);
+        }
+    }
+    CachePlan {
+        fields,
+        shared,
+        record_shared,
+        axes,
+        measures,
+    }
+}
+
+fn show_as(value: &str) -> (&str, Option<&str>) {
+    match value {
+        "percentOfGrandTotal" => ("percentOfTotal", None),
+        "percentOfRowTotal" => ("percentOfRow", None),
+        "percentOfColumnTotal" => ("percentOfCol", None),
+        "runningTotal" => ("runTotal", None),
+        "percentDifference" => ("percentDiff", None),
+        "percentOfParentRowTotal" => ("normal", Some("percentOfParentRow")),
+        "percentOfParentColumnTotal" => ("normal", Some("percentOfParentCol")),
+        "percentRunningTotal" => ("normal", Some("percentOfRunningTotal")),
+        "rankAscending" => ("normal", Some("rankAscending")),
+        "rankDescending" => ("normal", Some("rankDescending")),
+        other => (other, None),
+    }
+}
+fn write_generated_pivot(
+    workbook: &Workbook,
+    pivot: &PivotTable,
+    path: &str,
+    cache_path: &str,
+    cache_id: &str,
+    archive: &mut BTreeMap<String, Vec<u8>>,
+    types: &mut Node,
+) -> XlsxResult<()> {
+    let plan = build_cache(pivot, workbook.settings().date_1904);
+    let records_path = cache_path.replace("pivotCacheDefinition", "pivotCacheRecords");
+    let mut cache = Node::new("pivotCacheDefinition")
+        .set("xmlns", MAIN)
+        .set("xmlns:r", REL)
+        .set("r:id", "rId1")
+        .set("createdVersion", 6)
+        .set("refreshedVersion", 6)
+        .set("minRefreshableVersion", 3)
+        .set("recordCount", pivot.cache.len())
+        .set("saveData", 1)
+        .set("refreshOnLoad", u8::from(pivot.refresh_on_load));
+    let mut source = Node::new("cacheSource").set("type", "worksheet");
+    source.push(if let Some(table) = &pivot.source.table {
+        Node::new("worksheetSource").set("name", table)
+    } else {
+        Node::new("worksheetSource")
+            .set("ref", &pivot.source.range)
+            .set("sheet", &pivot.source.sheet)
+    });
+    cache.push(source);
+    let mut fields = Node::new("cacheFields").set("count", plan.fields.len());
+    for field in &plan.fields {
+        fields.push(field.clone());
+    }
+    cache.push(fields);
+    if !pivot.calculated_items.is_empty() {
+        let mut items = Node::new("calculatedItems").set("count", pivot.calculated_items.len());
+        for item in &pivot.calculated_items {
+            let index = plan
+                .shared
+                .get(item.field)
+                .and_then(|s| s.iter().position(|v| v.caption() == item.name))
+                .unwrap_or(0);
+            let mut calculated =
+                Node::new("calculatedItem").set("formula", item.formula.trim_start_matches('='));
+            let mut area = Node::new("pivotArea")
+                .set("cacheIndex", 1)
+                .set("outline", 0)
+                .set(
+                    "fieldPosition",
+                    pivot
+                        .rows
+                        .iter()
+                        .position(|a| a.field == item.field)
+                        .or_else(|| pivot.columns.iter().position(|a| a.field == item.field))
+                        .unwrap_or(0),
+                );
+            let mut references = Node::new("references").set("count", 1);
+            let mut reference = Node::new("reference")
+                .set("field", item.field)
+                .set("count", 1);
+            reference.push(Node::new("x").set("v", index));
+            references.push(reference);
+            area.push(references);
+            calculated.push(area);
+            items.push(calculated);
+        }
+        cache.push(items);
+    }
+    let mut records = Node::new("pivotCacheRecords")
+        .set("xmlns", MAIN)
+        .set("count", pivot.cache.len());
+    for record in &pivot.cache {
+        let mut row = Node::new("r");
+        for (i, items) in plan
+            .record_shared
+            .iter()
+            .enumerate()
+            .take(pivot.fields.len())
+        {
+            if let Some(value) = record.get(i) {
+                let index = items.iter().position(|v| v.key() == value.key());
+                row.push(
+                    index
+                        .map(|v| Node::new("x").set("v", v))
+                        .unwrap_or_else(|| value_node(value)),
+                );
+            } else {
+                row.push(Node::new("m"));
+            }
+        }
+        records.push(row);
+    }
+    put_part(archive, types, cache_path, &cache, "pivotCacheDefinition")?;
+    put_part(archive, types, &records_path, &records, "pivotCacheRecords")?;
+    let mut cache_rels = relationship_root();
+    cache_rels.push(
+        Node::new("Relationship")
+            .set("Id", "rId1")
+            .set("Type", format!("{REL}/pivotCacheRecords"))
+            .set("Target", format!("/{records_path}")),
+    );
+    archive.insert(relationships_path(cache_path), cache_rels.bytes()?);
+    let mut pivot_rels = relationship_root();
+    pivot_rels.push(
+        Node::new("Relationship")
+            .set("Id", "rId1")
+            .set("Type", format!("{REL}/pivotCacheDefinition"))
+            .set("Target", format!("/{cache_path}")),
+    );
+    archive.insert(relationships_path(path), pivot_rels.bytes()?);
+    let mut def = Node::new("pivotTableDefinition")
+        .set("xmlns", MAIN)
+        .set("xmlns:r", REL)
+        .set("name", &pivot.name)
+        .set("cacheId", cache_id)
+        .set("dataCaption", "Values")
+        .set("createdVersion", 6)
+        .set("updatedVersion", 6)
+        .set("minRefreshableVersion", 3)
+        .set("useAutoFormatting", 1)
+        .set("applyNumberFormats", 1)
+        .set("applyBorderFormats", 0)
+        .set("applyFontFormats", 0)
+        .set("applyPatternFormats", 0)
+        .set("applyAlignmentFormats", 0)
+        .set("applyWidthHeightFormats", 1)
+        .set("itemPrintTitles", 1)
+        .set("multipleFieldFilters", 1);
+    for (key, value) in [
+        ("preserveFormatting", pivot.preserve_formatting),
+        ("dataOnRows", pivot.values_on_rows),
+        ("compact", pivot.layout == "compact"),
+        ("compactData", pivot.layout == "compact"),
+        ("outline", pivot.layout != "tabular"),
+        ("outlineData", pivot.layout != "tabular"),
+        ("rowGrandTotals", pivot.row_grand_totals),
+        ("colGrandTotals", pivot.column_grand_totals),
+    ] {
+        def = attr_bool(def, key, value);
+    }
+    let row_width = (if pivot.rows.is_empty() {
+        1
+    } else if pivot.layout == "compact" {
+        1
+    } else {
+        pivot.rows.len()
+    }) + usize::from(pivot.values_on_rows && pivot.layout != "compact");
+    let values_only_header =
+        !pivot.values_on_rows && pivot.values.len() > 1 && pivot.columns.is_empty();
+    let header_height =
+        pivot.columns.len().max(1) + usize::from(!pivot.values_on_rows && pivot.values.len() > 1);
+    let page_height = if pivot.report_filters.is_empty() {
+        0
+    } else {
+        pivot.report_filters.len() + 1
+    };
+    let mut output_range =
+        CellRange::parse(pivot.output_range.as_deref().unwrap_or(&pivot.target.cell))
+            .map_err(|e| XlsxError::InvalidFormat(e.to_string()))?;
+    output_range.start.row += page_height as u32;
+    let mut location = Node::new("location")
+        .set("ref", output_range.to_a1_string())
+        .set("firstHeaderRow", usize::from(values_only_header))
+        .set("firstDataRow", header_height)
+        .set("firstDataCol", row_width);
+    if !pivot.report_filters.is_empty() {
+        location = location
+            .set("rowPageCount", pivot.report_filters.len())
+            .set("colPageCount", 1);
+    }
+    def.push(location);
+    let mut pivot_fields = Node::new("pivotFields").set("count", plan.fields.len());
+    for (index, items) in plan.shared.iter().enumerate() {
+        let row = pivot.rows.iter().find(|a| plan.axis_index(a) == index);
+        let col = pivot.columns.iter().find(|a| plan.axis_index(a) == index);
+        let axis = row.or(col);
+        let is_page = pivot.report_filters.contains(&index);
+        let is_value = plan.measures.contains(&index);
+        let mut field = Node::new("pivotField").set(
+            "showAll",
+            u8::from(axis.is_some_and(|a| a.show_items_with_no_data)),
+        );
+        if let Some(axis) = axis {
+            field = field
+                .set("axis", if row.is_some() { "axisRow" } else { "axisCol" })
+                .set(
+                    "sortType",
+                    if axis.sort == "valueDescending" {
+                        "descending"
+                    } else if axis.sort == "valueAscending" {
+                        "ascending"
+                    } else {
+                        &axis.sort
+                    },
+                )
+                .set(
+                    "defaultSubtotal",
+                    u8::from(
+                        axis.subtotals
+                            && axis.subtotal_functions.is_empty()
+                            && pivot.subtotals_position != "none",
+                    ),
+                )
+                .set("subtotalTop", u8::from(pivot.subtotals_position == "top"))
+                .set("compact", u8::from(pivot.layout == "compact"))
+                .set("outline", u8::from(pivot.layout != "tabular"));
+        }
+        if let Some(axis) = axis {
+            for (name, attr) in SUBTOTALS {
+                if axis.subtotal_functions.iter().any(|f| f == name) {
+                    field = field.set(attr, 1);
+                }
+            }
+            if let Some(measure) = axis.sort_measure.filter(|_| axis.sort.starts_with("value")) {
+                let mut scope = Node::new("autoSortScope");
+                let mut area = Node::new("pivotArea").set("dataOnly", 0).set("outline", 0);
+                let mut refs = Node::new("references").set("count", 1);
+                let mut r = Node::new("reference")
+                    .set("field", 4294967294u32)
+                    .set("count", 1)
+                    .set("selected", 0);
+                r.push(Node::new("x").set("v", measure));
+                refs.push(r);
+                area.push(refs);
+                scope.push(area);
+                field.push(scope);
+            }
+        }
+        if is_page {
+            field = field
+                .set("axis", "axisPage")
+                .set("multipleItemSelectionAllowed", 1)
+                .set("defaultSubtotal", 0);
+        }
+        if is_value {
+            field = field.set("dataField", 1);
+            if index >= pivot.fields.len() {
+                field = field
+                    .set("dragToRow", 0)
+                    .set("dragToCol", 0)
+                    .set("dragToPage", 0)
+                    .set("defaultSubtotal", 0);
+            }
+        }
+        if axis.is_some() || is_page {
+            let filter = pivot.filters.iter().find(|f| {
+                plan.field_index(f.field, f.grouping_unit.as_deref()) == index
+                    && f.kind == "members"
+            });
+            let subtotal = axis.is_some_and(|a| a.subtotals && pivot.subtotals_position != "none");
+            let functions: Vec<&str> = axis
+                .filter(|_| subtotal)
+                .map(|a| {
+                    if a.subtotal_functions.is_empty() {
+                        vec!["default"]
+                    } else {
+                        a.subtotal_functions.iter().map(String::as_str).collect()
+                    }
+                })
+                .unwrap_or_default();
+            let mut list = Node::new("items").set("count", items.len() + functions.len());
+            for (i, item) in items.iter().enumerate() {
+                let mut node = Node::new("item").set("x", i);
+                if pivot
+                    .calculated_items
+                    .iter()
+                    .any(|c| c.field == index && c.name == item.caption())
+                {
+                    node = node.set("f", 1);
+                }
+                if filter.is_some_and(|f| !f.values.contains(&item.key())) {
+                    node = node.set("h", 1);
+                }
+                if axis.is_some_and(|a| a.collapsed.contains(&item.key())) {
+                    node = node.set("sd", 0);
+                }
+                list.push(node);
+            }
+            for function in functions {
+                list.push(Node::new("item").set("t", subtotal_item_type(function)));
+            }
+            field.children.insert(0, list);
+        }
+        if pivot.repeat_labels && axis.is_some() {
+            let mut ext_lst = Node::new("extLst");
+            let mut ext = Node::new("ext")
+                .set("uri", "{2946ED86-A175-432a-8AC1-64E0C546D7DE}")
+                .set(
+                    "xmlns:x14",
+                    "http://schemas.microsoft.com/office/spreadsheetml/2009/9/main",
+                );
+            ext.push(Node::new("x14:pivotField").set("fillDownLabels", 1));
+            ext_lst.push(ext);
+            field.push(ext_lst);
+        }
+        pivot_fields.push(field);
+    }
+    def.push(pivot_fields);
+    write_axis(&mut def, pivot, &plan, true);
+    write_axis(&mut def, pivot, &plan, false);
+    if !pivot.report_filters.is_empty() {
+        let mut pages = Node::new("pageFields").set("count", pivot.report_filters.len());
+        for field in &pivot.report_filters {
+            pages.push(Node::new("pageField").set("fld", field).set("hier", -1));
+        }
+        def.push(pages);
+    }
+    let mut data_fields = Node::new("dataFields").set("count", pivot.values.len());
+    for (i, data) in pivot.values.iter().enumerate() {
+        let (show, extended) = show_as(&data.show_as);
+        let mut node = Node::new("dataField")
+            .set("name", &data.name)
+            .set("fld", plan.measures[i])
+            .set("subtotal", &data.aggregation)
+            .set("showDataAs", show);
+        if let Some(field) = data.base_field {
+            node = node.set(
+                "baseField",
+                plan.field_index(field, data.base_grouping_unit.as_deref()),
+            );
+        }
+        if let Some(item) = &data.base_item {
+            let idx = if item == "previous" {
+                1048828
+            } else if item == "next" {
+                1048829
+            } else {
+                data.base_field
+                    .and_then(|f| {
+                        plan.shared
+                            .get(plan.field_index(f, data.base_grouping_unit.as_deref()))
+                    })
+                    .and_then(|v| v.iter().position(|x| x.key() == *item))
+                    .unwrap_or(0)
+            };
+            node = node.set("baseItem", idx);
+        }
+        if let Some(format) = &data.number_format {
+            let id = ensure_number_format(archive, format)?;
+            node = node.set("numFmtId", id);
+        }
+        if let Some(extended) = extended {
+            node.attrs.remove("showDataAs");
+            let mut ext_lst = Node::new("extLst");
+            let mut ext = Node::new("ext")
+                .set("uri", "{E15A36E0-9728-4e99-A89B-3F7291B0FE68}")
+                .set(
+                    "xmlns:x14",
+                    "http://schemas.microsoft.com/office/spreadsheetml/2009/9/main",
+                );
+            ext.push(Node::new("x14:dataField").set("pivotShowAs", extended));
+            ext_lst.push(ext);
+            node.push(ext_lst);
+        }
+        data_fields.push(node);
+    }
+    def.push(data_fields);
+    def.push(
+        Node::new("pivotTableStyleInfo")
+            .set(
+                "name",
+                if pivot.style_name.is_empty() {
+                    "PivotStyleLight16"
+                } else {
+                    &pivot.style_name
+                },
+            )
+            .set("showRowHeaders", 1)
+            .set("showColHeaders", 1)
+            .set("showRowStripes", 0)
+            .set("showColStripes", 0)
+            .set("showLastColumn", 1),
+    );
+    write_filters(&mut def, pivot, &plan);
+    let _ = workbook;
+    put_part(archive, types, path, &def, "pivotTable")
+}
+
+fn ensure_number_format(
+    archive: &mut BTreeMap<String, Vec<u8>>,
+    format: &str,
+) -> XlsxResult<usize> {
+    let Some(bytes) = archive.get("xl/styles.xml") else {
+        return Ok(0);
+    };
+    let mut styles = parse(bytes)?;
+    let mut formats = styles
+        .child("numFmts")
+        .cloned()
+        .unwrap_or_else(|| Node::new("numFmts"));
+    if let Some(existing) = formats
+        .all("numFmt")
+        .find(|n| n.attr("formatCode") == format)
+    {
+        return Ok(existing.num("numFmtId"));
+    }
+    let id = formats
+        .all("numFmt")
+        .map(|n| n.num("numFmtId"))
+        .max()
+        .unwrap_or(163)
+        .max(163)
+        + 1;
+    formats.push(
+        Node::new("numFmt")
+            .set("numFmtId", id)
+            .set("formatCode", format),
+    );
+    formats
+        .attrs
+        .insert("count".into(), formats.children.len().to_string());
+    styles.remove("numFmts");
+    styles.children.insert(0, formats);
+    archive.insert("xl/styles.xml".into(), styles.bytes()?);
+    Ok(id)
+}
+
+fn write_axis(def: &mut Node, pivot: &PivotTable, plan: &CachePlan, row: bool) {
+    let axes = if row { &pivot.rows } else { &pivot.columns };
+    let multiple = if pivot.values_on_rows {
+        row && !pivot.values.is_empty()
+    } else {
+        !row && pivot.values.len() > 1
+    };
+    if !axes.is_empty() || multiple {
+        let mut fields = Node::new(if row { "rowFields" } else { "colFields" })
+            .set("count", axes.len() + usize::from(multiple));
+        for axis in axes {
+            fields.push(Node::new("field").set("x", plan.axis_index(axis)));
+        }
+        if multiple {
+            fields.push(Node::new("field").set("x", -2));
+        }
+        def.push(fields);
+    }
+    let mut entries = BTreeMap::<u32, (Vec<String>, String, usize, Option<String>)>::new();
+    for cell in &pivot.output {
+        if cell.measure.is_none()
+            && (!row
+                || cell.row_keys.is_empty()
+                || !["header", "subtotal", "detail", "grand", "groupLabel"]
+                    .contains(&cell.kind.as_str()))
+        {
+            continue;
+        }
+        let key = if row { cell.row } else { u32::from(cell.col) };
+        let keys = if row {
+            &cell.row_keys
+        } else {
+            &cell.column_keys
+        };
+        let entry = entries.entry(key).or_insert_with(|| {
+            (
+                keys.clone(),
+                cell.kind.clone(),
+                cell.measure.unwrap_or(0),
+                cell.subtotal_function.clone(),
+            )
+        });
+        if let Some(measure) = cell.measure {
+            entry.2 = measure;
+        }
+    }
+    let mut items =
+        Node::new(if row { "rowItems" } else { "colItems" }).set("count", entries.len().max(1));
+    if entries.is_empty() {
+        items.push(Node::new("i"));
+    }
+    for (_, (keys, kind, measure, function)) in entries {
+        let mut item = Node::new("i");
+        let group_label = kind == "groupLabel";
+        if multiple && !group_label {
+            item = item.set("i", measure);
+        }
+        let subtotal = keys.len() < axes.len();
+        if kind == "grand" || (!axes.is_empty() && keys.is_empty()) {
+            item = item.set("t", "grand");
+        } else if subtotal && !group_label {
+            item = item.set(
+                "t",
+                subtotal_item_type(function.as_deref().unwrap_or("default")),
+            );
+        }
+        for (depth, key) in keys.iter().enumerate() {
+            let index = axes.get(depth).map(|a| plan.axis_index(a)).unwrap_or(0);
+            let value = plan
+                .shared
+                .get(index)
+                .and_then(|v| v.iter().position(|i| i.key() == *key))
+                .unwrap_or(0);
+            item.push(Node::new("x").set("v", value));
+        }
+        if keys.is_empty() && !axes.is_empty() {
+            item.push(Node::new("x"));
+        }
+        if multiple && !group_label {
+            item.push(Node::new("x").set("v", measure));
+        }
+        items.push(item);
+    }
+    def.push(items);
+}
+fn write_filters(def: &mut Node, pivot: &PivotTable, plan: &CachePlan) {
+    let mut filters = Node::new("filters");
+    for (id, filter) in pivot
+        .filters
+        .iter()
+        .filter(|f| f.kind != "members")
+        .enumerate()
+    {
+        let top = filter.kind == "top10";
+        let suffix = match filter.operator.as_str() {
+            "equal" => "Equal",
+            "notEqual" => "NotEqual",
+            "contains" => "Contains",
+            "notContains" => "NotContains",
+            "beginsWith" => "BeginsWith",
+            "notBeginsWith" => "NotBeginsWith",
+            "endsWith" => "EndsWith",
+            "notEndsWith" => "NotEndsWith",
+            "greaterThan" => "GreaterThan",
+            "greaterThanOrEqual" => "GreaterThanOrEqual",
+            "lessThan" => "LessThan",
+            "lessThanOrEqual" => "LessThanOrEqual",
+            "between" => "Between",
+            "notBetween" => "NotBetween",
+            _ => "Equal",
+        };
+        let kind = if top {
+            if filter.percent {
+                "percent".into()
+            } else {
+                "count".into()
+            }
+        } else {
+            format!(
+                "{}{suffix}",
+                if filter.kind == "label" {
+                    "caption"
+                } else {
+                    "value"
+                }
+            )
+        };
+        let mut node = Node::new("filter")
+            .set(
+                "fld",
+                plan.field_index(filter.field, filter.grouping_unit.as_deref()),
+            )
+            .set("type", kind)
+            .set("id", id);
+        if filter.kind == "value" || top {
+            node = node.set("iMeasureFld", filter.measure);
+        }
+        if filter.kind == "label" {
+            node = node
+                .set("stringValue1", &filter.value)
+                .set("stringValue2", &filter.value2);
+        }
+        let mut auto = Node::new("autoFilter").set("ref", "A1");
+        let mut column = Node::new("filterColumn").set("colId", 0);
+        if top {
+            column.push(
+                Node::new("top10")
+                    .set("top", u8::from(filter.top))
+                    .set("percent", u8::from(filter.percent))
+                    .set("val", filter.count),
+            );
+        } else {
+            let mut customs = Node::new("customFilters");
+            let (operator, value) = match filter.operator.as_str() {
+                "contains" => ("equal", format!("*{}*", filter.value)),
+                "notContains" => ("notEqual", format!("*{}*", filter.value)),
+                "beginsWith" => ("equal", format!("{}*", filter.value)),
+                "notBeginsWith" => ("notEqual", format!("{}*", filter.value)),
+                "endsWith" => ("equal", format!("*{}", filter.value)),
+                "notEndsWith" => ("notEqual", format!("*{}", filter.value)),
+                "between" => ("greaterThanOrEqual", filter.value.clone()),
+                "notBetween" => ("lessThan", filter.value.clone()),
+                other => (other, filter.value.clone()),
+            };
+            customs.push(
+                Node::new("customFilter")
+                    .set("operator", operator)
+                    .set("val", value),
+            );
+            if filter.operator == "between" || filter.operator == "notBetween" {
+                customs = customs.set("and", u8::from(filter.operator == "between"));
+                customs.push(
+                    Node::new("customFilter")
+                        .set(
+                            "operator",
+                            if filter.operator == "between" {
+                                "lessThanOrEqual"
+                            } else {
+                                "greaterThan"
+                            },
+                        )
+                        .set("val", &filter.value2),
+                );
+            }
+            column.push(customs);
+        }
+        auto.push(column);
+        node.push(auto);
+        filters.push(node);
+    }
+    if !filters.children.is_empty() {
+        filters
+            .attrs
+            .insert("count".into(), filters.children.len().to_string());
+        def.push(filters);
+    }
+}
