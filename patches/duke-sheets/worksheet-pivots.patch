+fn sheet_index(workbook: &Workbook, name: &str) -> Result<usize> {
+    workbook
+        .worksheets()
+        .position(|s| s.name().eq_ignore_ascii_case(name))
+        .ok_or_else(|| Error::SheetNotFound(name.into()))
