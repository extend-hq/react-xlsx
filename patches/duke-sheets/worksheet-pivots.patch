+fn remap_relationship_ids(node: &mut Node, mappings: &HashMap<String, String>) {
+    for (key, value) in &mut node.attrs {
+        if key.ends_with(":id") {
+            if let Some(next) = mappings.get(value) {
+                *value = next.clone();
+            }
+        }
+    }
+    for child in &mut node.children {
+        remap_relationship_ids(child, mappings);
+    }
+}
