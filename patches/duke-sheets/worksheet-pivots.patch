+fn normalize(pivot: &mut PivotTable) -> Result<()> {
+    if pivot.rows.len() + pivot.columns.len() > 32
+        || pivot.values.len() > 256
+        || pivot.filters.len() > 256
+        || pivot.calculated_items.len() > 256
+    {
+        return Err(fail(
+            "Pivot configuration exceeds supported complexity limits",
+        ));
+    }
+    if pivot.cache.len() as u64 * pivot.fields.len() as u64 > MAX_SOURCE_CELLS {
+        return Err(fail("Pivot cache exceeds the supported cell limit"));
+    }
+    for record in &mut pivot.cache {
+        record.resize(pivot.fields.len(), PivotValue::Blank);
+    }
+    let aggregation_count = pivot.values.len()
+        + if pivot.values.iter().any(|value| value.formula.is_some()) {
+            pivot.fields.len()
+        } else {
+            0
+        };
+    if pivot
+        .cache
+        .len()
+        .saturating_mul(pivot.rows.len() + 1)
+        .saturating_mul(pivot.columns.len() + 1)
+        .saturating_mul(aggregation_count)
+        > 50_000_000
+    {
+        return Err(fail(
+            "Pivot aggregation exceeds supported complexity limits",
+        ));
+    }
+    if pivot.layout.is_empty() {
+        pivot.layout = "compact".into();
+    }
+    token(&pivot.layout, &["compact", "outline", "tabular"], "layout")?;
+    if pivot.subtotals_position.is_empty() {
+        pivot.subtotals_position = "bottom".into();
+    }
+    token(
+        &pivot.subtotals_position,
+        &["top", "bottom", "none"],
+        "subtotal position",
+    )?;
+    pivot.member_aliases = pivot
+        .fields
+        .iter()
+        .map(|field| {
+            let mut aliases = BTreeMap::new();
+            for member in &field.items {
+                if let PivotValue::Text(text) = PivotValue::from_key(&member.key) {
+                    aliases.entry(text.to_lowercase()).or_insert(text);
+                }
+            }
+            aliases
+        })
+        .collect();
+    for record in &pivot.cache {
+        for (field, value) in record.iter().enumerate() {
+            if let PivotValue::Text(text) = value {
+                pivot.member_aliases[field]
+                    .entry(text.to_lowercase())
+                    .or_insert(text.clone());
+            }
+        }
+    }
+    let mut axis_fields = BTreeSet::new();
+    let mut grouped_fields = BTreeMap::<usize, (bool, BTreeSet<String>)>::new();
+    let row_axis_count = pivot.rows.len();
+    for (axis_index, axis) in pivot
+        .rows
+        .iter_mut()
+        .chain(pivot.columns.iter_mut())
+        .enumerate()
+    {
+        if axis.field >= pivot.fields.len() {
+            return Err(fail("Pivot axis refers to an unknown field"));
+        }
+        let unit = axis
+            .grouping
+            .as_ref()
+            .filter(|g| g.kind == "date")
+            .map(|g| g.unit.clone())
+            .unwrap_or_default();
+        let group = grouped_fields
+            .entry(axis.field)
+            .or_insert_with(|| (axis_index < row_axis_count, BTreeSet::new()));
+        if (!group.1.is_empty()
+            && (group.0 != (axis_index < row_axis_count)
+                || unit.is_empty()
+                || group.1.contains("")))
+            || !group.1.insert(unit.clone())
+        {
+            return Err(fail(
+                "Repeated pivot fields require distinct date units on the same axis",
+            ));
+        }
+        axis_fields.insert(axis.field);
+        if axis.name.is_none() && !unit.is_empty() {
+            axis.name = Some(format!(
+                "{}{}",
+                unit.chars().next().unwrap().to_uppercase(),
+                unit.chars().skip(1).collect::<String>()
+            ));
+        }
+        if axis.sort.is_empty() {
+            axis.sort = "ascending".into();
+        }
+        token(
+            &axis.sort,
+            &[
+                "ascending",
+                "descending",
+                "manual",
+                "valueAscending",
+                "valueDescending",
+            ],
+            "sort order",
+        )?;
+        if axis.sort.starts_with("value")
+            && !axis
+                .sort_measure
+                .is_some_and(|measure| measure < pivot.values.len())
+        {
+            return Err(fail("Value sorting requires a valid measure"));
+        }
+        for function in &axis.subtotal_functions {
+            if !pivot.calculated_items.is_empty()
+                && ["average", "var", "varp", "stdDev", "stdDevp"].contains(&function.as_str())
+            {
+                return Err(fail(
+                    "Calculated items cannot be combined with statistical subtotals",
+                ));
+            }
+            token(
+                function,
+                &[
+                    "sum",
+                    "count",
+                    "countNums",
+                    "average",
+                    "min",
+                    "max",
+                    "product",
+                    "var",
+                    "varp",
+                    "stdDev",
+                    "stdDevp",
+                ],
+                "subtotal function",
+            )?;
+        }
+        if let Some(group) = &axis.grouping {
+            let numbers: Vec<f64> = pivot
+                .cache
+                .iter()
+                .filter_map(|row| {
+                    if let PivotValue::Number(value) = row[axis.field] {
+                        Some(value)
+                    } else {
+                        None
+                    }
+                })
+                .collect();
+            axis.group_start = numbers.iter().copied().reduce(f64::min);
+            axis.group_end = numbers.iter().copied().reduce(f64::max);
+            axis.group_integer = numbers.iter().all(|value| value.fract() == 0.0);
+            token(&group.kind, &["number", "date", "manual"], "grouping")?;
+            if group.kind == "number" && (!group.interval.is_finite() || group.interval <= 0.0) {
+                return Err(fail("Number grouping interval must be positive"));
+            }
+            if group.start.is_some_and(|v| !v.is_finite())
+                || group.end.is_some_and(|v| !v.is_finite())
+                || matches!((group.start,group.end),(Some(start),Some(end)) if start>end)
+            {
+                return Err(fail("Pivot grouping bounds are invalid"));
+            }
+            if group.kind == "manual" {
+                let mut names = BTreeSet::new();
+                let mut members = BTreeSet::new();
+                for group in &group.groups {
+                    if group.name.trim().is_empty() || !names.insert(group.name.to_lowercase()) {
+                        return Err(fail("Manual group names must be nonempty and unique"));
+                    }
+                    for member in &group.members {
+                        if !members.insert(member) {
+                            return Err(fail("A pivot member can belong to only one manual group"));
+                        }
+                    }
+                }
+            }
+            if group.kind == "date" {
+                token(
+                    &group.unit,
+                    &[
+                        "years", "quarters", "months", "days", "hours", "minutes", "seconds",
+                    ],
+                    "date unit",
+                )?;
+            }
+        }
+    }
+    for field in &pivot.report_filters {
+        if *field >= pivot.fields.len() || !axis_fields.insert(*field) {
+            return Err(fail(
+                "Report filter fields must be valid and distinct from row/column fields",
+            ));
+        }
+    }
+    for value in &mut pivot.values {
+        if value.field >= pivot.fields.len() {
+            return Err(fail("Pivot value refers to an unknown field"));
+        }
+        if value.aggregation.is_empty() {
+            value.aggregation = "sum".into();
+        }
+        token(
+            &value.aggregation,
+            &[
+                "sum",
+                "count",
+                "countNums",
+                "average",
+                "min",
+                "max",
+                "product",
+                "var",
+                "varp",
+                "stdDev",
+                "stdDevp",
+            ],
+            "aggregation",
+        )?;
+        if value.show_as.is_empty() {
+            value.show_as = "normal".into();
+        }
+        token(
+            &value.show_as,
+            &[
+                "normal",
+                "percentOfGrandTotal",
+                "percentOfRowTotal",
+                "percentOfColumnTotal",
+                "percentOfParentRowTotal",
+                "percentOfParentColumnTotal",
+                "difference",
+                "percentDifference",
+                "percent",
+                "runningTotal",
+                "percentRunningTotal",
+                "rankAscending",
+                "rankDescending",
+                "index",
+            ],
+            "calculation",
+        )?;
+        if value
+            .base_field
+            .is_some_and(|field| field >= pivot.fields.len())
+        {
+            return Err(fail("Pivot base field does not exist"));
+        }
+        if [
+            "difference",
+            "percentDifference",
+            "percent",
+            "runningTotal",
+            "percentRunningTotal",
+            "rankAscending",
+            "rankDescending",
+        ]
+        .contains(&value.show_as.as_str())
+            && !value.base_field.is_some_and(|field| {
+                pivot
+                    .rows
+                    .iter()
+                    .chain(&pivot.columns)
+                    .any(|axis| axis.field == field)
+            })
+        {
+            return Err(fail(
+                "This calculation requires a base field on a row or column axis",
+            ));
+        }
+
+        if !pivot.calculated_items.is_empty()
+            && ["average", "var", "varp", "stdDev", "stdDevp"].contains(&value.aggregation.as_str())
+        {
+            return Err(fail(
+                "Calculated items cannot be combined with average or statistical summary functions",
+            ));
+        }
+        if value.name.is_empty() {
+            value.name = format!(
+                "{} of {}",
+                match value.aggregation.as_str() {
+                    "sum" => "Sum",
+                    "count" => "Count",
+                    "average" => "Average",
+                    other => other,
+                },
+                pivot.fields[value.field].name
+            );
+        }
+    }
+    for value in &mut pivot.values {
+        if value.formula.is_some() && value.source_name.is_none() {
+            value.source_name = Some(value.name.clone());
+        }
+    }
+    for formula in pivot
+        .values
+        .iter()
+        .filter_map(|value| value.formula.as_deref())
+        .chain(
+            pivot
+                .calculated_items
+                .iter()
+                .map(|item| item.formula.as_str()),
+        )
+    {
+        if formula.len() > 4096 || formula.bytes().filter(|c| b"()+-*/^".contains(c)).count() > 256
+        {
+            return Err(fail(
+                "Calculated pivot formula exceeds supported complexity limits",
+            ));
+        }
+        validate_formula(formula)?;
+    }
+    let mut names = BTreeSet::new();
+    for value in &pivot.values {
+        if !names.insert(value.name.to_lowercase()) {
+            return Err(fail("Pivot value captions must be unique"));
+        }
+    }
+    for filter in &mut pivot.filters {
+        if filter.grouping_unit.is_none()
+            && pivot
+                .rows
+                .iter()
+                .chain(&pivot.columns)
+                .any(|axis| axis.field == filter.field && axis.grouping.is_some())
+        {
+            return Err(fail("Filter the grouped members of this field; raw source filters on a grouped field cannot be preserved in Excel"));
+        }
+        if filter.field >= pivot.fields.len() {
+            return Err(fail("Pivot filter refers to an unknown field"));
+        }
+        if filter.kind.is_empty() {
+            filter.kind = "members".into();
+        }
+        token(
+            &filter.kind,
+            &["members", "label", "value", "top10"],
+            "filter",
+        )?;
+        if filter.kind != "members" && filter.kind != "top10" {
+            token(
+                &filter.operator,
+                &[
+                    "equal",
+                    "notEqual",
+                    "contains",
+                    "notContains",
+                    "beginsWith",
+                    "notBeginsWith",
+                    "endsWith",
+                    "notEndsWith",
+                    "greaterThan",
+                    "greaterThanOrEqual",
+                    "lessThan",
+                    "lessThanOrEqual",
+                    "between",
+                    "notBetween",
+                ],
+                "filter operator",
+            )?;
+        }
+        if ["value", "top10"].contains(&filter.kind.as_str())
+            && filter.measure >= pivot.values.len()
+        {
+            return Err(fail("Pivot value filter requires a valid measure"));
+        }
+        if filter.kind == "top10" && (!filter.count.is_finite() || filter.count <= 0.0) {
+            return Err(fail("Top filter count must be positive"));
+        }
+    }
+    for item in &pivot.calculated_items {
+        if pivot
+            .rows
+            .iter()
+            .chain(&pivot.columns)
+            .any(|axis| axis.field == item.field && axis.grouping.is_some())
+        {
+            return Err(fail("Calculated items cannot be added to grouped fields"));
+        }
+        if item.field >= pivot.fields.len()
+            || item.name.is_empty()
+            || item.formula.trim().is_empty()
+        {
+            return Err(fail("Calculated items require a field, name, and formula"));
+        }
+    }
+    Ok(())
+}
+
+pub fn grouped(value: &PivotValue, axis: &PivotAxisField, date1904: bool) -> PivotValue {
+    let Some(group) = &axis.grouping else {
+        return value.clone();
+    };
+    if group.kind == "manual" {
+        return group
+            .groups
+            .iter()
+            .find(|g| g.members.contains(&value.key()))
+            .map(|g| PivotValue::Text(g.name.clone()))
+            .unwrap_or_else(|| value.clone());
+    }
+    let PivotValue::Number(number) = value else {
+        return value.clone();
+    };
+    if let Some(start) = group.start.or(axis.group_start) {
+        if *number < start {
+            return PivotValue::Text(format!("<{start}"));
+        }
+    }
+    if let Some(end) = group.end.or(axis.group_end) {
+        if *number > end {
+            return PivotValue::Text(format!(">{end}"));
+        }
+    }
+    if group.kind == "number" {
+        let start = group.start.or(axis.group_start).unwrap_or(0.0);
+        let end = group.end.or(axis.group_end);
+        let mut bin = ((*number - start) / group.interval).floor();
+        let count = end.map(|end| ((end - start) / group.interval).ceil().max(1.0));
+        if let Some(count) = count {
+            bin = bin.min(count - 1.0);
+        }
+        let lo = bin * group.interval + start;
+        let hi = if count.is_some_and(|count| bin == count - 1.0) {
+            end.unwrap()
+        } else {
+            lo + group.interval
+                - if axis.group_integer && start.fract() == 0.0 && group.interval.fract() == 0.0 {
+                    1.0
+                } else {
+                    0.0
+                }
+        };
+        return PivotValue::Text(format!("{lo}-{hi}"));
+    }
+    let base = NaiveDate::from_ymd_opt(
+        if date1904 { 1904 } else { 1899 },
+        if date1904 { 1 } else { 12 },
+        if date1904 {
+            1
+        } else if *number < 60.0 {
+            31
+        } else {
+            30
+        },
+    )
+    .unwrap();
+    let Some(duration) = Duration::try_seconds((*number * 86400.0).round() as i64) else {
+        return PivotValue::Error("#NUM!".into());
+    };
+    let Some(date) = base
+        .and_hms_opt(0, 0, 0)
+        .unwrap()
+        .checked_add_signed(duration)
+    else {
+        return value.clone();
+    };
+    PivotValue::Text(match group.unit.as_str() {
+        "years" => format!("{}", date.year()),
+        "quarters" => format!("Qtr{}", date.month0() / 3 + 1),
+        "months" => [
+            "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
+        ][date.month0() as usize]
+            .into(),
+        "days" if !date1904 && number.floor() == 60.0 && group.interval <= 1.0 => {
+            "1900-02-29".into()
+        }
+        "days" => {
+            let interval = group.interval.max(1.0);
+            let lo = ((*number - group.start.or(axis.group_start).unwrap_or(0.0)) / interval)
+                .floor()
+                * interval
+                + group.start.or(axis.group_start).unwrap_or(0.0);
+            let day_base = NaiveDate::from_ymd_opt(
+                if date1904 { 1904 } else { 1899 },
+                if date1904 { 1 } else { 12 },
+                if date1904 {
+                    1
+                } else if lo < 60.0 {
+                    31
+                } else {
+                    30
+                },
+            )
+            .unwrap();
+            Duration::try_days(lo as i64)
+                .and_then(|duration| day_base.checked_add_signed(duration))
+                .map(|d| d.format("%Y-%m-%d").to_string())
+                .unwrap_or_default()
+        }
+        "hours" => format!("{:02}", date.hour()),
+        "minutes" => format!("{:02}", date.minute()),
+        "seconds" => format!("{:02}", date.second()),
+        _ => value.caption(),
+    })
+}
+fn axis_key(
+    pivot: &PivotTable,
+    record: &[PivotValue],
+    fields: &[PivotAxisField],
+    date1904: bool,
+) -> Vec<String> {
+    fields
+        .iter()
+        .map(|axis| {
+            grouped(
+                &canonical_member(&pivot.member_aliases, axis.field, &record[axis.field]),
+                axis,
+                date1904,
+            )
+            .key()
+        })
+        .collect()
+}
+fn filter_match(operator: &str, value: &str, first: &str, second: &str, numeric: bool) -> bool {
+    let compare = |a: &str, b: &str| {
+        if numeric {
+            a.parse::<f64>()
+                .unwrap_or(f64::NAN)
+                .partial_cmp(&b.parse::<f64>().unwrap_or(f64::NAN))
+        } else {
+            Some(a.to_lowercase().cmp(&b.to_lowercase()))
+        }
+    };
+    let order = compare(value, first);
+    let other = compare(value, second);
+    match operator {
+        "equal" => order == Some(std::cmp::Ordering::Equal),
+        "notEqual" => order != Some(std::cmp::Ordering::Equal),
+        "notContains" => !value.to_lowercase().contains(&first.to_lowercase()),
+        "notBeginsWith" => !value.to_lowercase().starts_with(&first.to_lowercase()),
+        "notEndsWith" => !value.to_lowercase().ends_with(&first.to_lowercase()),
+        "contains" => value.to_lowercase().contains(&first.to_lowercase()),
+        "beginsWith" => value.to_lowercase().starts_with(&first.to_lowercase()),
+        "endsWith" => value.to_lowercase().ends_with(&first.to_lowercase()),
+        "greaterThan" => order == Some(std::cmp::Ordering::Greater),
+        "greaterThanOrEqual" => matches!(
+            order,
+            Some(std::cmp::Ordering::Greater | std::cmp::Ordering::Equal)
+        ),
+        "lessThan" => order == Some(std::cmp::Ordering::Less),
+        "lessThanOrEqual" => matches!(
+            order,
+            Some(std::cmp::Ordering::Less | std::cmp::Ordering::Equal)
+        ),
+        "between" => {
+            matches!(
+                order,
+                Some(std::cmp::Ordering::Greater | std::cmp::Ordering::Equal)
+            ) && matches!(
+                other,
+                Some(std::cmp::Ordering::Less | std::cmp::Ordering::Equal)
+            )
+        }
+        "notBetween" => {
+            order == Some(std::cmp::Ordering::Less) || other == Some(std::cmp::Ordering::Greater)
+        }
+        _ => false,
+    }
+}
+
+#[derive(Default, Clone)]
+struct Aggregate {
+    count: usize,
+    numbers: usize,
+    sum: f64,
+    mean: f64,
+    m2: f64,
+    min: f64,
+    max: f64,
+    product: f64,
+    error: Option<String>,
+}
+impl Aggregate {
+    fn add(&mut self, value: &PivotValue) {
+        if !matches!(value, PivotValue::Blank) {
+            self.count += 1;
+        }
+        if let PivotValue::Error(e) = value {
+            self.error = Some(e.clone());
+        }
+        if let PivotValue::Number(n) = value {
+            self.numbers += 1;
+            self.sum += n;
+            let delta = n - self.mean;
+            self.mean += delta / self.numbers as f64;
+            self.m2 += delta * (n - self.mean);
+            if self.numbers == 1 {
+                self.min = *n;
+                self.max = *n;
+                self.product = *n;
+            } else {
+                self.min = self.min.min(*n);
+                self.max = self.max.max(*n);
+                self.product *= n;
+            }
+        }
+    }
+    fn value(&self, kind: &str) -> PivotValue {
+        if !["count", "countNums"].contains(&kind) {
+            if let Some(error) = &self.error {
+                return PivotValue::Error(error.clone());
+            }
+        }
+        let n = self.numbers as f64;
+        let value = match kind {
+            "count" => self.count as f64,
+            "countNums" => n,
+            "sum" => self.sum,
+            "average" if n > 0.0 => self.mean,
+            "min" => self.min,
+            "max" => self.max,
+            "product" => self.product,
+            "var" | "stdDev" if n > 1.0 => self.m2 / (n - 1.0),
+            "varp" | "stdDevp" if n > 0.0 => self.m2 / n,
+            "average" | "var" | "stdDev" | "varp" | "stdDevp" => {
+                return PivotValue::Error("#DIV/0!".into())
+            }
+            _ => 0.0,
+        };
+        PivotValue::Number(if kind == "stdDev" || kind == "stdDevp" {
+            value.max(0.0).sqrt()
+        } else {
+            value
+        })
+    }
+}
+fn filtered_records(pivot: &PivotTable, date1904: bool) -> Result<Vec<&Vec<PivotValue>>> {
+    let effective = |record: &[PivotValue], field: usize, unit: Option<&str>| {
+        pivot
+            .rows
+            .iter()
+            .chain(&pivot.columns)
+            .find(|axis| {
+                axis.field == field
+                    && unit.is_some_and(|unit| {
+                        axis.grouping
+                            .as_ref()
+                            .is_some_and(|group| group.unit == unit || group.kind == unit)
+                    })
+            })
+            .map(|axis| {
+                grouped(
+                    &canonical_member(&pivot.member_aliases, field, &record[field]),
+                    axis,
+                    date1904,
+                )
+            })
+            .unwrap_or_else(|| canonical_member(&pivot.member_aliases, field, &record[field]))
+    };
+    let mut records: Vec<_> = pivot
+        .cache
+        .iter()
+        .filter(|row| {
+            pivot
+                .filters
+                .iter()
+                .filter(|f| {
+                    (f.kind == "members" || f.kind == "label")
+                        && !pivot
+                            .calculated_items
+                            .iter()
+                            .any(|item| item.field == f.field)
+                })
+                .all(|filter| {
+                    if filter.kind == "members" {
+                        filter.values.contains(
+                            &effective(row, filter.field, filter.grouping_unit.as_deref()).key(),
+                        )
+                    } else {
+                        filter_match(
+                            &filter.operator,
+                            &effective(row, filter.field, filter.grouping_unit.as_deref())
+                                .caption(),
+                            &filter.value,
+                            &filter.value2,
+                            false,
+                        )
+                    }
+                })
+        })
+        .collect();
+    for filter in pivot.filters.iter().filter(|f| {
+        (f.kind == "value" || f.kind == "top10")
+            && !pivot
+                .calculated_items
+                .iter()
+                .any(|item| item.field == f.field)
+    }) {
+        let data = &pivot.values[filter.measure];
+        let mut sums = BTreeMap::<String, Vec<Aggregate>>::new();
+        for row in &records {
+            let accumulators = sums
+                .entry(effective(row, filter.field, filter.grouping_unit.as_deref()).key())
+                .or_insert_with(|| {
+                    vec![
+                        Aggregate::default();
+                        if data.formula.is_some() {
+                            pivot.fields.len()
+                        } else {
+                            1
+                        }
+                    ]
+                });
+            if data.formula.is_some() {
+                for (accumulator, value) in accumulators.iter_mut().zip(row.iter()) {
+                    accumulator.add(value);
+                }
+            } else {
+                accumulators[0].add(&row[data.field]);
+            }
+        }
+        let mut ranked: Vec<_> = sums
+            .into_iter()
+            .map(|(key, accumulators)| {
+                let value = if let Some(formula) = &data.formula {
+                    evaluate_formula(formula, |name| {
+                        pivot
+                            .fields
+                            .iter()
+                            .position(|field| field.name.eq_ignore_ascii_case(name))
+                            .map(|field| accumulators[field].value("sum"))
+                            .unwrap_or(PivotValue::Error("#REF!".into()))
+                    })
+                } else {
+                    accumulators[0].value(&data.aggregation)
+                };
+                (key, value)
+            })
+            .collect();
+        let allowed: BTreeSet<_> = if filter.kind == "top10" {
+            ranked.sort_by(|a, b| match (&a.1, &b.1) {
+                (PivotValue::Number(a), PivotValue::Number(b)) => {
+                    if filter.top {
+                        b.total_cmp(a)
+                    } else {
+                        a.total_cmp(b)
+                    }
+                }
+                _ => std::cmp::Ordering::Equal,
+            });
+            let count = if filter.percent {
+                (ranked.len() as f64 * filter.count.min(100.0) / 100.0).ceil() as usize
+            } else {
+                filter.count as usize
+            };
+            let cutoff = ranked.get(count.saturating_sub(1)).map(|r| r.1.clone());
+            ranked
+                .into_iter()
+                .enumerate()
+                .filter(|(i, (_, v))| *i < count || Some(v) == cutoff.as_ref())
+                .map(|(_, r)| r.0)
+                .collect()
+        } else {
+            ranked
+                .into_iter()
+                .filter(|(_, value)| {
+                    filter_match(
+                        &filter.operator,
+                        &value.caption(),
+                        &filter.value,
+                        &filter.value2,
+                        true,
+                    )
+                })
+                .map(|r| r.0)
+                .collect()
+        };
+        records.retain(|row| {
+            allowed.contains(&effective(row, filter.field, filter.grouping_unit.as_deref()).key())
+        });
+    }
+    Ok(records)
+}
+
+#[derive(Clone)]
+struct AxisEntry {
+    keys: Vec<String>,
+    kind: &'static str,
+    function: Option<String>,
+}
+fn compare_keys(a: &str, b: &str) -> std::cmp::Ordering {
+    match (PivotValue::from_key(a), PivotValue::from_key(b)) {
+        (PivotValue::Number(a), PivotValue::Number(b)) => a.total_cmp(&b),
+        (PivotValue::Blank, PivotValue::Blank) => std::cmp::Ordering::Equal,
+        (PivotValue::Blank, _) => std::cmp::Ordering::Greater,
+        (_, PivotValue::Blank) => std::cmp::Ordering::Less,
+        (a, b) => a.caption().to_lowercase().cmp(&b.caption().to_lowercase()),
+    }
+}
+fn axis_entries(
+    pivot: &PivotTable,
+    groups: &Aggregates,
+    keys: &[Vec<String>],
+    axis: &[PivotAxisField],
+    row_axis: bool,
+    grand: bool,
+) -> Vec<AxisEntry> {
+    let mut branches = BTreeMap::<Vec<String>, Vec<String>>::new();
+    let mut seen = BTreeSet::new();
+    for key in keys {
+        for depth in 0..key.len() {
+            let prefix = key[..depth].to_vec();
+            let member = key[depth].clone();
+            if seen.insert((prefix.clone(), member.clone())) {
+                branches.entry(prefix).or_default().push(member);
+            }
+        }
+    }
+    fn walk(
+        pivot: &PivotTable,
+        groups: &Aggregates,
+        prefix: Vec<String>,
+        branches: &BTreeMap<Vec<String>, Vec<String>>,
+        axis: &[PivotAxisField],
+        row_axis: bool,
+        out: &mut Vec<AxisEntry>,
+    ) {
+        let depth = prefix.len();
+        if depth == axis.len() {
+            out.push(AxisEntry {
+                keys: prefix,
+                kind: "detail",
+                function: None,
+            });
+            return;
+        }
+        let field = &axis[depth];
+        let mut children = branches.get(&prefix).cloned().unwrap_or_default();
+        if field.sort != "manual" {
+            children.sort_by(|a, b| {
+                if let Some(measure) = field
+                    .sort_measure
+                    .filter(|_| field.sort.starts_with("value"))
+                {
+                    let value = |key: &str| {
+                        let mut path = prefix.clone();
+                        path.push(key.into());
+                        numeric(&if row_axis {
+                            raw_value(pivot, groups, &path, &[], measure, None)
+                        } else {
+                            raw_value(pivot, groups, &[], &path, measure, None)
+                        })
+                        .unwrap_or(0.0)
+                    };
+                    value(a)
+                        .total_cmp(&value(b))
+                        .then_with(|| compare_keys(a, b))
+                } else {
+                    compare_group_keys(field, a, b)
+                }
+            });
+            if field.sort == "descending" || field.sort == "valueDescending" {
+                children.reverse();
+            }
+        }
+        for child in children {
+            let mut next = prefix.clone();
+            next.push(child.clone());
+            let parent = depth + 1 < axis.len();
+            let collapsed =
+                field.collapsed.contains(&child) && (parent || (row_axis && pivot.values_on_rows));
+            if collapsed && !parent && row_axis && pivot.values_on_rows {
+                out.push(AxisEntry {
+                    keys: next,
+                    kind: "detail",
+                    function: None,
+                });
+                continue;
+            }
+            let subtotal = parent && field.subtotals && pivot.subtotals_position != "none";
+            let functions: Vec<Option<String>> = if field.subtotal_functions.is_empty() {
+                vec![None]
+            } else {
+                field.subtotal_functions.iter().cloned().map(Some).collect()
+            };
+            if parent
+                && ((row_axis && pivot.layout != "tabular") || subtotal || collapsed)
+                && ((!subtotal && row_axis && pivot.layout != "tabular")
+                    || pivot.subtotals_position == "top"
+                    || collapsed
+                    || (row_axis && pivot.layout != "tabular"))
+            {
+                if (subtotal && pivot.subtotals_position == "top") || collapsed {
+                    for function in &functions {
+                        out.push(AxisEntry {
+                            keys: next.clone(),
+                            kind: "subtotal",
+                            function: function.clone(),
+                        });
+                    }
+                } else {
+                    out.push(AxisEntry {
+                        keys: next.clone(),
+                        kind: "header",
+                        function: None,
+                    });
+                }
+            }
+            if !collapsed {
+                walk(pivot, groups, next.clone(), branches, axis, row_axis, out);
+                if subtotal && pivot.subtotals_position == "bottom" {
+                    for function in &functions {
+                        out.push(AxisEntry {
+                            keys: next.clone(),
+                            kind: "subtotal",
+                            function: function.clone(),
+                        });
+                    }
+                }
+            }
+        }
+    }
+    let mut result = Vec::new();
+    if axis.is_empty() {
+        result.push(AxisEntry {
+            keys: vec![],
+            kind: "detail",
+            function: None,
+        });
+    } else {
+        walk(
+            pivot,
+            groups,
+            vec![],
+            &branches,
+            axis,
+            row_axis,
+            &mut result,
+        );
+        if grand {
+            result.push(AxisEntry {
+                keys: vec![],
+                kind: "grand",
+                function: None,
+            });
+        }
+    }
+    result
+}
+
+type AggregateKey = (Vec<String>, Vec<String>, usize);
+type Aggregates = BTreeMap<AggregateKey, Aggregate>;
+fn aggregate_records(
+    pivot: &PivotTable,
+    records: &[&Vec<PivotValue>],
+    date1904: bool,
+) -> Result<(Aggregates, Vec<Vec<String>>, Vec<Vec<String>>)> {
+    let mut groups = Aggregates::new();
+    let mut row_keys = Vec::new();
+    let mut col_keys = Vec::new();
+    let mut row_seen = BTreeSet::new();
+    let mut col_seen = BTreeSet::new();
+    for record in records {
+        let rows = axis_key(pivot, record, &pivot.rows, date1904);
+        let cols = axis_key(pivot, record, &pivot.columns, date1904);
+        if row_seen.insert(rows.clone()) {
+            row_keys.push(rows.clone());
+        }
+        if col_seen.insert(cols.clone()) {
+            col_keys.push(cols.clone());
+        }
+        for r in 0..=rows.len() {
+            for c in 0..=cols.len() {
+                for (v, data) in pivot.values.iter().enumerate() {
+                    groups
+                        .entry((rows[..r].to_vec(), cols[..c].to_vec(), v))
+                        .or_default()
+                        .add(&record[data.field]);
+                }
+            }
+        }
+        if groups.len() > MAX_GROUPS {
+            return Err(fail("Pivot has too many aggregate groups"));
+        }
+    }
+    Ok((groups, row_keys, col_keys))
+}
+fn numeric(value: &PivotValue) -> Option<f64> {
+    if let PivotValue::Number(n) = value {
+        Some(*n)
+    } else {
+        None
+    }
+}
+fn divide(value: f64, denominator: f64) -> PivotValue {
+    if denominator == 0.0 {
+        PivotValue::Error("#DIV/0!".into())
+    } else {
+        PivotValue::Number(value / denominator)
+    }
+}
+
+struct Expression<'a, F: FnMut(&str) -> PivotValue> {
+    text: &'a [u8],
+    position: usize,
+    lookup: F,
+    validate_only: bool,
+}
+impl<F: FnMut(&str) -> PivotValue> Expression<'_, F> {
+    fn space(&mut self) {
+        while self
+            .text
+            .get(self.position)
+            .is_some_and(|c| c.is_ascii_whitespace())
+        {
+            self.position += 1;
+        }
+    }
+    fn take(&mut self, c: u8) -> bool {
+        self.space();
+        if self.text.get(self.position) == Some(&c) {
+            self.position += 1;
+            true
+        } else {
+            false
+        }
+    }
+    fn expression(&mut self) -> Result<f64> {
+        let mut value = self.product()?;
+        loop {
+            if self.take(b'+') {
+                value += self.product()?;
+            } else if self.take(b'-') {
+                value -= self.product()?;
+            } else {
+                break;
+            }
+        }
+        Ok(value)
+    }
+    fn product(&mut self) -> Result<f64> {
+        let mut value = self.power()?;
+        loop {
+            if self.take(b'*') {
+                value *= self.power()?;
+            } else if self.take(b'/') {
+                let divisor = self.power()?;
+                if divisor == 0.0 && !self.validate_only {
+                    return Err(fail("#DIV/0!"));
+                }
+                value /= divisor;
+            } else {
+                break;
+            }
+        }
+        Ok(value)
+    }
+    fn power(&mut self) -> Result<f64> {
+        let mut value = self.atom()?;
+        if self.take(b'^') {
+            value = value.powf(self.power()?);
+        }
+        if self.take(b'%') {
+            value /= 100.0;
+        }
+        Ok(value)
+    }
+    fn atom(&mut self) -> Result<f64> {
+        self.space();
+        if self.take(b'+') {
+            return self.atom();
+        }
+        if self.take(b'-') {
+            return Ok(-self.atom()?);
+        }
+        if self.take(b'(') {
+            let value = self.expression()?;
+            if !self.take(b')') {
+                return Err(fail("Unclosed calculated pivot expression"));
+            }
+            return Ok(value);
+        }
+        let start = self.position;
+        if self
+            .text
+            .get(start)
+            .is_some_and(|c| c.is_ascii_digit() || *c == b'.')
+        {
+            while self
+                .text
+                .get(self.position)
+                .is_some_and(|c| c.is_ascii_digit() || *c == b'.')
+            {
+                self.position += 1;
+            }
+            if self
+                .text
+                .get(self.position)
+                .is_some_and(|c| *c == b'e' || *c == b'E')
+            {
+                self.position += 1;
+                if self
+                    .text
+                    .get(self.position)
+                    .is_some_and(|c| *c == b'+' || *c == b'-')
+                {
+                    self.position += 1;
+                }
+                while self
+                    .text
+                    .get(self.position)
+                    .is_some_and(|c| c.is_ascii_digit())
+                {
+                    self.position += 1;
+                }
+            }
+            return std::str::from_utf8(&self.text[start..self.position])
+                .unwrap_or("")
+                .parse()
+                .map_err(|_| fail("Invalid calculated pivot number"));
+        }
+        let name =
+            if self.take(b'\'') {
+                let mut name = String::new();
+                loop {
+                    let start = self.position;
+                    while self.text.get(self.position).is_some_and(|c| *c != b'\'') {
+                        self.position += 1;
+                    }
+                    name.push_str(
+                        std::str::from_utf8(&self.text[start..self.position])
+                            .map_err(|_| fail("Invalid pivot expression"))?,
+                    );
+                    if self.position == self.text.len() {
+                        return Err(fail("Unclosed pivot field name"));
+                    }
+                    self.position += 1;
+                    if self.text.get(self.position) == Some(&b'\'') {
+                        name.push('\'');
+                        self.position += 1;
+                    } else {
+                        break;
+                    }
+                }
+                name
+            } else if self.take(b'[') {
+                let start = self.position;
+                while self.text.get(self.position).is_some_and(|c| *c != b']') {
+                    self.position += 1;
+                }
+                let name = String::from_utf8_lossy(&self.text[start..self.position]).to_string();
+                if !self.take(b']') {
+                    return Err(fail("Unclosed pivot field name"));
+                }
+                name
+            } else {
+                while self.text.get(self.position).is_some_and(|c| {
+                    c.is_ascii_alphanumeric() || *c == b'_' || *c == b'.' || *c >= 128
+                }) {
+                    self.position += 1;
+                }
+                if self.position == start {
+                    return Err(fail("Unsupported calculated pivot expression"));
+                }
+                String::from_utf8_lossy(&self.text[start..self.position]).to_string()
+            };
+        let name = if self.take(b'[') {
+            let start = self.position;
+            while self.text.get(self.position).is_some_and(|c| *c != b']') {
+                self.position += 1;
+            }
+            let item = String::from_utf8_lossy(&self.text[start..self.position])
+                .trim_matches('\'')
+                .to_string();
+            if !self.take(b']') {
+                return Err(fail("Unclosed pivot item name"));
+            }
+            item
+        } else {
+            name
+        };
+        if self.take(b'(') {
+            let mut args = Vec::new();
+            if !self.take(b')') {
+                loop {
+                    args.push(self.expression()?);
+                    if self.take(b')') {
+                        break;
+                    }
+                    if !self.take(b',') {
+                        return Err(fail("Invalid pivot function arguments"));
+                    }
+                }
+            }
+            return match name.to_ascii_uppercase().as_str() {
+                "SUM" => Ok(args.iter().sum()),
+                "PRODUCT" => Ok(args.iter().product()),
+                "AVERAGE" if !args.is_empty() => Ok(args.iter().sum::<f64>() / args.len() as f64),
+                "MIN" if !args.is_empty() => Ok(args.into_iter().fold(f64::INFINITY, f64::min)),
+                "MAX" if !args.is_empty() => Ok(args.into_iter().fold(f64::NEG_INFINITY, f64::max)),
+                "ABS" if args.len() == 1 => Ok(args[0].abs()),
+                "ROUND" if args.len() == 2 => {
+                    let scale = 10.0_f64.powf(args[1]);
+                    Ok((args[0] * scale).round() / scale)
+                }
+                "SQRT" if args.len() == 1 => Ok(args[0].sqrt()),
+                _ => Err(fail(format!(
+                    "Unsupported calculated pivot function: {name}"
+                ))),
+            };
+        }
+        match (self.lookup)(&name) {
+            PivotValue::Number(n) => Ok(n),
+            PivotValue::Boolean(v) => Ok(if v { 1.0 } else { 0.0 }),
+            PivotValue::Blank => Ok(0.0),
+            PivotValue::Error(e) => Err(fail(e)),
+            _ => Err(fail("#VALUE!")),
+        }
+    }
+}
+fn validate_formula(formula: &str) -> Result<()> {
+    let text = formula.trim().trim_start_matches('=');
+    let mut parser = Expression {
+        text: text.as_bytes(),
+        position: 0,
+        lookup: |_: &str| PivotValue::Number(1.0),
+        validate_only: true,
+    };
+    parser.expression()?;
+    parser.space();
+    if parser.position != parser.text.len() {
+        return Err(fail("Unsupported calculated pivot expression"));
+    }
+    Ok(())
+}
+
+fn evaluate_formula(formula: &str, lookup: impl FnMut(&str) -> PivotValue) -> PivotValue {
+    let text = formula.trim().trim_start_matches('=');
+    let mut parser = Expression {
+        text: text.as_bytes(),
+        position: 0,
+        lookup,
+        validate_only: false,
+    };
+    let result = parser.expression();
+    parser.space();
+    match result {
+        Ok(n) if parser.position == parser.text.len() && n.is_finite() => PivotValue::Number(n),
+        Ok(_) => PivotValue::Error("#VALUE!".into()),
+        Err(error) => PivotValue::Error(
+            CellError::parse(&error.to_string())
+                .unwrap_or(CellError::Value)
+                .to_string(),
+        ),
+    }
+}
+
+fn raw_value(
+    pivot: &PivotTable,
+    groups: &Aggregates,
+    rows: &[String],
+    cols: &[String],
+    measure: usize,
+    aggregation: Option<&str>,
+) -> PivotValue {
+    raw_value_depth(pivot, groups, rows, cols, measure, aggregation, 0, true)
+}
+fn raw_value_depth(
+    pivot: &PivotTable,
+    groups: &Aggregates,
+    rows: &[String],
+    cols: &[String],
+    measure: usize,
+    aggregation: Option<&str>,
+    depth: usize,
+    respect_filters: bool,
+) -> PivotValue {
+    if depth > 32 {
+        return PivotValue::Error("#REF!".into());
+    }
+    let data = pivot.values.get(measure);
+    if let Some(formula) = data.and_then(|data| data.formula.as_deref()) {
+        return evaluate_formula(formula, |name| {
+            if let Some(field) = pivot
+                .fields
+                .iter()
+                .find(|field| field.name.eq_ignore_ascii_case(name))
+            {
+                raw_value_depth(
+                    pivot,
+                    groups,
+                    rows,
+                    cols,
+                    pivot.values.len() + field.index,
+                    Some("sum"),
+                    depth + 1,
+                    respect_filters,
+                )
+            } else if let Some(index) = pivot.values.iter().position(|data| {
+                data.formula.is_some()
+                    && data
+                        .source_name
+                        .as_deref()
+                        .unwrap_or(&data.name)
+                        .eq_ignore_ascii_case(name)
+            }) {
+                raw_value_depth(
+                    pivot,
+                    groups,
+                    rows,
+                    cols,
+                    index,
+                    Some("sum"),
+                    depth + 1,
+                    respect_filters,
+                )
+            } else {
+                PivotValue::Error("#NAME?".into())
+            }
+        });
+    }
+    for (axis, keys, is_row) in [(&pivot.rows, rows, true), (&pivot.columns, cols, false)] {
+        for (position, key) in keys.iter().enumerate() {
+            if let Some(item) = pivot.calculated_items.iter().find(|item| {
+                item.field == axis[position].field
+                    && key == &PivotValue::Text(item.name.clone()).key()
+            }) {
+                return evaluate_formula(&item.formula, |name| {
+                    let source = &pivot.fields[item.field];
+                    let member = source
+                        .items
+                        .iter()
+                        .find(|member| member.caption.eq_ignore_ascii_case(name))
+                        .map(|member| member.key.clone())
+                        .or_else(|| {
+                            pivot
+                                .calculated_items
+                                .iter()
+                                .find(|item2| {
+                                    item2.field == item.field
+                                        && item2.name.eq_ignore_ascii_case(name)
+                                })
+                                .map(|item| PivotValue::Text(item.name.clone()).key())
+                        });
+                    let Some(member) = member else {
+                        return PivotValue::Error("#NAME?".into());
+                    };
+                    let mut changed = keys.to_vec();
+                    changed[position] = member;
+                    if is_row {
+                        raw_value_depth(
+                            pivot,
+                            groups,
+                            &changed,
+                            cols,
+                            measure,
+                            aggregation,
+                            depth + 1,
+                            respect_filters,
+                        )
+                    } else {
+                        raw_value_depth(
+                            pivot,
+                            groups,
+                            rows,
+                            &changed,
+                            measure,
+                            aggregation,
+                            depth + 1,
+                            respect_filters,
+                        )
+                    }
+                });
+            }
+        }
+    }
+    let aggregation =
+        aggregation.unwrap_or_else(|| data.map(|data| data.aggregation.as_str()).unwrap_or("sum"));
+    for (axis, keys, other, is_row) in [
+        (&pivot.rows, rows, cols, true),
+        (&pivot.columns, cols, rows, false),
+    ] {
+        if let Some(position) = axis
+            .iter()
+            .enumerate()
+            .skip(keys.len())
+            .find(|(_, axis)| {
+                pivot
+                    .calculated_items
+                    .iter()
+                    .any(|item| item.field == axis.field)
+            })
+            .map(|(index, _)| index)
+        {
+            let paths =
+                calculated_paths(pivot, groups, axis, keys, other, is_row, measure, position);
+            let mut values = Vec::new();
+            for path in paths {
+                if respect_filters
+                    && !calculated_member_allowed(pivot, groups, axis, &path, is_row, depth + 1)
+                {
+                    continue;
+                }
+                let value = if is_row {
+                    raw_value_depth(
+                        pivot,
+                        groups,
+                        &path,
+                        cols,
+                        measure,
+                        Some(aggregation),
+                        depth + 1,
+                        respect_filters,
+                    )
+                } else {
+                    raw_value_depth(
+                        pivot,
+                        groups,
+                        rows,
+                        &path,
+                        measure,
+                        Some(aggregation),
+                        depth + 1,
+                        respect_filters,
+                    )
+                };
+                match value {
+                    PivotValue::Number(value) => values.push(value),
+                    PivotValue::Error(_) => return value,
+                    _ => {}
+                }
+            }
+            if values.is_empty() {
+                return PivotValue::Blank;
+            }
+            return PivotValue::Number(match aggregation {
+                "min" => values.into_iter().fold(f64::INFINITY, f64::min),
+                "max" => values.into_iter().fold(f64::NEG_INFINITY, f64::max),
+                "product" => values.into_iter().product(),
+                _ => values.into_iter().sum(),
+            });
+        }
+    }
+    groups
+        .get(&(rows.to_vec(), cols.to_vec(), measure))
+        .map(|aggregate| aggregate.value(aggregation))
+        .unwrap_or(PivotValue::Blank)
+}
+
+type SiblingIndex = BTreeMap<(bool, usize, Vec<String>, Vec<String>), Vec<String>>;
+type TransformCache = BTreeMap<
+    (
+        usize,
+        Option<String>,
+        bool,
+        Vec<String>,
+        Vec<String>,
+        Vec<String>,
+    ),
+    BTreeMap<String, PivotValue>,
+>;
+fn sibling_index(rows: &[AxisEntry], cols: &[AxisEntry]) -> SiblingIndex {
+    let mut index = SiblingIndex::new();
+    let mut seen = BTreeSet::new();
+    for (is_row, entries) in [(true, rows), (false, cols)] {
+        for entry in entries {
+            for axis in 0..entry.keys.len() {
+                let key = (
+                    is_row,
+                    axis,
+                    entry.keys[..axis].to_vec(),
+                    entry.keys[axis + 1..].to_vec(),
+                );
+                let member = entry.keys[axis].clone();
+                if seen.insert((key.clone(), member.clone())) {
+                    index.entry(key).or_default().push(member);
+                }
+            }
+        }
+    }
+    index
+}
+fn transformed(
+    pivot: &PivotTable,
+    groups: &Aggregates,
+    rows: &[String],
+    cols: &[String],
+    measure: usize,
+    siblings: &SiblingIndex,
+    cache: &mut TransformCache,
+    aggregation: Option<&str>,
+) -> PivotValue {
+    let data = &pivot.values[measure];
+    let value = raw_value(pivot, groups, rows, cols, measure, aggregation);
+    if data.show_as == "normal" {
+        return value;
+    }
+    let Some(number) = numeric(&value) else {
+        return value;
+    };
+    let get = |r: &[String], c: &[String]| {
+        numeric(&raw_value(pivot, groups, r, c, measure, aggregation)).unwrap_or(0.0)
+    };
+    match data.show_as.as_str() {
+        "percentOfGrandTotal" => divide(number, get(&[], &[])),
+        "percentOfRowTotal" => divide(number, get(rows, &[])),
+        "percentOfColumnTotal" => divide(number, get(&[], cols)),
+        "percentOfParentRowTotal" => {
+            divide(number, get(&rows[..rows.len().saturating_sub(1)], cols))
+        }
+        "percentOfParentColumnTotal" => {
+            divide(number, get(rows, &cols[..cols.len().saturating_sub(1)]))
+        }
+        "index" => divide(number * get(&[], &[]), get(rows, &[]) * get(&[], cols)),
+        _ => {
+            let Some(field) = data.base_field else {
+                return PivotValue::Error("#REF!".into());
+            };
+            let (axis, keys, other, is_row) = if let Some(axis) =
+                pivot.rows.iter().position(|axis| {
+                    axis.field == field
+                        && data.base_grouping_unit.as_deref().is_none_or(|unit| {
+                            axis.grouping
+                                .as_ref()
+                                .is_some_and(|group| group.unit == unit || group.kind == unit)
+                        })
+                }) {
+                (axis, rows, cols, true)
+            } else if let Some(axis) = pivot.columns.iter().position(|axis| {
+                axis.field == field
+                    && data.base_grouping_unit.as_deref().is_none_or(|unit| {
+                        axis.grouping
+                            .as_ref()
+                            .is_some_and(|group| group.unit == unit || group.kind == unit)
+                    })
+            }) {
+                (axis, cols, rows, false)
+            } else {
+                return PivotValue::Error("#REF!".into());
+            };
+            if axis >= keys.len() {
+                return PivotValue::Blank;
+            }
+            let prefix = keys[..axis].to_vec();
+            let suffix = keys[axis + 1..].to_vec();
+            let context = (
+                measure,
+                aggregation.map(str::to_string),
+                is_row,
+                prefix.clone(),
+                suffix.clone(),
+                other.to_vec(),
+            );
+            if let Some(values) = cache.get(&context) {
+                return values
+                    .get(&keys[axis])
+                    .cloned()
+                    .unwrap_or(PivotValue::Blank);
+            }
+            let Some(members) = siblings.get(&(is_row, axis, prefix, suffix)) else {
+                return PivotValue::Blank;
+            };
+            let values: Vec<_> = members
+                .iter()
+                .map(|member| {
+                    let mut changed = keys.to_vec();
+                    changed[axis] = member.clone();
+                    if is_row {
+                        get(&changed, cols)
+                    } else {
+                        get(rows, &changed)
+                    }
+                })
+                .collect();
+            let total: f64 = values.iter().sum();
+            let mut running = 0.0;
+            let mut ordered = values.clone();
+            ordered.sort_by(f64::total_cmp);
+            if data.show_as == "rankDescending" {
+                ordered.reverse();
+            }
+            let mut ranks = BTreeMap::new();
+            for (index, value) in ordered.iter().enumerate() {
+                ranks
+                    .entry(if *value == 0.0 {
+                        0.0_f64.to_bits()
+                    } else {
+                        value.to_bits()
+                    })
+                    .or_insert(index + 1);
+            }
+            let base = data.base_item.as_deref().unwrap_or("previous");
+            let fixed = members.iter().position(|key| {
+                key == base
+                    || PivotValue::from_key(key)
+                        .caption()
+                        .eq_ignore_ascii_case(base)
+            });
+            let mut result = BTreeMap::new();
+            for (index, (member, value)) in members.iter().zip(&values).enumerate() {
+                running += value;
+                let transformed = if fixed == Some(index)
+                    && matches!(data.show_as.as_str(), "difference" | "percentDifference")
+                {
+                    PivotValue::Blank
+                } else {
+                    match data.show_as.as_str() {
+                        "runningTotal" => PivotValue::Number(running),
+                        "percentRunningTotal" => divide(running, total),
+                        "rankAscending" | "rankDescending" => PivotValue::Number(
+                            *ranks
+                                .get(&if *value == 0.0 {
+                                    0.0_f64.to_bits()
+                                } else {
+                                    value.to_bits()
+                                })
+                                .unwrap_or(&1) as f64,
+                        ),
+                        _ => {
+                            let reference = match base {
+                                "previous" | "(previous)" => index.checked_sub(1),
+                                "next" | "(next)" => Some(index + 1),
+                                _ => fixed,
+                            }
+                            .and_then(|index| values.get(index));
+                            match reference {
+                                None => PivotValue::Blank,
+                                Some(reference) => match data.show_as.as_str() {
+                                    "difference" => PivotValue::Number(value - reference),
+                                    "percentDifference" => divide(value - reference, *reference),
+                                    "percent" => divide(*value, *reference),
+                                    _ => PivotValue::Number(*value),
+                                },
+                            }
+                        }
+                    }
+                };
+                result.insert(member.clone(), transformed);
+            }
+            let result_value = result
+                .get(&keys[axis])
+                .cloned()
+                .unwrap_or(PivotValue::Blank);
+            cache.insert(context, result);
+            result_value
+        }
+    }
+}
+
+fn extend_calculated_items(
+    pivot: &PivotTable,
+    keys: &mut Vec<Vec<String>>,
+    axis: &[PivotAxisField],
+) {
+    for item in &pivot.calculated_items {
+        let Some(position) = axis.iter().position(|a| a.field == item.field) else {
+            continue;
+        };
+        let mut extra = Vec::new();
+        for key in keys.iter() {
+            let mut changed = key.clone();
+            changed[position] = PivotValue::Text(item.name.clone()).key();
+            if !extra.contains(&changed) && !keys.contains(&changed) {
+                extra.push(changed);
+            }
+        }
+        keys.extend(extra);
+    }
+}
+
+fn render(pivot: &mut PivotTable, date1904: bool) -> Result<()> {
+    let records = filtered_records(pivot, date1904)?;
+    let (mut groups, mut row_keys, mut col_keys) = aggregate_records(pivot, &records, date1904)?;
+    if pivot.values.iter().any(|value| value.formula.is_some()) {
+        for record in &records {
+            let rows = axis_key(pivot, record, &pivot.rows, date1904);
+            let cols = axis_key(pivot, record, &pivot.columns, date1904);
+            for r in 0..=rows.len() {
+                for c in 0..=cols.len() {
+                    for (field, value) in record.iter().enumerate() {
+                        groups
+                            .entry((
+                                rows[..r].to_vec(),
+                                cols[..c].to_vec(),
+                                pivot.values.len() + field,
+                            ))
+                            .or_default()
+                            .add(value);
+                    }
+                }
+            }
+        }
+    }
+    extend_calculated_items(pivot, &mut row_keys, &pivot.rows);
+    extend_calculated_items(pivot, &mut col_keys, &pivot.columns);
+    expand_empty_combinations(pivot, &mut row_keys, &pivot.rows, date1904)?;
+    expand_empty_combinations(pivot, &mut col_keys, &pivot.columns, date1904)?;
+    row_keys.retain(|path| {
+        pivot.rows.iter().enumerate().all(|(position, axis)| {
+            !pivot
+                .calculated_items
+                .iter()
+                .any(|item| item.field == axis.field)
+                || calculated_member_allowed(
+                    pivot,
+                    &groups,
+                    &pivot.rows,
+                    &path[..=position],
+                    true,
+                    0,
+                )
+        })
+    });
+    col_keys.retain(|path| {
+        pivot.columns.iter().enumerate().all(|(position, axis)| {
+            !pivot
+                .calculated_items
+                .iter()
+                .any(|item| item.field == axis.field)
+                || calculated_member_allowed(
+                    pivot,
+                    &groups,
+                    &pivot.columns,
+                    &path[..=position],
+                    false,
+                    0,
+                )
+        })
+    });
+    let rows = axis_entries(
+        pivot,
+        &groups,
+        &row_keys,
+        &pivot.rows,
+        true,
+        pivot.column_grand_totals,
+    );
+    let cols = axis_entries(
+        pivot,
+        &groups,
+        &col_keys,
+        &pivot.columns,
+        false,
+        pivot.row_grand_totals,
+    );
+    let siblings = sibling_index(&rows, &cols);
+    let mut transform_cache = TransformCache::new();
+    let origin = CellAddress::parse(&pivot.target.cell)?;
+    let values_on_rows = pivot.values_on_rows && !pivot.values.is_empty();
+    let compact_values = values_on_rows && pivot.layout == "compact";
+    let mut row_slots = Vec::<(usize, Option<usize>, bool)>::new();
+    for (index, row) in rows.iter().enumerate() {
+        if values_on_rows {
+            if row.kind == "header" {
+                row_slots.push((index, None, true));
+                continue;
+            }
+            if compact_values && row.kind == "detail" && !row.keys.is_empty() {
+                row_slots.push((index, None, true));
+                if pivot
+                    .rows
+                    .get(row.keys.len() - 1)
+                    .is_some_and(|axis| axis.collapsed.contains(row.keys.last().unwrap()))
+                {
+                    continue;
+                }
+            }
+            for measure in 0..pivot.values.len() {
+                row_slots.push((index, Some(measure), false));
+            }
+        } else {
+            row_slots.push((index, None, row.kind == "header"));
+        }
+    }
+    let column_multiplier = if values_on_rows {
+        1
+    } else {
+        pivot.values.len().max(1)
+    };
+    let row_width = (if pivot.layout == "compact" {
+        1
+    } else {
+        pivot.rows.len().max(1)
+    }) + usize::from(values_on_rows && !compact_values);
+    let column_depth = pivot.columns.len().max(1);
+    let leading_values_header =
+        !values_on_rows && pivot.values.len() > 1 && pivot.columns.is_empty();
+    let header_height = column_depth + usize::from(!values_on_rows && pivot.values.len() > 1);
+    let page_height = if pivot.report_filters.is_empty() {
+        0
+    } else {
+        pivot.report_filters.len() + 1
+    };
+    let width =
+        (row_width + cols.len() * column_multiplier).max(if pivot.report_filters.is_empty() {
+            1
+        } else {
+            2
+        });
+    let height = page_height + header_height + row_slots.len().max(1);
+    if width
+        .checked_mul(height)
+        .is_none_or(|cells| cells > MAX_OUTPUT_CELLS)
+        || origin.row as usize + height > crate::MAX_ROWS as usize
+        || origin.col as usize + width > crate::MAX_COLS as usize
+    {
+        return Err(fail("Pivot output exceeds the supported worksheet limits"));
+    }
+    let mut output = Vec::new();
+    let mut push = |r: usize,
+                    c: usize,
+                    value: PivotValue,
+                    kind: &str,
+                    row_keys: Vec<String>,
+                    column_keys: Vec<String>,
+                    measure: Option<usize>| {
+        output.push(PivotOutputCell {
+            row: origin.row + r as u32,
+            col: origin.col + c as u16,
+            value,
+            kind: kind.into(),
+            row_keys,
+            column_keys,
+            measure,
+            subtotal_function: None,
+        });
+    };
+    for (row, field) in pivot.report_filters.iter().enumerate() {
+        push(
+            row,
+            0,
+            PivotValue::Text(pivot.fields[*field].name.clone()),
+            "header",
+            vec![],
+            vec![],
+            None,
+        );
+        let label = pivot
+            .filters
+            .iter()
+            .find(|f| f.field == *field && f.kind == "members")
+            .map(|f| {
+                if f.values.len() == 1 {
+                    PivotValue::from_key(&f.values[0]).caption()
+                } else {
+                    "(Multiple Items)".into()
+                }
+            })
+            .unwrap_or_else(|| "(All)".into());
+        push(
+            row,
+            1,
+            PivotValue::Text(label),
+            "label",
+            vec![],
+            vec![],
+            None,
+        );
+    }
+    if pivot.layout == "compact" {
+        push(
+            page_height + header_height - 1,
+            0,
+            PivotValue::Text(
+                if pivot.rows.is_empty() {
+                    "Values"
+                } else {
+                    "Row Labels"
+                }
+                .into(),
+            ),
+            "header",
+            vec![],
+            vec![],
+            None,
+        );
+    } else {
+        for (index, field) in pivot.rows.iter().enumerate() {
+            push(
+                page_height + header_height - 1,
+                index,
+                PivotValue::Text(
+                    field
+                        .name
+                        .clone()
+                        .unwrap_or_else(|| pivot.fields[field.field].name.clone()),
+                ),
+                "header",
+                vec![],
+                vec![],
+                None,
+            );
+        }
+    }
+    if values_on_rows && !compact_values {
+        push(
+            page_height + header_height - 1,
+            row_width - 1,
+            PivotValue::Text("Values".into()),
+            "header",
+            vec![],
+            vec![],
+            None,
+        );
+    }
+    for (ci, column) in cols.iter().enumerate() {
+        for (measure, data) in pivot.values.iter().take(column_multiplier).enumerate() {
+            let col = row_width + ci * column_multiplier + measure;
+            for depth in 0..header_height {
+                let label = if leading_values_header && depth == 0 {
+                    if ci == 0 && measure == 0 {
+                        "Values".into()
+                    } else {
+                        String::new()
+                    }
+                } else if pivot.columns.is_empty() {
+                    data.name.clone()
+                } else if column.kind == "grand" {
+                    if depth == 0 {
+                        if pivot.values.len() == 1 || values_on_rows {
+                            format!("Grand Total")
+                        } else {
+                            "Grand Total".into()
+                        }
+                    } else if depth == header_height - 1
+                        && !values_on_rows
+                        && pivot.values.len() > 1
+                    {
+                        data.name.clone()
+                    } else {
+                        String::new()
+                    }
+                } else if depth < column.keys.len() {
+                    let label = PivotValue::from_key(&column.keys[depth]).caption();
+                    if column.kind == "subtotal" && depth + 1 == column.keys.len() {
+                        format!("{label} {}", column.function.as_deref().unwrap_or("Total"))
+                    } else {
+                        label
+                    }
+                } else if depth == header_height - 1 && !values_on_rows && pivot.values.len() > 1 {
+                    data.name.clone()
+                } else {
+                    String::new()
+                };
+                push(
+                    page_height + depth,
+                    col,
+                    PivotValue::Text(label),
+                    "header",
+                    vec![],
+                    column.keys.clone(),
+                    None,
+                );
+            }
+        }
+    }
+    if pivot.values.is_empty() {
+        for (ci, column) in cols.iter().enumerate() {
+            for (depth, key) in column.keys.iter().enumerate() {
+                push(
+                    page_height + depth,
+                    row_width + ci,
+                    PivotValue::Text(PivotValue::from_key(key).caption()),
+                    "header",
+                    vec![],
+                    column.keys.clone(),
+                    None,
+                );
+            }
+        }
+    }
+    let mut previous: Vec<String> = Vec::new();
+    for (slot, (row_index, measure_slot, label_only)) in row_slots.iter().enumerate() {
+        let row = &rows[*row_index];
+        let measure_row = measure_slot.unwrap_or(0);
+        let r = page_height + header_height + slot;
+        let base_label = if row.kind == "grand" {
+            "Grand Total".into()
+        } else if let Some(key) = row.keys.last() {
+            let label = PivotValue::from_key(key).caption();
+            if row.kind == "subtotal" {
+                format!("{label} {}", subtotal_caption(row.function.as_deref()))
+            } else {
+                label
+            }
+        } else {
+            String::new()
+        };
+        if pivot.layout == "compact" {
+            let (label, kind) = if compact_values && !*label_only {
+                if row.kind == "grand" {
+                    (format!("Total {}", pivot.values[measure_row].name), "grand")
+                } else if row.kind == "subtotal" {
+                    (
+                        format!("{base_label} {}", pivot.values[measure_row].name),
+                        "subtotal",
+                    )
+                } else {
+                    (pivot.values[measure_row].name.clone(), "valueLabel")
+                }
+            } else {
+                (
+                    base_label.clone(),
+                    if compact_values && *label_only {
+                        "groupLabel"
+                    } else {
+                        row.kind
+                    },
+                )
+            };
+            push(
+                r,
+                0,
+                PivotValue::Text(label),
+                kind,
+                row.keys.clone(),
+                vec![],
+                None,
+            );
+        } else {
+            for index in 0..row_width - usize::from(values_on_rows) {
+                let label = if values_on_rows && measure_row > 0 && !pivot.repeat_labels {
+                    String::new()
+                } else if row.kind == "grand" && index == 0 {
+                    "Grand Total".into()
+                } else if index < row.keys.len() {
+                    if index + 1 == row.keys.len() {
+                        base_label.clone()
+                    } else if pivot.repeat_labels || previous.get(index) != row.keys.get(index) {
+                        PivotValue::from_key(&row.keys[index]).caption()
+                    } else {
+                        String::new()
+                    }
+                } else {
+                    String::new()
+                };
+                push(
+                    r,
+                    index,
+                    PivotValue::Text(label),
+                    row.kind,
+                    row.keys.clone(),
+                    vec![],
+                    None,
+                );
+            }
+        }
+        if values_on_rows && !compact_values && !*label_only {
+            push(
+                r,
+                row_width - 1,
+                PivotValue::Text(pivot.values[measure_row].name.clone()),
+                row.kind,
+                row.keys.clone(),
+                vec![],
+                None,
+            );
+        }
+        if !*label_only {
+            for (ci, column) in cols.iter().enumerate() {
+                for measure in if values_on_rows {
+                    measure_row..measure_row + 1
+                } else {
+                    0..pivot.values.len()
+                } {
+                    let value = transformed(
+                        pivot,
+                        &groups,
+                        &row.keys,
+                        &column.keys,
+                        measure,
+                        &siblings,
+                        &mut transform_cache,
+                        row.function.as_deref().or(column.function.as_deref()),
+                    );
+                    push(
+                        r,
+                        row_width
+                            + ci * column_multiplier
+                            + if values_on_rows { 0 } else { measure },
+                        value,
+                        if row.kind == "grand" || column.kind == "grand" {
+                            "grand"
+                        } else if row.kind == "subtotal" || column.kind == "subtotal" {
+                            "subtotal"
+                        } else {
+                            "value"
+                        },
+                        row.keys.clone(),
+                        column.keys.clone(),
+                        Some(measure),
+                    );
+                }
+            }
+        }
+        previous = row.keys.clone();
+    }
+    pivot.output_range = Some(
+        CellRange::new(
+            origin,
+            CellAddress::new(
+                origin.row + height as u32 - 1,
+                origin.col + width as u16 - 1,
+            ),
+        )
+        .to_string(),
+    );
+    for cell in &mut output {
+        if let Some(row) = cell
+            .row
+            .checked_sub(origin.row + page_height as u32 + header_height as u32)
+            .and_then(|index| row_slots.get(index as usize))
+            .and_then(|(index, _, _)| rows.get(*index))
+        {
+            cell.subtotal_function = row.function.clone();
+            if cell.subtotal_function.is_none() && cell.measure.is_some() {
+                let index = (usize::from(cell.col - origin.col).saturating_sub(row_width))
+                    / column_multiplier;
+                cell.subtotal_function = cols.get(index).and_then(|column| column.function.clone());
+            }
+        }
+    }
+    let mut headers = Vec::new();
+    let mut header = |row: usize, col: usize, axis: &str, fields: Vec<PivotHeaderField>| {
+        if fields.is_empty() {
+            return;
+        }
+        let row = origin.row + row as u32;
+        let col = origin.col + col as u16;
+        let caption = output
+            .iter()
+            .find(|cell| cell.row == row && cell.col == col)
+            .map(|cell| cell.value.caption())
+            .unwrap_or_default();
+        headers.push(PivotHeader {
+            row,
+            col,
+            axis: axis.into(),
+            caption,
+            fields,
+        });
+    };
+    for (depth, field) in pivot.report_filters.iter().copied().enumerate() {
+        header(
+            depth,
+            1,
+            "reportFilters",
+            vec![PivotHeaderField {
+                field,
+                depth,
+                name: pivot.fields[field].name.clone(),
+                grouping_unit: None,
+            }],
+        );
+    }
+    let row_header = page_height + header_height - 1;
+    if pivot.layout == "compact" {
+        header(
+            row_header,
+            0,
+            "rows",
+            pivot
+                .rows
+                .iter()
+                .enumerate()
+                .map(|(depth, axis)| pivot_axis_header_field(pivot, axis, depth))
+                .collect(),
+        );
+    } else {
+        for (depth, axis) in pivot.rows.iter().enumerate() {
+            header(
+                row_header,
+                depth,
+                "rows",
+                vec![pivot_axis_header_field(pivot, axis, depth)],
+            );
+        }
+    }
+    if pivot.layout == "compact" {
+        header(
+            page_height,
+            row_width,
+            "columns",
+            pivot
+                .columns
+                .iter()
+                .enumerate()
+                .map(|(depth, axis)| pivot_axis_header_field(pivot, axis, depth))
+                .collect(),
+        );
+    } else {
+        for (depth, axis) in pivot.columns.iter().enumerate() {
+            header(
+                page_height + depth,
+                row_width,
+                "columns",
+                vec![pivot_axis_header_field(pivot, axis, depth)],
+            );
+        }
+    }
+    pivot.headers = headers;
+    pivot.output = output;
+    Ok(())
+}
+
+fn remap_fields(
+    pivot: &mut PivotTable,
+    old: &[PivotSourceField],
+    new: &[PivotSourceField],
+) -> Result<()> {
+    if old.is_empty() || old.iter().map(|f| &f.name).eq(new.iter().map(|f| &f.name)) {
+        return Ok(());
+    }
+    let remap = |index: usize| {
+        old.get(index)
+            .and_then(|field| {
+                new.iter()
+                    .position(|next| next.name.eq_ignore_ascii_case(&field.name))
+            })
+            .ok_or_else(|| fail("Pivot source fields changed; choose the source fields again"))
+    };
+    for axis in pivot.rows.iter_mut().chain(&mut pivot.columns) {
+        axis.field = remap(axis.field)?;
+    }
+    for filter in &mut pivot.filters {
+        filter.field = remap(filter.field)?;
+    }
+    for field in &mut pivot.report_filters {
+        *field = remap(*field)?;
+    }
+    for value in &mut pivot.values {
+        value.field = remap(value.field)?;
+        value.base_field = value.base_field.map(remap).transpose()?;
+    }
+    for item in &mut pivot.calculated_items {
+        item.field = remap(item.field)?;
+    }
+    Ok(())
+}
+fn validate_destination(
+    workbook: &Workbook,
+    pivot: &PivotTable,
+    previous: Option<&PivotTable>,
+) -> Result<()> {
+    let target = sheet_index(workbook, &pivot.target.sheet)?;
+    let sheet = workbook.worksheet(target).unwrap();
+    let range = CellRange::parse(
+        pivot
+            .output_range
+            .as_deref()
+            .ok_or_else(|| fail("Pivot output is missing"))?,
+    )?;
+    if sheet.protection().is_some_and(|p| p.protected) {
+        return Err(fail("Pivot output cannot modify a protected worksheet"));
+    }
+    if let Ok((source_sheet, source_range)) = resolve_pivot_source(workbook, &pivot.source) {
+        if source_sheet == target && intersects(&range, &source_range) {
+            return Err(fail("Pivot output cannot overlap its source data"));
+        }
+    }
+    if sheet
+        .merged_regions()
+        .iter()
+        .any(|merged| intersects(&range, merged))
+    {
+        return Err(fail("Pivot output cannot overlap merged cells"));
+    }
+    if sheet
+        .tables()
+        .iter()
+        .any(|table| intersects(&range, &table.reference))
+    {
+        return Err(fail("Pivot output cannot overlap an Excel table"));
+    }
+    for other in workbook.pivot_tables() {
+        if other.id != pivot.id && other.target.sheet.eq_ignore_ascii_case(&pivot.target.sheet) {
+            if let Some(other_range) = other
+                .output_range
+                .as_deref()
+                .and_then(|range| CellRange::parse(range).ok())
+            {
+                if intersects(&range, &other_range) {
+                    return Err(fail("Pivot output cannot overlap another pivot table"));
+                }
+            }
+        }
+    }
+    let previous_range = previous
+        .filter(|p| p.target.sheet.eq_ignore_ascii_case(&pivot.target.sheet))
+        .and_then(|p| p.output_range.as_deref())
+        .and_then(|range| CellRange::parse(range).ok());
+    for row in range.start.row..=range.end.row {
+        for col in range.start.col..=range.end.col {
+            if previous_range.is_some_and(|old| old.contains(&CellAddress::new(row, col))) {
+                continue;
+            }
+            if !sheet.get_value_at(row, col).is_empty() || sheet.get_formula_at(row, col).is_some()
+            {
+                return Err(fail(format!(
+                    "Pivot output would overwrite {}",
+                    CellAddress::new(row, col)
+                )));
+            }
+        }
+    }
+    Ok(())
+}
+fn apply_output(
+    workbook: &mut Workbook,
+    pivot: &PivotTable,
+    previous: Option<&PivotTable>,
+) -> Result<()> {
+    let target = sheet_index(workbook, &pivot.target.sheet)?;
+    let mut next = workbook.worksheet(target).unwrap().clone();
+    if let Some(previous) =
+        previous.filter(|p| p.target.sheet.eq_ignore_ascii_case(&pivot.target.sheet))
+    {
+        if let Some(range) = previous
+            .output_range
+            .as_deref()
+            .and_then(|range| CellRange::parse(range).ok())
+        {
+            next.clear_range(&range);
+        }
+    }
+    let previous_sheet = previous
+        .and_then(|previous| sheet_index(workbook, &previous.target.sheet).ok())
+        .and_then(|index| workbook.worksheet(index));
+    let mut saved_styles = BTreeMap::new();
+    if pivot.preserve_formatting
+        && previous.is_some_and(|previous| previous.style_name == pivot.style_name)
+    {
+        if let (Some(previous), Some(sheet)) = (previous, previous_sheet) {
+            for cell in &previous.output {
+                if let Some(style) = sheet.cell_style_at(cell.row, cell.col) {
+                    saved_styles.insert(
+                        (
+                            cell.row_keys.clone(),
+                            cell.column_keys.clone(),
+                            cell.measure,
+                            cell.kind.clone(),
+                            cell.subtotal_function.clone(),
+                            cell.measure.is_none().then_some((cell.row, cell.col)),
+                        ),
+                        style.clone(),
+                    );
+                }
+            }
+        }
+    }
+    for cell in &pivot.output {
+        next.set_cell_value_at(cell.row, cell.col, cell.value.to_cell())?;
+        let mut style = saved_styles
+            .get(&(
+                cell.row_keys.clone(),
+                cell.column_keys.clone(),
+                cell.measure,
+                cell.kind.clone(),
+                cell.subtotal_function.clone(),
+                cell.measure.is_none().then_some((cell.row, cell.col)),
+            ))
+            .cloned()
+            .or_else(|| {
+                if pivot.preserve_formatting
+                    && previous.is_some_and(|previous| {
+                        previous.output.is_empty()
+                            && previous.style_name == pivot.style_name
+                            && previous.target == pivot.target
+                    })
+                {
+                    previous_sheet
+                        .and_then(|sheet| sheet.cell_style_at(cell.row, cell.col))
+                        .cloned()
+                } else {
+                    None
+                }
+            })
+            .unwrap_or_else(|| pivot_cell_style(&pivot.style_name, &cell.kind, cell.row));
+        if pivot.layout == "compact" && cell.measure.is_none() && !cell.row_keys.is_empty() {
+            style.alignment.indent = (if cell.kind == "valueLabel" {
+                cell.row_keys.len()
+            } else {
+                cell.row_keys.len().saturating_sub(1)
+            })
+            .min(250) as u8;
+        }
+        if let Some(measure) = cell.measure {
+            let data = &pivot.values[measure];
+            if let Some(format) = &data.number_format {
+                style.number_format = crate::NumberFormat::Custom(format.clone());
+            } else if data.show_as.starts_with("percent")
+                && !(pivot.preserve_formatting
+                    && previous.is_some_and(|previous| {
+                        previous.style_name == pivot.style_name
+                            && previous
+                                .values
+                                .get(measure)
+                                .is_some_and(|old| old.show_as.starts_with("percent"))
+                    }))
+            {
+                style.number_format = crate::NumberFormat::Custom("0.00%".into());
+            }
+        }
+        next.set_cell_style_at(cell.row, cell.col, &style)?;
+    }
+    let previous_sheet = previous
+        .filter(|p| !p.target.sheet.eq_ignore_ascii_case(&pivot.target.sheet))
+        .map(|previous| {
+            let index = sheet_index(workbook, &previous.target.sheet)?;
+            let mut sheet = workbook.worksheet(index).unwrap().clone();
+            if sheet.protection().is_some_and(|p| p.protected) {
+                return Err(fail("Pivot cannot move from a protected worksheet"));
+            }
+            if let Some(range) = previous
+                .output_range
+                .as_deref()
+                .and_then(|range| CellRange::parse(range).ok())
+            {
+                sheet.clear_range(&range);
+            }
+            Ok((index, sheet))
+        })
+        .transpose()?;
+    *workbook.worksheet_mut(target).unwrap() = next;
+    if let Some((index, sheet)) = previous_sheet {
+        *workbook.worksheet_mut(index).unwrap() = sheet;
+    }
+    Ok(())
+}
+
+pub fn upsert_pivot_table(workbook: &mut Workbook, pivot: PivotTable) -> Result<PivotTable> {
+    build_pivot_table(workbook, pivot, false)
+}
+fn build_pivot_table(
+    workbook: &mut Workbook,
+    mut pivot: PivotTable,
+    refresh_source: bool,
+) -> Result<PivotTable> {
+    let previous = workbook
+        .pivot_tables()
+        .iter()
+        .find(|p| !pivot.id.is_empty() && p.id == pivot.id)
+        .cloned();
+    if !refresh_source
+        && previous.as_ref().is_some_and(|previous| {
+            previous.source == pivot.source
+                && previous.cache.is_empty()
+                && previous.output.is_empty()
+        })
+    {
+        return Err(fail("Pivot cache records are unavailable; refresh from the source before editing this pivot"));
+    }
+    if previous
+        .as_ref()
+        .is_some_and(|p| !p.unsupported_features.is_empty())
+        || !pivot.unsupported_features.is_empty()
+    {
+        return Err(fail(
+            "This pivot contains unsupported features and can only be preserved without editing",
+        ));
+    }
+    if pivot.name.trim().is_empty() {
+        let mut n = 1;
+        while workbook
+            .pivot_tables()
+            .iter()
+            .any(|p| p.name.eq_ignore_ascii_case(&format!("PivotTable{n}")))
+        {
+            n += 1;
+        }
+        pivot.name = format!("PivotTable{n}");
+    }
+    if pivot.id.is_empty() {
+        pivot.id = pivot.name.clone();
+        let mut n = 1;
+        while workbook.pivot_tables().iter().any(|p| p.id == pivot.id) {
+            pivot.id = format!("{}-{n}", pivot.name);
+            n += 1;
+        }
+    }
+    if workbook.pivot_tables().iter().any(|p| {
+        p.id != pivot.id
+            && p.target.sheet.eq_ignore_ascii_case(&pivot.target.sheet)
+            && p.name.eq_ignore_ascii_case(&pivot.name)
+    }) {
+        return Err(fail("Pivot table names must be unique within a worksheet"));
+    }
+    if pivot
+        .name
+        .chars()
+        .any(|c| c.is_whitespace() || "[]:*?/\\".contains(c))
+    {
+        return Err(fail(
+            "Pivot table names cannot contain spaces or reserved characters",
+        ));
+    }
+    let (fields, cache) = if let Some(previous) = previous
+        .as_ref()
+        .filter(|previous| !refresh_source && previous.source == pivot.source)
+    {
+        (previous.fields.clone(), previous.cache.clone())
+    } else {
+        read_pivot_source(workbook, &pivot.source)?
+    };
+    let old = if pivot.fields.is_empty() {
+        previous
+            .as_ref()
+            .map(|p| p.fields.clone())
+            .unwrap_or_default()
+    } else {
+        pivot.fields.clone()
+    };
+    remap_fields(&mut pivot, &old, &fields)?;
+    pivot.fields = fields;
+    pivot.cache = cache;
+    if pivot.target.sheet.is_empty() {
+        pivot.target.sheet = pivot.source.sheet.clone();
+    }
+    sheet_index(workbook, &pivot.target.sheet)?;
+    CellAddress::parse(&pivot.target.cell)?;
+    normalize(&mut pivot)?;
+    populate_axis_items(&mut pivot, workbook.settings().date_1904);
+    render(&mut pivot, workbook.settings().date_1904)?;
+    validate_destination(workbook, &pivot, previous.as_ref())?;
+    apply_output(workbook, &pivot, previous.as_ref())?;
+    pivot.charts = previous
+        .as_ref()
+        .map(|p| p.charts.clone())
+        .unwrap_or_default();
+    crate::pivot_chart::sync_pivot_charts(workbook, &pivot);
+    pivot.dirty = true;
+
+    if let Some(previous) = previous {
+        pivot.preserved_parts = previous.preserved_parts;
+        let index = workbook
+            .pivot_tables()
+            .iter()
+            .position(|p| p.id == pivot.id)
+            .unwrap();
+        workbook.pivot_tables_mut()[index] = pivot.clone();
+    } else {
+        workbook.pivot_tables_mut().push(pivot.clone());
+    }
+    workbook.invalidate_pivot_calculations();
+    Ok(pivot)
+}
+pub fn refresh_pivot_table(workbook: &mut Workbook, id: &str) -> Result<PivotTable> {
+    let pivot = workbook
+        .pivot_tables()
+        .iter()
+        .find(|p| p.id == id)
+        .cloned()
+        .ok_or_else(|| fail("Pivot table not found"))?;
+    build_pivot_table(workbook, pivot, true)
+}
+pub fn remove_pivot_table(workbook: &mut Workbook, id: &str) -> Result<()> {
+    let index = workbook
+        .pivot_tables()
+        .iter()
+        .position(|p| p.id == id)
+        .ok_or_else(|| fail("Pivot table not found"))?;
+    let pivot = &workbook.pivot_tables()[index];
+    let sheet = sheet_index(workbook, &pivot.target.sheet)?;
+    if workbook
+        .worksheet(sheet)
+        .unwrap()
+        .protection()
+        .is_some_and(|p| p.protected)
+    {
+        return Err(fail("Cannot remove a pivot from a protected worksheet"));
+    }
+    let range = pivot
+        .output_range
+        .as_deref()
+        .and_then(|r| CellRange::parse(r).ok());
+    if let Some(range) = range {
+        workbook.worksheet_mut(sheet).unwrap().clear_range(&range);
+    }
+    let removed = workbook.pivot_tables()[index].clone();
+    crate::pivot_chart::detach_pivot_charts(workbook, &removed);
+    workbook.pivot_tables_mut().remove(index);
+    workbook.invalidate_pivot_calculations();
+    Ok(())
+}
+pub fn pivot_drill_down(
+    workbook: &Workbook,
+    id: &str,
+    row: u32,
+    col: u16,
+) -> Result<PivotDrillDown> {
+    let pivot = workbook
+        .pivot_tables()
+        .iter()
+        .find(|p| p.id == id)
+        .ok_or_else(|| fail("Pivot table not found"))?;
+    let output = pivot
+        .output
+        .iter()
+        .find(|cell| cell.row == row && cell.col == col && cell.measure.is_some())
+        .ok_or_else(|| fail("Select a pivot value to show its source records"))?;
+    if !pivot.calculated_items.is_empty() {
+        return Err(fail("Drilldown of calculated items is unavailable"));
+    }
+    let rows = filtered_records(pivot, workbook.settings().date_1904)?
+        .into_iter()
+        .filter(|record| {
+            axis_key(pivot, record, &pivot.rows, workbook.settings().date_1904)
+                .starts_with(&output.row_keys)
+                && axis_key(pivot, record, &pivot.columns, workbook.settings().date_1904)
+                    .starts_with(&output.column_keys)
+        })
+        .cloned()
+        .collect();
+    Ok(PivotDrillDown {
+        fields: pivot.fields.iter().map(|f| f.name.clone()).collect(),
+        rows,
+    })
+}
