+fn pivot_reference_source(
+    expr: &FormulaExpr,
+    ctx: &EvaluationContext,
+    depth: usize,
+) -> Result<RangeSource, CellError> {
+    if depth >= 64 {
+        return Err(CellError::Ref);
+    }
+    let workbook = ctx.workbook.ok_or(CellError::Ref)?;
+    let sheet_index = |name: Option<&str>| match name {
+        Some(name) => workbook.worksheets().position(|sheet| sheet.name().eq_ignore_ascii_case(name))
+            .ok_or(CellError::Ref),
+        None => Ok(ctx.current_sheet),
+    };
+    let source = match expr {
+        FormulaExpr::CellRef(reference) => RangeSource {
+            sheet: sheet_index(reference.sheet.as_deref())?,
+            start_row: reference.address.row,
+            start_col: reference.address.col,
+            end_row: reference.address.row,
+            end_col: reference.address.col,
+        },
+        FormulaExpr::RangeRef(reference) => RangeSource {
+            sheet: sheet_index(reference.sheet.as_deref())?,
+            start_row: reference.range.start.row,
+            start_col: reference.range.start.col,
+            end_row: reference.range.end.row,
+            end_col: reference.range.end.col,
+        },
+        FormulaExpr::NameRef(name) => {
+            let named = workbook
+                .get_named_range(name, ctx.current_sheet)
+                .ok_or(CellError::Ref)?;
+            let ast = crate::parser::parse_formula(&format!(
+                "={}",
+                named.refers_to.trim_start_matches('=')
+            ))
+            .map_err(|_| CellError::Ref)?;
+            return pivot_reference_source(&ast, ctx, depth + 1);
+        }
+        FormulaExpr::Function { name, args } if name.eq_ignore_ascii_case("INDIRECT") => {
+            if !(1..=2).contains(&args.len()) {
+                return Err(CellError::Value);
+            }
+            let text =
+                evaluate(args.first().ok_or(CellError::Value)?, ctx).map_err(|_| CellError::Ref)?;
+            if let FormulaValue::Error(error) = text {
+                return Err(error);
+            }
+            if let Some(a1) = args.get(1) {
+                let a1 = evaluate(a1, ctx).map_err(|_| CellError::Value)?;
+                if let FormulaValue::Error(error) = a1 {
+                    return Err(error);
+                }
+                if !a1.as_bool().unwrap_or(false) {
+                    return Err(CellError::Ref);
+                }
+            }
+            let ast = crate::parser::parse_formula(&format!("={}", text.as_string()))
+                .map_err(|_| CellError::Ref)?;
+            return pivot_reference_source(&ast, ctx, depth + 1);
+        }
+        FormulaExpr::Function { name, args } if name.eq_ignore_ascii_case("OFFSET") => {
+            if !(3..=5).contains(&args.len()) {
+                return Err(CellError::Value);
+            }
+            let base =
+                pivot_reference_source(args.first().ok_or(CellError::Value)?, ctx, depth + 1)?;
+            let number = |position: usize, default: Option<i64>| -> Result<i64, CellError> {
+                match args.get(position) {
+                    None | Some(FormulaExpr::Empty) => default.ok_or(CellError::Value),
+                    Some(arg) => match evaluate(arg, ctx).map_err(|_| CellError::Value)? {
+                        FormulaValue::Error(error) => Err(error),
+                        value => value
+                            .as_number()
+                            .filter(|n| n.is_finite())
+                            .map(|n| n.trunc() as i64)
+                            .ok_or(CellError::Value),
+                    },
+                }
+            };
+            let start_row = i64::from(base.start_row)
+                .checked_add(number(1, None)?)
+                .ok_or(CellError::Ref)?;
+            let start_col = i64::from(base.start_col)
+                .checked_add(number(2, None)?)
+                .ok_or(CellError::Ref)?;
+            let height = number(3, Some(i64::from(base.end_row - base.start_row + 1)))?;
+            let width = number(4, Some(i64::from(base.end_col - base.start_col + 1)))?;
+            if height < 1 || width < 1 {
+                return Err(CellError::Ref);
+            }
+            let end_row = start_row.checked_add(height - 1).ok_or(CellError::Ref)?;
+            let end_col = start_col.checked_add(width - 1).ok_or(CellError::Ref)?;
+            if start_row < 0
+                || start_col < 0
+                || height < 1
+                || width < 1
+                || end_row >= i64::from(MAX_ROWS)
+                || end_col >= i64::from(MAX_COLS)
+            {
+                return Err(CellError::Ref);
+            }
+            RangeSource {
+                sheet: base.sheet,
+                start_row: start_row as u32,
+                start_col: start_col as u16,
+                end_row: end_row as u32,
+                end_col: end_col as u16,
+            }
+        }
+        FormulaExpr::Function { name, args } if name.eq_ignore_ascii_case("INDEX") => {
+            if !(2..=4).contains(&args.len()) {
+                return Err(CellError::Value);
+            }
+            let mut base =
+                pivot_reference_source(args.first().ok_or(CellError::Value)?, ctx, depth + 1)?;
+            let number = |position: usize, default: i64| -> Result<i64, CellError> {
+                match args.get(position) {
+                    None | Some(FormulaExpr::Empty) => Ok(default),
+                    Some(arg) => match evaluate(arg, ctx).map_err(|_| CellError::Value)? {
+                        FormulaValue::Error(error) => Err(error),
+                        value => value
+                            .as_number()
+                            .filter(|n| n.is_finite())
+                            .map(|n| n.trunc() as i64)
+                            .ok_or(CellError::Value),
+                    },
+                }
+            };
+            let mut row = number(1, 0)?;
+            let mut col = number(2, 0)?;
+            if args.len() < 3 {
+                if base.start_row == base.end_row {
+                    col = row;
+                    row = 1;
+                } else if base.start_col == base.end_col {
+                    col = 1;
+                } else {
+                    return Err(CellError::Ref);
+                }
+            }
+            if row < 0
+                || col < 0
+                || row > i64::from(base.end_row - base.start_row + 1)
+                || col > i64::from(base.end_col - base.start_col + 1)
+                || number(3, 1)? != 1
+            {
+                return Err(CellError::Ref);
+            }
+            if row > 0 {
+                base.start_row += row as u32 - 1;
+                base.end_row = base.start_row;
+            }
+            if col > 0 {
+                base.start_col += col as u16 - 1;
+                base.end_col = base.start_col;
+            }
+            base
+        }
+        FormulaExpr::Error(error) => return Err(*error),
+        other => match evaluate(other, ctx).map_err(|_| CellError::Ref)? {
+            FormulaValue::Array {
+                source: Some(source),
+                ..
+            } => source,
+            FormulaValue::Error(error) => return Err(error),
+            _ => return Err(CellError::Ref),
+        },
+    };
+    if source.start_row > source.end_row
+        || source.start_col > source.end_col
+        || source.end_row >= MAX_ROWS
+        || source.end_col >= MAX_COLS
+    {
+        return Err(CellError::Ref);
+    }
+    Ok(source)
+}
+
+fn evaluate_getpivotdata(
+    args: &[FormulaExpr],
+    ctx: &EvaluationContext,
+) -> FormulaResult<FormulaValue> {
+    if args.len() < 2 || args.len() % 2 != 0 {
+        return Ok(FormulaValue::Error(CellError::Value));
+    }
+    let mut values = Vec::with_capacity(args.len());
+    for (index, arg) in args.iter().enumerate() {
+        if index == 1 {
+            let source = match pivot_reference_source(arg, ctx, 0) {
+                Ok(source) => source,
+                Err(error) => return Ok(FormulaValue::Error(error)),
+            };
+            values.push(FormulaValue::Array {
+                data: Vec::new(),
+                source: Some(source),
+            });
+        } else {
+            values.push(evaluate(arg, ctx)?);
+        }
+    }
+    crate::functions::lookup_extra::fn_getpivotdata(&values, ctx)
+}
