+pub(crate) fn preserve_read_failure(workbook: &mut Workbook, error: &XlsxError) {
+    let reason = error.to_string();
+    let sheet = workbook
+        .worksheet(0)
+        .map(|s| s.name().to_owned())
+        .unwrap_or_default();
+    let mut pivot = PivotTable::default();
+    pivot.id = "unreadable-pivot-metadata".into();
+    pivot.name = "Unsupported pivot".into();
+    pivot.target.sheet = sheet;
+    pivot.target.cell = "A1".into();
+    pivot
+        .unsupported_features
+        .push(format!("unreadable-metadata: {reason}"));
+    workbook.pivot_tables_mut().push(pivot);
+    let mut state = roundtrip_for(workbook).unwrap_or_default();
+    state.unreadable = Some(reason);
+    register_roundtrip(workbook, state);
+}
