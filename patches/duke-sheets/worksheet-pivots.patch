+fn read_part<R: Read + Seek>(package: &mut OpcPackage<R>, path: &str) -> XlsxResult<Vec<u8>> {
+    let mut data = Vec::new();
+    package
+        .open_zip_name(path)?
+        .take(MAX_PIVOT_PART_BYTES as u64 + 1)
+        .read_to_end(&mut data)?;
+    if data.len() > MAX_PIVOT_PART_BYTES {
+        return Err(XlsxError::InvalidFormat(
+            "Pivot part size limit exceeded".into(),
+        ));
+    }
+    Ok(data)
+}
+
+fn capture_tree<R: Read + Seek>(
+    package: &mut OpcPackage<R>,
+    path: &str,
+    parts: &mut BTreeMap<String, Vec<u8>>,
+) -> XlsxResult<()> {
+    if parts.contains_key(path) {
+        return Ok(());
+    }
+    if parts.len() >= MAX_PIVOT_PARTS {
+        return Err(XlsxError::InvalidFormat(
+            "Pivot relationship limit exceeded".into(),
+        ));
+    }
+    parts.insert(path.into(), read_part(package, path)?);
+    let part = PartName::from_zip_name(path)?;
+    let rels_part = part.relationships_part()?;
+    if package.part_exists(&rels_part) {
+        parts.insert(
+            rels_part.zip_name().into(),
+            read_part(package, rels_part.zip_name())?,
+        );
+    }
+    let rels = package.relationships(&RelationshipSource::Part(part), false)?;
+    for rel in rels.iter() {
+        if let Some(target) = rel.internal_path() {
+            if !target.starts_with("xl/worksheets/") && !target.ends_with("workbook.xml") {
+                capture_tree(package, target, parts)?;
+            }
+        }
+    }
+    Ok(())
+}
+
+fn date_serial(value: &str, date_1904: bool) -> Option<f64> {
+    let date = NaiveDateTime::parse_from_str(value, "%Y-%m-%dT%H:%M:%S%.f")
+        .ok()
+        .or_else(|| {
+            NaiveDate::parse_from_str(value, "%Y-%m-%d")
+                .ok()?
+                .and_hms_opt(0, 0, 0)
+        })?;
+    let base = if date_1904 {
+        NaiveDate::from_ymd_opt(1904, 1, 1)?
+    } else {
+        NaiveDate::from_ymd_opt(1899, 12, 30)?
+    }
+    .and_hms_opt(0, 0, 0)?;
+    Some((date - base).num_milliseconds() as f64 / 86_400_000.0)
+}
+
+fn cache_value(node: &Node, shared: &[PivotValue], date_1904: bool) -> PivotValue {
+    match node.local() {
+        "x" => shared
+            .get(node.num("v"))
+            .cloned()
+            .unwrap_or(PivotValue::Blank),
+        "n" => node
+            .attr("v")
+            .parse::<f64>()
+            .ok()
+            .filter(|n| n.is_finite())
+            .map(PivotValue::Number)
+            .unwrap_or(PivotValue::Blank),
+        "s" => PivotValue::Text(crate::reader::decode_excel_escapes(node.attr("v"))),
+        "b" => PivotValue::Boolean(node.bool("v", false)),
+        "e" => PivotValue::Error(node.attr("v").into()),
+        "d" => date_serial(node.attr("v"), date_1904)
+            .map(PivotValue::Number)
+            .unwrap_or(PivotValue::Blank),
+        _ => PivotValue::Blank,
+    }
+}
+
+fn numeric_format(formats: &BTreeMap<usize, String>, id: usize) -> Option<String> {
+    formats.get(&id).cloned().or_else(|| match id {
+        1 => Some("0".into()),
+        2 => Some("0.00".into()),
+        3 => Some("#,##0".into()),
+        4 => Some("#,##0.00".into()),
+        9 => Some("0%".into()),
+        10 => Some("0.00%".into()),
+        14 => Some("m/d/yy".into()),
+        15 => Some("d-mmm-yy".into()),
+        16 => Some("d-mmm".into()),
+        17 => Some("mmm-yy".into()),
+        20 => Some("h:mm".into()),
+        22 => Some("m/d/yy h:mm".into()),
+        _ => None,
+    })
+}
