+fn date_unit_rank(unit: &str) -> usize {
+    match unit {
+        "seconds" => 0,
+        "minutes" => 1,
+        "hours" => 2,
+        "days" => 3,
+        "months" => 4,
+        "quarters" => 5,
+        "years" => 6,
+        _ => 7,
+    }
+}
+fn serial_date(serial: f64, date1904: bool) -> String {
+    let base = NaiveDate::from_ymd_opt(
+        if date1904 { 1904 } else { 1899 },
+        if date1904 { 1 } else { 12 },
+        if date1904 { 1 } else { 30 },
+    )
+    .unwrap()
+    .and_hms_opt(0, 0, 0)
+    .unwrap();
+    base.checked_add_signed(Duration::seconds((serial * 86400.0).round() as i64))
+        .unwrap_or(base)
+        .format("%Y-%m-%dT%H:%M:%S")
+        .to_string()
+}
+fn range_group_items(
+    axis: &PivotAxisField,
+    start: f64,
+    end: f64,
+    date1904: bool,
+    existing: &[PivotValue],
+) -> Vec<PivotValue> {
+    let group = axis.grouping.as_ref().unwrap();
+    let mut labels = Vec::new();
+    labels.push(format!("<{start}"));
+    if group.kind == "number" {
+        let interval = group.interval.max(f64::EPSILON);
+        let count = ((end - start) / interval).ceil().max(1.0).min(100000.0) as usize;
+        for i in 0..count {
+            let low = start + i as f64 * interval;
+            let high = low + interval;
+            let integer = existing
+                .iter()
+                .map(PivotValue::caption)
+                .any(|s| s.starts_with(&format!("{low}-")));
+            let upper = if i + 1 == count {
+                end
+            } else if integer {
+                high - 1.0
+            } else {
+                high
+            };
+            let variants = [
+                format!("{low}–{high}"),
+                format!("{low}-{}", high - 1.0),
+                format!("{low}-{upper}"),
+            ];
+            labels.push(
+                existing
+                    .iter()
+                    .map(PivotValue::caption)
+                    .find(|v| v.starts_with(&format!("{low}-")) || variants.contains(v))
+                    .unwrap_or_else(|| format!("{low}-{upper}")),
+            );
+        }
+    } else {
+        match group.unit.as_str() {
+            "months" => {
+                let names = [
+                    "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov",
+                    "Dec",
+                ];
+                let named = existing
+                    .iter()
+                    .any(|v| names.contains(&v.caption().as_str()));
+                for i in 1..=12 {
+                    labels.push(if named {
+                        names[i - 1].into()
+                    } else {
+                        format!("{i:02}")
+                    });
+                }
+            }
+            "quarters" => {
+                for i in 1..=4 {
+                    labels.push(format!("Qtr{i}"));
+                }
+            }
+            "hours" => {
+                for i in 0..24 {
+                    labels.push(format!("{i:02}"));
+                }
+            }
+            "minutes" | "seconds" => {
+                for i in 0..60 {
+                    labels.push(format!("{i:02}"));
+                }
+            }
+            "years" => {
+                let first = NaiveDateTime::parse_from_str(
+                    &serial_date(start, date1904),
+                    "%Y-%m-%dT%H:%M:%S",
+                )
+                .unwrap()
+                .year();
+                let last =
+                    NaiveDateTime::parse_from_str(&serial_date(end, date1904), "%Y-%m-%dT%H:%M:%S")
+                        .unwrap()
+                        .year();
+                for year in first..=last {
+                    labels.push(year.to_string());
+                }
+            }
+            _ => {
+                labels.extend(
+                    existing
+                        .iter()
+                        .map(PivotValue::caption)
+                        .filter(|s| !s.starts_with('<') && !s.starts_with('>')),
+                );
+            }
+        }
+    }
+    labels.push(format!(">{end}"));
+    labels.into_iter().map(PivotValue::Text).collect()
+}
