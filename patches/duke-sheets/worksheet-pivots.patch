+use std::collections::BTreeMap;
+
+use crate::pivot::{PivotAxisField, PivotTable, PivotValue};
+use crate::{CellRange, Error, Result, Workbook};
+
+fn invalid() -> Error {
+    Error::other("The requested pivot data is not visible")
+}
+
+fn item_matches(key: &str, item: &PivotValue) -> bool {
+    let member = PivotValue::from_key(key);
+    member == *item || member.caption().eq_ignore_ascii_case(&item.caption())
+}
+
+fn axis_matches(
+    axis: &[PivotAxisField],
+    keys: &[String],
+    requested: &BTreeMap<usize, &PivotValue>,
+) -> bool {
+    let depth = (0..axis.len())
+        .take_while(|position| requested.contains_key(position))
+        .count();
+    keys.len() == depth
+        && !(depth..axis.len()).any(|position| requested.contains_key(&position))
+        && keys.iter().enumerate().all(|(position, key)| {
+            requested.get(&position).is_some_and(|item| {
+                if item_matches(key, item) {
+                    return true;
+                }
+                let Some(group) = &axis[position].grouping else {
+                    return false;
+                };
+                if group.kind != "date" {
+                    return false;
+                }
+                let member = PivotValue::from_key(key).caption();
+                let requested = item.caption();
+                let number = |value: &str| -> Option<f64> {
+                    if let Ok(value) = value.parse::<f64>() {
+                        return Some(value);
+                    }
+                    if group.unit == "quarters" {
+                        return value
+                            .strip_prefix('Q')
+                            .or_else(|| value.strip_prefix('q'))
+                            .and_then(|v| v.parse().ok());
+                    }
+                    if group.unit == "months" {
+                        return [
+                            "january",
+                            "february",
+                            "march",
+                            "april",
+                            "may",
+                            "june",
+                            "july",
+                            "august",
+                            "september",
+                            "october",
+                            "november",
+                            "december",
+                        ]
+                        .iter()
+                        .position(|name| {
+                            name.eq_ignore_ascii_case(value)
+                                || (value.len() == 3 && name[..3].eq_ignore_ascii_case(value))
+                        })
+                        .map(|index| (index + 1) as f64);
+                    }
+                    None
+                };
+                matches!((number(&member), number(&requested)), (Some(a), Some(b)) if a == b)
+            })
+        })
+}
+
+fn report_item_visible(pivot: &PivotTable, field: usize, item: &PivotValue) -> bool {
+    if let Some(filter) = pivot
+        .filters
+        .iter()
+        .find(|filter| filter.field == field && filter.kind == "members")
+    {
+        return filter.values.len() == 1 && item_matches(&filter.values[0], item);
+    }
+    false
+}
+
+pub fn query_pivot_data(
+    workbook: &Workbook,
+    sheet: &str,
+    row: u32,
+    col: u16,
+    data_field: &str,
+    items: &[(String, PivotValue)],
+) -> Result<PivotValue> {
+    let pivot = workbook
+        .pivot_tables()
+        .iter()
+        .rev()
+        .find(|pivot| {
+            pivot.target.sheet.eq_ignore_ascii_case(sheet)
+                && pivot
+                    .output_range
+                    .as_deref()
+                    .and_then(|reference| CellRange::parse(reference).ok())
+                    .is_some_and(|range| {
+                        row >= range.start.row
+                            && row <= range.end.row
+                            && col >= range.start.col
+                            && col <= range.end.col
+                    })
+        })
+        .ok_or_else(invalid)?;
+    let measure = pivot
+        .values
+        .iter()
+        .position(|value| value.name.eq_ignore_ascii_case(data_field))
+        .or_else(|| {
+            pivot.values.iter().position(|value| {
+                let source_name = value.source_name.as_deref().or_else(|| {
+                    if value.formula.is_some() {
+                        None
+                    } else {
+                        pivot
+                            .fields
+                            .get(value.field)
+                            .map(|field| field.name.as_str())
+                    }
+                });
+                source_name.is_some_and(|name| name.eq_ignore_ascii_case(data_field))
+            })
+        })
+        .ok_or_else(invalid)?;
+    let mut requested_rows = BTreeMap::new();
+    let mut requested_columns = BTreeMap::new();
+    let mut requested_reports = BTreeMap::new();
+    for (name, item) in items {
+        let matching_axes: Vec<_> = [(true, &pivot.rows), (false, &pivot.columns)]
+            .into_iter()
+            .flat_map(|(is_row, axis)| {
+                axis.iter()
+                    .enumerate()
+                    .filter_map(move |(position, field)| {
+                        let effective = field
+                            .name
+                            .as_deref()
+                            .or_else(|| pivot.fields.get(field.field).map(|f| f.name.as_str()));
+                        effective
+                            .is_some_and(|field_name| field_name.eq_ignore_ascii_case(name))
+                            .then_some((is_row, position))
+                    })
+            })
+            .collect();
+        if let [(is_row, position)] = matching_axes.as_slice() {
+            let requested = if *is_row {
+                &mut requested_rows
+            } else {
+                &mut requested_columns
+            };
+            if requested.insert(*position, item).is_some() {
+                return Err(invalid());
+            }
+        } else if matching_axes.is_empty() {
+            let field = pivot
+                .fields
+                .iter()
+                .find(|field| field.name.eq_ignore_ascii_case(name))
+                .ok_or_else(invalid)?
+                .index;
+            if !pivot.report_filters.contains(&field)
+                || !report_item_visible(pivot, field, item)
+                || requested_reports.insert(field, item).is_some()
+            {
+                return Err(invalid());
+            }
+        } else {
+            return Err(invalid());
+        }
+    }
+    let inferred;
+    let output = if pivot.output.is_empty() && pivot.unsupported_features.is_empty() {
+        inferred = crate::pivot::infer_pivot_output(pivot, workbook.settings().date_1904)?;
+        &inferred
+    } else {
+        &pivot.output
+    };
+    output
+        .iter()
+        .find(|cell| {
+            cell.measure == Some(measure)
+                && axis_matches(&pivot.rows, &cell.row_keys, &requested_rows)
+                && axis_matches(&pivot.columns, &cell.column_keys, &requested_columns)
+        })
+        .map(|cell| cell.value.clone())
+        .ok_or_else(invalid)
+}
