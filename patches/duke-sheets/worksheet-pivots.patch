+fn import_show_as(data: &Node) -> String {
+    let extended = data
+        .child("extLst")
+        .into_iter()
+        .flat_map(|n| n.all("ext"))
+        .flat_map(|n| n.children.iter())
+        .find(|n| n.local() == "dataField")
+        .map(|n| n.attr("pivotShowAs"));
+    match extended.unwrap_or(data.attr("showDataAs")) {
+        "percentOfTotal" => "percentOfGrandTotal",
+        "percentOfRow" => "percentOfRowTotal",
+        "percentOfCol" => "percentOfColumnTotal",
+        "runTotal" => "runningTotal",
+        "percentDiff" => "percentDifference",
+        "percentOfParentRow" => "percentOfParentRowTotal",
+        "percentOfParentCol" => "percentOfParentColumnTotal",
+        "percentOfRunningTotal" => "percentRunningTotal",
+        "" => "normal",
+        other => other,
+    }
+    .into()
+}
