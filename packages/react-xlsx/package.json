{
  "name": "@extend-ai/react-xlsx",
  "version": "0.22.0",
  "description": "JavaScript and React viewers for XLSX workbooks",
  "license": "MIT",
  "keywords": [
    "react",
    "xlsx",
    "excel",
    "spreadsheet",
    "workbook",
    "worksheet",
    "viewer",
    "xlsx-viewer",
    "excel-viewer",
    "spreadsheet-viewer",
    "charts",
    "tables"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extend-hq/react-xlsx.git"
  },
  "bugs": {
    "url": "https://github.com/extend-hq/react-xlsx/issues"
  },
  "homepage": "https://github.com/extend-hq/react-xlsx#readme",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js",
      "require": "./dist/vanilla.cjs"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs"
    },
    "./duke_sheets_wasm_bg.wasm": "./dist/duke_sheets_wasm_bg.wasm",
    "./package.json": "./package.json",
    "./office_charts_bg.wasm": "./dist/office_charts_bg.wasm",
    "./office_charts_full_bg.wasm": "./dist/office_charts_full_bg.wasm"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "csstype": "^3.1.0",
    "fflate": "^0.8.3"
  },
  "scripts": {
    "build": "node ../../scripts/check-duke-sheets.mjs && node ../../scripts/check-office-art.mjs && tsup --config tsup.config.ts && node ../../scripts/copy-duke-wasm.mjs",
    "test": "node --experimental-strip-types --test src/safe-calculate.test.ts src/builtin-table-styles.test.ts src/cell-text-clip.test.ts src/colors.test.ts src/zip-entry-names.test.ts src/viewer-palette.test.ts src/scroll-display-limit.test.ts src/merged-range-lookup.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.13.23",
    "preact": "^10.29.8",
    "@extend-ai/rust-office-charts": "file:../../vendor/rust-office-charts-0.3.5-89664cbac7da14a0.tgz",
    "@extend-ai/office-fonts": "https://github.com/extend-hq/rust-office/releases/download/office-fonts-v0.2.0/extend-ai-office-fonts-0.2.0.tgz"
  }
}
